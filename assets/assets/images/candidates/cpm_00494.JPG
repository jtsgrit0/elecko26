<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
document.addEventListener('DOMContentLoaded', function() {
  const clipButtons = document.querySelectorAll('.clip-button');
  clipButtons.forEach(button => {
    button.addEventListener('click', function() {
      const url = this.getAttribute('data-url');
      navigator.clipboard.writeText(url).then(() => {
        alert('URL이 클립보드에 복사되었습니다!');
      }).catch(err => {
        console.error('URL 복사 실패:', err);
      });
    });
  });

  const navLinks = document.querySelectorAll('.nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const targetId = href.substring(1);
        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          window.scrollTo({
            top: targetSection.offsetTop - 100,
            behavior: 'smooth'
          });
        }
      }
    });
  });
});
</script>

<style>
  /* =========================================================
     [추가] 후원 버튼(View 래퍼) 모바일 최적화 및 스타일 통일
  ========================================================= */
  .support-action-wrapper {
    width: 100%;
    margin-bottom: 0;
  }
  .support-action-wrapper .views-element-container,
  .support-action-wrapper .view-related-support,
  .support-action-wrapper .view-content,
  .support-action-wrapper .views-row {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  
  /* Views에서 출력된 후원 링크를 아래 관련글 버튼과 같은 풀사이즈 버튼 형태로 강제 조정 */
  .support-action-wrapper .views-field-title a,
  .support-action-wrapper .donation-field a {
    display: block !important;
    width: 100% !important;
    background-color: #ff7f50 !important; /* 이미지와 유사한 오렌지/코랄 색상 */
    color: white !important;
    text-align: center !important;
    font-size: 0.9em !important;
    padding: 6px 12px !important;
    border-radius: 4px !important;
    font-weight: bold !important;
    text-decoration: none !important;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(255, 127, 80, 0.4) !important;
    transition: all 0.3s ease !important;
  }
  .support-action-wrapper .views-field-title a:hover,
  .support-action-wrapper .donation-field a:hover {
    background-color: #ff6347 !important;
    transform: scale(1.02) !important;
    box-shadow: 0 4px 10px rgba(255, 127, 80, 0.6) !important;
  }

  /* =========================================================
     0. 후보자 인증 버튼 CSS (Hover 효과 포함)
  ========================================================= */
  /* 인증하기 버튼 */
  .btn-candidate-verify {
    background-color: #e74c3c !important;
    border-color: #e74c3c !important;
    color: white !important;
    width: 100% !important;
    text-align: center !important;
    font-size: 0.9em !important;
    padding: 6px 12px !important;
    border-radius: 4px !important;
    font-weight: bold !important;
    transition: all 0.3s ease !important;
    display: inline-block !important;
  }
  /* 호버 시 부드럽게 커지며 그림자 추가 */
  .btn-candidate-verify:hover {
    background-color: #c0392b !important;
    transform: scale(1.02) !important;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
    color: white !important;
    text-decoration: none !important;
  }

  /* 인증 완료 라벨 (클릭 안 됨) */
  .verified-label {
    background-color: #27ae60 !important;
    border: 1px solid #27ae60 !important;
    color: white !important;
    width: 100% !important;
    text-align: center !important;
    font-size: 0.9em !important;
    padding: 6px 12px !important;
    border-radius: 4px !important;
    font-weight: bold !important;
    cursor: default !important;
  }

  /* =========================================================
     1. 모달 및 내비게이션 Z-index 겹침 해결
  ========================================================= */
  .one-page-nav, 
  .nav-container {
    z-index: 99 !important; 
  }
  .ui-widget-overlay {
    z-index: 9998 !important;
  }
  .ui-dialog {
    z-index: 9999 !important;
  }

  /* =========================================================
     2. 상단 닫기(X) 버튼 복구 및 위치 교정
  ========================================================= */
  .ui-dialog .ui-dialog-titlebar-close {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    right: 15px !important;
    width: 32px !important;
    height: 32px !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    text-indent: 0 !important;
    padding: 0 !important;
    cursor: pointer !important;
  }
  .ui-dialog .ui-dialog-titlebar-close::before {
    content: "✖" !important;
    color: #333333 !important;
    font-size: 22px !important;
    line-height: 32px !important;
    display: block !important;
    text-align: center !important;
  }
  .ui-dialog .ui-dialog-titlebar-close span,
  .ui-dialog .ui-dialog-titlebar-close .ui-icon {
    display: none !important;
  }

  /* =========================================================
     3. 사라진 '보기' 설명 텍스트 강제 노출
  ========================================================= */
  .ui-dialog .webform-submission-form .description,
  .ui-dialog .webform-submission-form .webform-element-description,
  .ui-dialog .webform-submission-form .text-muted {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    font-size: 0.9em !important;
    margin-top: 5px !important;
    height: auto !important;
  }

  /* =========================================================
     4. 이용약관 & 개인정보 처리방침 강조 디자인
  ========================================================= */
  .ui-dialog .webform-submission-form .webform-flexbox {
    background-color: #f4f6f8 !important;
    border: 1px solid #dcdcdc !important;
    border-radius: 8px !important;
    padding: 15px 20px !important;
    margin-top: 15px !important;
    margin-bottom: 20px !important;
  }
  .ui-dialog .webform-submission-form .webform-flexbox .form-check-label {
    font-weight: bold !important;
    color: #2c3e50 !important;
    font-size: 1.05em !important;
  }
  .ui-dialog .webform-submission-form .webform-flexbox .webform-element-description a {
    color: #e74c3c !important; 
    text-decoration: underline !important;
    font-weight: bold !important;
  }

  /* =========================================================
     5. 모든 폼 액션 버튼 (다음, 이전, 신청하기) 스타일 정상화
  ========================================================= */
  .ui-dialog .webform-submission-form .form-actions button {
    opacity: 1 !important;
    background-image: none !important;
    font-weight: bold !important;
    font-size: 1.1em !important;
    padding: 10px 30px !important;
    border-radius: 6px !important;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15) !important;
    cursor: pointer !important;
    transition: all 0.2s ease-in-out !important;
    margin: 0 5px !important;
  }

  /* [다음], [신청하기] 버튼 - 메인 액션 (다크 그린) */
  .ui-dialog .webform-submission-form .form-actions .webform-button--next,
  .ui-dialog .webform-submission-form .form-actions .webform-button--submit {
    background-color: #004d40 !important; 
    border-color: #004d40 !important;
    color: #ffffff !important;
  }
  .ui-dialog .webform-submission-form .form-actions .webform-button--next:hover,
  .ui-dialog .webform-submission-form .form-actions .webform-button--submit:hover {
    background-color: #00332a !important; 
    transform: translateY(-2px) !important;
  }

  /* [이전] 버튼 - 보조 액션 (차분한 슬레이트 그레이) */
  .ui-dialog .webform-submission-form .form-actions .webform-button--previous {
    background-color: #6c757d !important; 
    border-color: #6c757d !important;
    color: #ffffff !important;
  }
  .ui-dialog .webform-submission-form .form-actions .webform-button--previous:hover {
    background-color: #5a6268 !important; 
    transform: translateY(-2px) !important;
  }

  /* 비활성화 된 버튼 (필수 항목 미입력 등) */
  .ui-dialog .webform-submission-form .form-actions button[disabled] {
    background-color: #cccccc !important;
    border-color: #bbbbbb !important;
    color: #666666 !important;
    cursor: not-allowed !important;
    box-shadow: none !important;
    transform: none !important;
  }
</style>
