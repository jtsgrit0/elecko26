<style>
    /* 대댓글을 감싸는 드루팔 기본 인덴트 영역 및 필드를 강제로 노출 */
    .comment-show, .show-hide, .comment-reply {
      display: inline-block !important;
    }
    /* 특정 모듈이나 테마에 의해 숨겨진 하위 대댓글 구조 전체를 투명망토 벗김 */
    .indented, .comment-holder, [class*="reply-comment"], .ajax-comment-wrapper {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      height: auto !important;
    }
  </style>
  
    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
    // window.onload 덮어쓰기 버그를 방지하기 위해 안전하게 이벤트 위임 방식으로 작성
    if (typeof window.initCommentCopy === 'undefined') {
      window.initCommentCopy = true;
      
      document.addEventListener('click', function(e) {
        // 클릭한 요소가 copy-link-btn 클래스를 가지고 있는지 확인
        if (e.target && e.target.classList.contains('copy-link-btn')) {
          e.preventDefault();
          
          // 해당 댓글의 ID 가져오기
          const commentId = e.target.getAttribute('data-comment-id');
          
          // 현재 접속 중인 페이지 주소 + #comment-숫자 조합으로 완벽한 URL 생성
          const urlToCopy = window.location.origin + window.location.pathname + window.location.search + '#comment-' + commentId;
          
          // 클립보드에 복사
          navigator.clipboard.writeText(urlToCopy).then(function() {
            alert('댓글 주소가 복사되었습니다!');
          }).catch(function(err) {
            alert('주소 복사에 실패했습니다.');
            console.error('복사 에러:', err);
          });
        }
      });
    }
  </script>
</article>

