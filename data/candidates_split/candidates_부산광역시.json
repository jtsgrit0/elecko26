o {width:67px;height:82px;border:1px solid #dfdfdf;overflow:hidden;margin-right:10px;} #mediclub .photo img {width:67px;} #mediclub .text {width:180px;height:80px;overflow:hidden;letter-spacing:-1.5px;line-height:1.4em;} #mediclub .tc{color:#326195;} mediNum=0; function medi_cycle(){ mediNum ++ i"},{"title":"국민의힘 부산광역시당, 광역⋅기초의원 지역구 6개 지역 경선 일정 안내","link":"https://www.lawissue.co.kr/view.php?ud=2026041313532019029a8c8bf58f_12","source":"Bing","content":"국민의힘 부산광역시당, 광역⋅기초의원 지역구 6개 지역 경선 일정 안내 기사입력:2026-04-13 13:55:06 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 제8⋅9차 회의에서 의결된 광역⋅기초의원 지역구 6개 지역에 대해 경선 일정을 안내했다고 13일 밝혔다. 경선일은 4월 19~20일(2일간)이며 경선 방식은 당원 선거인단 100%로 진행된다. △광역의원= 동래구 제2선거구(변영국, 송우현), 금정구 제1선거구(김천일, 하은미(여). △기초의원= 해운대구 마선거구(김민성, 박기훈 ※ 1위–가, 2위-나), 해운대구 바선거구(이국두, 장성철 ※ 1위–가, 2위-나), 사하구 가선거구(양기주, 윤보수, 조문선 ※ 1위-나), 사하구 나선거구[(전영애(여), 정삼균 ※ 1위-나)], 사하구 제2선거구[(이성숙(여), 최광렬, 최종원)]. 경선후보자 등록 후 결과는 시당 홈페이지를 통해 공고할 예정이다.전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push({}); (adsbygoogle = window.adsbygoogle || []).push({}); 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 주요뉴스 이란, 미군 공조 의심 선박 강제 나포… 호르무즈 해협 긴장 고조 사회·문화 北, 日 내각 야스쿠니 참배에 \"역사 왜곡 및 군국주의 부활 시도\" 강비난 사회·문화 美, 이란 자금줄 전방위 차단… 중국 정유사 제재 및 가상화폐 동결 사회·문화 베트남 정상회담 마친 李대통령 '탕롱황성' 찾아 친교... 인도 모디 총리에... 정치 장동혁, 2선 후퇴 등 당내 일부 거취 압박에 \"사퇴가 선거승리 도움 되나\" 정치 대법원, 뇌물수수사건 개별 추징 아닌 공동추징 부분 원심 파기 환송 법조 .t_box1>ul>li {width:243px;} .today_box>.t_box1>ul>li>a>.thumb>img {width:243px; height:144px;} 핫포커스 김정문알로에 자회사 케이제이엠바이오, 치료제 없는 난청 관련 건기식 원료... 현대약품, 전립선비대에 의한 배뇨장애 해결 ‘유린타민캡슐’ 선보여 CJ제일제당, ‘고메치킨’ 신제품 2종 선보여 KFC, 프리미엄 닭다리통살로 재탄생한 ‘블랙라벨더블다운맥스’ 선보여 세븐일레븐, 2021 추석선물세트 판매 시작 CU, 추석 선물로 기존 편의점에서 판매하지 않았던 상품들 대거 선보여 $(document).ready(function(){ iFrameResize({ log: false, checkOrigin: false }, '#clsnhiCommentIF