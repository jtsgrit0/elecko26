overflow:hidden;font-size:1em;} #mediclub .mediclub_top{color:#0089ff; font-weight:bold; margin:0;text-align:center;line-height:2.5em;} #mediclub .mlink{display:inline-block; color:#0089ff; font-weight:bold; margin:0;width:160px; height:40px;border-bottom:1px solid #dfdfdf;border-right:1px solid #dfdfdf;} #mediclub h3{color:#333; font-weight:bold;display:inline-block;width:137px;height:41px;} #mediclub dd {margin:20px 0 0 20px;} #mediclub .photo {width:67px;height:82px;border:1px solid #dfdfdf;overflow:hidden;margin-right:10px;} #mediclub .photo img {width:67px;} #mediclub .text {width:180px;height:80px;overflow:hidden;letter-spacing:-1.5px;line-height:1.4em;} #mediclub .tc{color:#326195;} mediNum=0; function medi_cycle(){ mediNum ++ i"},{"title":"국힘 부산시당, 2차 공천 명단 발표… 동구 강철호·북구 오태원 단수 확정","link":"https://daily.hankooki.com/news/articleView.html?idxno=1356674","source":"Bing","content":"사하구 5인 경선 등 기초단체장 4곳 격돌\n광역·기초의원도 현역 강세 속 ‘가·나’ 순번 전쟁 본격화 국민의힘 부산시장 공관위가 8일 2차 공천 명단을 발표했다. 사진=국민의힘 부산시당 [부산=데일리한국 이채열 기자]국민의힘 부산광역시당 공천관리위원회가 8일 제9차 회의를 열고 6·3 지방선거에 나설 기초단체장과 광역·기초의원 대진표를 추가로 확정했다. 앞서 발표된 금정, 수영, 중구, 강서구에 이어 부산 지역 공천 작업이 막바지 능선을 넘는 모양새다. ◇기초단체장, ‘동구·북구’는 단수 공천… ‘부산진·동래·사하·기장’은 피 말리는 경선 가장 이목이 쏠린 기초단체장 공천에서는 동구와 북구가 단수 공천 지역으로 확정됐다. 동구에서는 강철호 현 부산광역시의회 운영위원장이, 북구에서는 오태원 현 북구청장이 각각 단독 후보로 낙점되며 본선행 티켓을 거머쥐었다. #AD177459229825.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD177459229825.ad-template .col { text-align:center; }\n#AD177459229825.ad-template .col .ad-view { position:relative; } 반면, 나머지 4개 지역은 치열한 경선 체제로 돌입한다. 부산진구는 김승주 전 부산진구 약사회장과 김영욱 현 구청장이 2인 경선을 치르며, 동래구 역시 박중묵 전 부산시의회 부의장과 장준용 현 구청장이 맞대결을 펼친다. 특히 사하구는 김척수 전 당협위원장, 노재갑 전 시의원, 이복조 현 시의회 원내대표, 조정화 전 구청장, 최민호 전 상임감사 등 5명이 나서는 ‘다자 경선’ 지역으로 분류돼 최대 격전지가 될 전망이다. 기장군에서는 김한선 전 53사단장과 이승우 현 시의원, 정명시 시당 부대변인이 3인 경선을 통해 최종 후보를 가린다. ◇광역의원도 단수 후보 속속 확정… 사하구 제2선거구는 3인 경선 광역의원(부산시의원) 선거구에서도 단수 후보자들이 윤곽을 드러냈다. 중구에는 강주택 현 시의원이, 영도구 제1선거구는 김은명 현 구의원이 체급을 높여 단수 추천됐다. 사하구 제4선거구는 이상은 전 시의원이, 사상구 제1선거구는 윤태한 현 시의회 복지환경위원장이 단수 공천자로 결정됐다. 다만 사하구 제2선거구는 이성숙 전 시의원과 최광렬 전 구의회 의장, 최종원 전 국회 선임비서관이 3인 경선을 통해 공천권을 놓고 다투게 됐다. ◇기초의원, ‘가·나’ 기호 배치 고심… 사상구는 여성 인력 전진 배치 기초의원(구의원) 공천은 당선 안정권인 ‘가’번을 차지하기 위한 수수싸움이 치열했다. 영도구 나선거구에서는 김승찬 현 청년위원장이 ‘가’번을, 서정희 전 행정관리국장이 ‘나’번을 받았다. 서구 나선거구는 김건우 전 소상공인연합회장이 ‘가’번, 이현우 중앙위 위원이 ‘나’번에 배정됐다. 사상구는 여성 후보들의 약진이 두드러졌다. 가선거구에 김춘화 전 구의원(가)과 배연옥 전 주민자치위원(나)이 배치됐으며, 나·다·라 선거구에는 각각 김종선 현 구의원, 김윤경 시당 부대변인, 김진순 자문위원이 단수 후보로 추천됐다. 해운대구 마·바 선거구와 사하구 가·나 선거구 등은 경선 결과에 따라 기호 순번을 최종 결정하기로 해 예비후보들 간의 막판 세 대결이 불가피해졌다. 정동만 공관위원장은 “기존에 발표된 지역들과 마찬가지로 철저하게 경쟁력과 도덕성을 기준으로 심사했다”며 “경선 일정은 추후 논의를 거쳐 신속히 발표해 선거 승리를 위한 진용을 갖추겠다”고 밝혔다. 이번 공천안은 시당 운영위원회와 중앙당 최고위원회의 의결을 거쳐 최종 확정될 예정이다. 키워드 #국민의힘\n#국민의힘부산시당\n#국힘 부산시당 이채열 기자 다른 기사 보기 기사공유 저작권자 © 데일리한국 무단전재 및 재배포 금지 국민의힘 부산시장 공관위가 8일 2차 공천 명단을 발표했다. 사진=국민의힘 부산시당 [부산=데일리한국 이채열 기자]국민의힘 부산광역시당 공천관리위원회가 8일 제9차 회의를 열고 6·3 지방선거에 나설 기초단체장과 광역·기초의원 대진표를 추가로 확정했다. 앞서 발표된 금정, 수영, 중구, 강서구에 이어 부산 지역 공천 작업이 막바지 능선을 넘는 모양새다. ◇기초단체장, ‘동구·북구’는 단수 공천… ‘부산진·동래·사하·기장’은 피 말리는 경선 가장 이목이 쏠린 기초단체장 공천에서는 동구와 북구가 단수 공천 지역으로 확정됐다. 동구에서는 강철호 현 부산광역시의회 운영위원장이, 북구에서는 오태원 현 북구청장이 각각 단독 후보로 낙점되며 본선행 티켓을 거머쥐었다. #AD177459229825.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD177459229825.ad-template .col { text-align:center; }\n#AD177459229825.ad-template .col .ad-view { position:relative; } 반면, 나머지 4개 지역은 치열한 경선 체제로 돌입한다. 부산진구는 김승주 전 부산진구 약사회장과 김영욱 현 구청장이 2인 경선을 치르며, 동래구 역시 박중묵 전 부산시의회 부의장과 장준용 현 구청장이 맞대결을 펼친다. 특히 사하구는 김척수 전 당협위원장, 노재갑 전 시의원, 이복조 현 시의회 원내대표, 조정화 전 구청장, 최민호 전 상임감사 등 5명이 나서는 ‘다자 경선’ 지역으로 분류돼 최대 격전지가 될 전망이다. 기장군에서는 김한선 전 53사단장과 이승우 현 시의원, 정명시 시당 부대변인이 3인 경선을 통해 최종 후보를 가린다. ◇광역의원도 단수 후보 속속 확정… 사하구 제2선거구는 3인 경선 광역의원(부산시의원) 선거구에서도 단수 후보자들이 윤곽을 드러냈다. 중구에는 강주택 현 시의원이, 영도구 제1선거구는 김은명 현 구의원이 체급을 높여 단수 추천됐다. 사하구 제4선거구는 이상은 전 시의원이, 사상구 제1선거구는 윤태한 현 시의회 복지환경위원장이 단수 공천자로 결정됐다. 다만 사하구 제2선거구는 이성숙 전 시의원과 최광렬 전 구의회 의장, 최종원 전 국회 선임비서관이 3인 경선을 통해 공천권을 놓고 다투게 됐다. ◇기초의원, ‘가·나’ 기호 배치 고심… 사상구는 여성 인력 전진 배치 기초의원(구의원) 공천은 당선 안정권인 ‘가’번을 차지하기 위한 수수싸움이 치열했다. 영도구 나선거구에서는 김승찬 현 청년위원장이 ‘가’번을, 서정희 전 행정관리국장이 ‘나’번을 받았다. 서구 나선거구는 김건우 전 소상공인연합회장이 ‘가’번, 이현우 중앙위 위원이 ‘나’번에 배정됐다. 사상구는 여성 후보들의 약진이 두드러졌다. 가선거구에 김춘화 전 구의원(가)과 배연옥 전 주민자치위원(나)이 배치됐으며, 나·다·라 선거구에는 각각 김종선 현 구의원, 김윤경 시당 부대변인, 김진순 자문위원이 단수 후보로 추천됐다. 해운대구 마·바 선거구와 사하구 가·나 선거구 등은 경선 결과에 따라 기호 순번을 최종 결정하기로 해 예비후보들 간의 막판 세 대결이 불가피해졌다. 정동만 공관위원장은 “기존에 발표된 지역들과 마찬가지로 철저하게 경쟁력과 도덕성을 기준으로 심사했다”며 “경선 일정은 추후 논의를 거쳐 신속히 발표해 선거 승리를 위한 진용을 갖추겠다”고 밝혔다. 이번 공천안은 시당 운영위원회와 중앙당 최고위원회의 의결을 거쳐 최종 확정될 예정이다. 이채열 기자 다른 기사 보기 기사공유 저작권자 © 데일리한국 무단전재 및 재배포 금지\n오피니언·기획 #skin-112 .item {margin-top:2rem}\n#skin-112 .item:first-child {margin-top:.725rem}\n#skin-112 .frame {overflow:inherit;margin-bottom:.725rem}\n#skin-112 .auto-section {display:inline-block;overflow:hidden;position:absolute;left:0;top:-10px;z-index:5;max-width:100%;padding:0 10px;line-height:25px;text-overflow:ellipsis;white-space:nowrap}\n#skin-112 .content {display:block}\n#skin-112 .auto-titles {height:2.75em;max-height:none} 인터뷰 동서발전 AI혁신 주역 남석열 기획관리부사장·김승현 AI혁신처장 #skin-90 .item {margin-top:2rem}\n#skin-90 .item:first-child {margin-top:.725rem}\n#skin-90 .frame {overflow:inherit;margin-bottom:.725rem}\n#skin-90 .auto-section {display:inline-block;overflow:hidden;position:absolute;left:0;top:-10px;z-index:5;max-width:100%;padding:0 10px;line-height:25px;text-overflow:ellipsis;white-space:nowrap}\n#skin-90 .content {display:block}\n#skin-90 .auto-titles {height:2.75em;max-height:none} 인터뷰 하정우 수석 \"AI는 속도 싸움…GPU 추가 확보 속도 낸다\" 전문가 칼럼 #skin-20 > .item:not(:first-child) {margin-top:20px}\n#skin-20 .frame {width:80px}\n#skin-20 .content {display:block}\n#skin-20 .frame + .content {display:inline-block;width:calc(100% - 80px);padding-left:16px}\n#skin-20 .auto-section {display:inline-block;overflow:hidden;margin-bottom:6px;padding:0 9px;line-height:22px;border:1px solid #4a8ecc;border-radius:20px;font-weight: 500;tex"},{"title":"부산 국민의힘, 카지노 논란 속 지방선거…'송곳 검증' 시험대","link":"https://www.newsprime.co.kr/news/article.html?no=726594","source":"Bing","content":"즐겨찾기추가 | 中文| 日文| English| 기사제보| 자본시장 산업 부동산 중기벤처 정치사회 오피니언 아하!그렇군요 지역 AI 뉴스룸 금융 증권 재테크 경제 일반 보도자료 전체 자동차/운송 자동차소식 중화학 전자통신 인터넷/게임 생활 건강 교육 일반 보도자료 전체 정책 분양 재테크 기업 일반 보도자료 전체 기업탐방 컨택센터 업계교육소식 협단체뉴스 중기벤처일반 보도자료 전체 정치 사회 인사/부음/동정 보도자료 전체 기자수첩 칼럼 기고 보도자료 전체 기업심층해부 여의도25시 탐사보도 아하!그렇군요 생활경제 해피포인트 인사이드컷 보도자료 전체 정치 사회 경제 문화 칼럼기자수첩 엔터테인먼트 포토뉴스 공지 보도자료 전체 var tjtune_category = \"110\"; //for tjtune 20161101 글자크기 부산 국민의힘, 카지노 논란 속 지방선거…'송곳 검증' 시험대 '도박 부적격' 기준에도…현직 단체장· 공천 검증 실효성 도마 서경수 기자 | sks@newsprime.co.kr | 2026.03.10 16:36:31 ⓒ 국민의힘 부산시당[프라임경제] 국민의힘이 6·3 지방선거 공천 기준에 '도박'을 부적격 사유로 명시했지만, 도박 논란에 휩싸인 현직 단체장들이 후보 신청을 하면서 공천 검증의 실효성이 시험대에 올랐다.국민의힘 부산시당에 따르면 부산 16개 구·군 기초단체장 후보 공모에는 41명이 신청서를 제출했다. 사하구에는 6명이 몰리며 가장 높은 경쟁률을 기록했고, 기장군에는 4명이 출사표를 던졌다. 서·동·동래·북구는 각각 3명, 강서구는 김형찬 구청장이 단독 신청했다.다수 지역에서는 현직 구청장과 지역 정치인이 맞붙는 1대1 구도가 형성됐다. 해운대구는 김성수 구청장과 정성철 전 구의장, 남구는 오은택 구청장과 김광명 전 시의원, 영도구는 김기재 구청장과 안성민 부산시의회 의장이 경쟁한다. 연제·수영·부산진·중구 등도 현직 구청장과 도전자 간 맞대결 구도다.금정구 공천은 이번 선거의 변수로 떠올랐다. 윤일현 금정구청장은 지난해 필리핀 체류 중 숙소 카지노를 방문해 소액 게임을 했다는 논란에 휩싸였고, 해당 사안은 현재 국민의힘 중앙윤리위원회에 신고된 상태다. 윤리위 판단이 내려지지 않은 가운데 공천 심사에서 어떤 방식으로 반영될지 관심이 쏠린다.강서구에서도 과거 카지노 논란이 다시 도마에 올랐다. 김형찬 구청장은 부산시 간부 재직 시절 출장 기록을 조작해 강원랜드 카지노를 방문했던 사실이 뒤늦게 알려졌다. 김 구청장은 기자회견을 열어 사과했지만 공천 심사 과정에서는 해당 사실을 별도로 밝히지 않았다고 설명했다.앞서 이 사안은 지난 지방선거 본선거 기간 <프라임경제> 단독 보도를 통해 공직자 신분으로 카지노를 방문한 사실이 드러났지만 이미 공천이 끝난 뒤였다. 이 때문에 당시에도 공천 검증 부실 논란이 제기된 바 있다.◆\"도박 부적격 기준\" 내세웠지만…공천 검증 허점문제는 국민의힘이 이번 지방선거 공천 기준에 '민생범죄'를 포함하며 도박을 명시적 부적격 사유로 규정했다는 점이다. 공천관리위원회는 강력범죄와 재산범죄 외에 도박, 폭행, 공갈 등 민생범죄까지 범위를 확장해 검증 기준을 강화했다고 설명해 왔다.하지만 실제 공천 과정에서는 과거 징계나 비위 이력이 제출 서류 대상이 아니어서 후보자가 밝히지 않으면 확인하기 어려운 구조라는 지적이 나온다. 이 때문에 '송곳 검증'이라는 설명과 달리 공천 심사가 형식적 절차에 그칠 수 있다는 비판도 제기된다.정치권에서는 국민의힘 지도부의 최근 대응도 함께 거론된다. 장동혁 대표와 송언석 원내대표는 9일 긴급 의원총회를 열어 이른바 '윤어게인' 움직임에 선을 긋는 등 수습에 나섰다.그러나 선거를 앞두고 나온 메시지가 정치적 수습에 그치는 것 아니냐는 시선도 적지 않다. 공당의 신뢰는 선언이 아니라 공천 과정에서 기준이 실제로 적용되는지에 달려 있다는 지적이다.지방선거 공천은 정당의 윤리 기준과 정치적 책임을 가늠하는 첫 관문이다. 국민의힘이 내세운 '도박 부적격' 기준이 실제 공천 심사에서 어떻게 작동할지 부산 정치권의 이목이 집중된다. 서경수 기자 sks@newsprime.co.kr 서경수 기자의 전체기사 보기 function CenterWin(url,winname,features) { features = features.toLowerCase(); len = features.length; sumchar= \"\"; for (i=1; i <= len; i++) // 빈칸 제거 { onechar = features.substr(i-1, 1); if (onechar != \" \") sumchar += onechar; } features = sumchar; sp = new Array(); sp = features.split(',', 10); // 배열에 옵션을 분리해서 입력 splen = sp.length; // 배열 갯수 for (i=0; i < splen; i++) // width, height 값을 구하기 위한 부분 { if (sp[i].indexOf(\"width=\") == 0) // width 값일때 { width = Number(sp[i].substring(6)); } else if (sp[i].indexOf(\"height=\") == 0) // height 값일때 { height = Number(sp[i].substring(7)); } } sleft = (screen.width - width) / 2; stop = (screen.height - height) / 2; features = features + \",left=\" + sleft + \",top=\" + stop; popwin = window.open(url,winname,features); } function send_note(){ var msg = document.title; var meta; if (document.getElementsByTagName) { meta = document.getElementsByTagName('meta'); for (var i=0; i<meta.length; i++){ if(meta.item(i).getAttribute('name') == \"nate-note\"){ msg = meta.item(i).getAttribute('content'); break; } } } var url = \"http://api.nateon.nate.com/web/note/SendNote.do?msg=\"+encodeURIComponent(msg)+\"&lurl=http%3A%2F%2Fwww.newsprime.co.kr%2Fnews%2Farticle.html%3Fno%3D726594\"; window.open(url); } // 카카오스토리 공유하기 function shareStory() { Kakao.Story.share({ url: 'http://www.newsprime.co.kr/news/article.html?no=726594', text: '' }); } <!-- Xoffset=0; //풍선도움말 위치 X값 Yoffset= 20; //풍선도움말 위치 Y값 var old,skn,iex=(document.all),yyy=-1000; var ns4=document.layers var ns6=document.getElementById&&!document.all var ie4=document.all if (ns4) skn=document.dek else if (ns6) skn=document.getElementById(\"dek\").style else if (ie4) skn=document.all.dek.style if(ns4)document.captureEvents(Event.MOUSEMOVE); else{ skn.visibility=\"visible\" skn.display=\"none\" } document.onmousemove=get_mouse; function popup(msg,bak){ var content=\"<TABLE BORDER=0 BORDERC