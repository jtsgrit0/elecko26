 115,370,000 ▼300,000 비트코인캐시 678,500 ▲2,000 이더리움 3,453,000 ▼11,000 이더리움클래식 12,570 ▼20 리플 2,106 ▼4 퀀텀 1,326 0 이오타 84 0 오피니언 〉 [기고] 최근 판례로 본 분양계약 해제·해지 기준과 수분양자 대응 포인트 [기고]법무부 보호"},{"title":"국민의힘 부산시당, 광역 7곳 단수 공천…광역·기초 4곳 경선","link":"https://www.nocutnews.co.kr/news/6506308","source":"Bing","content":"광역의원 남구 제1~4선거구 단수 후보 공개해운대 1~2, 수영구 제2선거구 단수 공천광역 1곳, 기초 3곳 2인 경선 진행 국민의힘 부산시당. 국민의힘 제공국민의힘 부산시당이 6·3 지방선거 광역의원과 기초의원 일부 선거구 후보를 추가로 확정했다. 국민의힘 부산시당 공천관리위원회는 21일 열린 제13차 회의에서 의결된 추가 공천 결정 사항을 22일 발표했다. 광역의원 단수 후보자 7명과 광역·기초의원 경선 지역, 후보자 의결 내용이 공개됐다.이번에 확정된 광역의원 후보는 △남구 제1선거구 서성부(현 남구의회 의장) △남구 제2선거구 조상진(현 부산시의회 의원) 남구 제3선거구 성현달(현 부산시의회 의원) 남구 제4선거구 박미순(전 남구의회 의원) △ 해운대구 제1선거구 박준영(현 주식회사 닐스 대표이사) △ 해운대구 제2선거구 임말숙(현 부산시의회 의원) △ 수영구 제2선거구 김보언(현 수영구의회 의원) 등 7명이다.단수 후보자는 부산시당 운영위원회 의결을 거쳐 중앙당 최고위원회의 의결로 최종 확정된다. 경선지역은 모두 4곳으로, 광역의원 수영구 제1선거구에서는 박경훈(전 수영구의회 의원)과 조병제(현 수영구의회 의원)이 2인 경선을 치를 예정이다. 기초의원 경선 지역은 남구 가·나·라 등 3곳으로, 모두 2인 경선으로 진행된다. 국민의힘 부산시당 관계자는 \"광역의원의 경우 북구 제1선거구 외에는 모두 후보나 경선 일정이 확정났다\"며 \"경선 일정은 추후 공관위 논의를 거친 후 발표할 예정\"이라고 말했다. 지금 뜨는 뉴스 장동혁 거짓말 파문…美 '뒤통수' 인물은 차관 비서실장 정유라 \"아들 못만나\"…교도소 측 \"스마트접견까지 허용\"[오목조목] [단독]층간소음이 '스토킹' 됐다…영화 같은 실화[노컷브이] '前삼성가 사위' 임우재의 몰락…무당 애인 범행 도운 혐의로 실형 [단독]\"故김수미 건강 악화로 '친정엄마' 중단 검토도\" vs \"그런 적 없다\" 난임휴가 유급 4일로 확대…'사장님 친족' 성희롱도 처벌 분명히 박살냈다는데?…\"이란 국방 전력 60% 건재\" 현대차 1분기 최대 매출에도 영업익 30.8% 감소…관세·전쟁 '타격' '평생교육법' 등 교육부 소관 11개 법안, 국회 통과 서울 아파트 매매가격 상승폭 확대, 강남3구 중 송파구 하락에서 반전 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 정혜린 기자메일구독 6·3 지방선거 구독 충북 현역 단체장 전원 등판 완료…거센 도전 속 선거전 점화 선관위 \"이진숙 무소속 출마, 탈당 시한 5월 13일…투표함 24시간 공개\" 정근식, 서울교육감 진보 단일후보 확정…1차 투표서 과반득표 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6506308); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"국민의힘 부산광역시당, 광역⋅기초의원 지역구 6개 지역 경선 일정 안내","link":"https://www.lawissue.co.kr/view.php?ud=2026041313532019029a8c8bf58f_12","source":"Bing","content":"국민의힘 부산광역시당, 광역⋅기초의원 지역구 6개 지역 경선 일정 안내 기사입력:2026-04-13 13:55:06 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 제8⋅9차 회의에서 의결된 광역⋅기초의원 지역구 6개 지역에 대해 경선 일정을 안내했다고 13일 밝혔다. 경선일은 4월 19~20일(2일간)이며 경선 방식은 당원 선거인단 100%로 진행된다. △광역의원= 동래구 제2선거구(변영국, 송우현), 금정구 제1선거구(김천일, 하은미(여). △기초의원= 해운대구 마선거구(김민성, 박기훈 ※ 1위–가, 2위-나), 해운대구 바선거구(이국두, 장성철 ※ 1위–가, 2위-나), 사하구 가선거구(양기주, 윤보수, 조문선 ※ 1위-나), 사하구 나선거구[(전영애(여), 정삼균 ※ 1위-나)], 사하구 제2선거구[(이성숙(여), 최광렬, 최종원)]. 경선후보자 등록 후 결과는 시당 홈페이지를 통해 공고할 예정이다.전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push({}); (adsbygoogle = window.adsbygoogle || []).push({}); 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 주요뉴스 민주당, 지선 '착!붙 10·11·12호' 공약... '실수로 해약한 예적금 복구·... 정치 장동혁, 자신 향한 내부 비판에 \"해당엔 행위 강력 조치\" 경고성 메시지 정치 대법원, 개인정보보호법 양벌규정 적용 공공기관의 개인 유죄 원심 파기환송 법조 李대통령 \"韓·베트남 관계 참으로 특별…원전·공급망 협력\" 정치 송언석, 일각 임기단축 요구 일축... \"선거 승리에 매진\" 정치 대법원, 보험설계사를 개인정보처리자로 보고 유죄 원심 파기환송 법조 .t_box1>ul>li {width:243px;} .today_box>.t_box1>ul>li>a>.thumb>img {width:243px; height:144