 2분기부터 나타날 것\"이라고 말했다.\n중장기 성장 스토리는 여전히 유효하다는 평가다. SK하이..."},{"keyword":"후원","source":"https://www.newspim.com/news/view/20260416001189","snippet":"...잡지 등 정기간행물에 품종군별로 연 10회 이내·1회당 2쪽 이내로 게재해야 한다. 행사 후원, 소매점 내부, 국제항공기·국제여객선 내에만 제한적으로 허용된다.\n여성과 청소년을 대..."}],"news":[{"title":"국민의힘 부산시당, 광역 7곳 단수 공천…광역·기초 4곳 경선","link":"https://www.nocutnews.co.kr/news/6506308","source":"Bing","content":"광역의원 남구 제1~4선거구 단수 후보 공개해운대 1~2, 수영구 제2선거구 단수 공천광역 1곳, 기초 3곳 2인 경선 진행 국민의힘 부산시당. 국민의힘 제공국민의힘 부산시당이 6·3 지방선거 광역의원과 기초의원 일부 선거구 후보를 추가로 확정했다. 국민의힘 부산시당 공천관리위원회는 21일 열린 제13차 회의에서 의결된 추가 공천 결정 사항을 22일 발표했다. 광역의원 단수 후보자 7명과 광역·기초의원 경선 지역, 후보자 의결 내용이 공개됐다.이번에 확정된 광역의원 후보는 △남구 제1선거구 서성부(현 남구의회 의장) △남구 제2선거구 조상진(현 부산시의회 의원) 남구 제3선거구 성현달(현 부산시의회 의원) 남구 제4선거구 박미순(전 남구의회 의원) △ 해운대구 제1선거구 박준영(현 주식회사 닐스 대표이사) △ 해운대구 제2선거구 임말숙(현 부산시의회 의원) △ 수영구 제2선거구 김보언(현 수영구의회 의원) 등 7명이다.단수 후보자는 부산시당 운영위원회 의결을 거쳐 중앙당 최고위원회의 의결로 최종 확정된다. 경선지역은 모두 4곳으로, 광역의원 수영구 제1선거구에서는 박경훈(전 수영구의회 의원)과 조병제(현 수영구의회 의원)이 2인 경선을 치를 예정이다. 기초의원 경선 지역은 남구 가·나·라 등 3곳으로, 모두 2인 경선으로 진행된다. 국민의힘 부산시당 관계자는 \"광역의원의 경우 북구 제1선거구 외에는 모두 후보나 경선 일정이 확정났다\"며 \"경선 일정은 추후 공관위 논의를 거친 후 발표할 예정\"이라고 말했다. 지금 뜨는 뉴스 \"이러다 대형사고 터집니다\"…철도관제사의 호소[오목조목] 산부인과 시술 후 체내서 거즈 나왔는데…'증거 불충분'? 군사 기밀로 폴리마켓 베팅해 6억 꿀꺽한 미군, 딱 걸렸다[이런일이] 인권교육서 \"아들아들보다 XX이 좋아\"…'독재자 윤석열' 발언도 배현진, 장동혁 향해 \"집 안에서 행패 부리는 무능한 가장\" 이란, 호르무즈 통행료 차등 부과… 러시아 등 우호국 면제 [단독]삼전 노조 \"파업 시 이재용 자택 앞 집회 후 사업장 점거\" 위성락 \"한미 안보협의에 쿠팡 영향은 사실, 조속 체결해야\" 종교·체중·가족관계까지…'듀오' 개인정보 유출 서울청 수사 전자발찌 훼손·외출 제한 위반 '조두순'…항소심도 징역 2년 구형 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 정혜린 기자메일구독 6·3 지방선거 구독 유령당원 의혹으로 중단…제주 오라동 민주당 후보 재경선 민주당 여수 경선 잇단 잡음…조계원 의원 \"제기된 의혹, 사실과 달라\" 국힘 대구 기초단체장 8곳 공천 완료…현역 60% 물갈이 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6506308); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"국민의힘 부산시당, 기초단체장 및 광역·기초의원 단수후보자 등 의결","link":"https://www.lawissue.co.kr/view.php?ud=2026041616290623999a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 기초단체장 및 광역·기초의원 단수후보자 등 의결 기사입력:2026-04-16 16:30:35 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 16일 제11차 회의를 갖고 서류 및 심층 면접 결과 등 종합평가를 통해 기초단체장 및 광역⋅기초의원 지역구 선거구에 대해 단수후보자, 기초의원 기호(순번) 등을 의결했다고 밝혔다. 단수 후보자 및 기초의원 기호(순번)는 시당 운영위원회 의결을 거쳐 중앙당 최고위원회의 의결로 최종 확정된다. ◇기초단체장(3곳)=영도구 안성민 현 부산광역시의회 의장, 남구 김광면 전 제8·9대 부산광역시의회 의원, 사상구 이대훈 전 태통령비서실 행정관 ◇광역의원(5곳)=서구 제2 이용운 현국회의원실 선임비서관, 부산진구 제1 박희요 현 영산대학교 컨벤션학과 특임교수, 부산진구 제2 이대석 현 제9대 부산광역시의회 부의장, 북구 제3 이종진 현 부산광역시의회 의원, 북구 제4 박종율 현 부산광역시의회 의원 ◇기초의원 후보자 의결(6곳)=△중구 가= 가 이길희 현 중구의회 의원, 나 이대봉 전 중구영도구 당원협의회 운영부장, 다 금동욱 전 중구의회 의원, △중구 나=가 한지원(여) 현 중구의회 의원, 나 이인구 전 제9대 중구의회 전반기 부의장, △영도구 가=가 부석규 전 국회의원 비서관, 나 서승환 현 영도구의회 의원, △서구 가=가 주지웅 현 서구의회 의원, 나 강경미(여) 전 서구의회 운영기획위원장, △기장군 가=가 김명원 현 대원종합토건 대표이사, 나 박기조 현 기장군의회 문화복지행정위원장, △기장군 다=가 박우식 현 기장선·정관선 특별추진위원장, 나 구본영 현 기장군의회 부의장, 송창섭 전 정관읍 청년회 회장.전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push