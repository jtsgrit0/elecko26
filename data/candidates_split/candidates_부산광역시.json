얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 송호재 기자\n메일네이버구독 6·3 지방선거 구독 정진백 부산 기장군수 후보 현수막 잇단 훼손…경찰 수사 유정복 \"인천을 지키겠다\"…공항공사 통합 저지 총대 與지도부 업은 박찬대 \"인천 민심이 천심\"…지원요청 보따리 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6496216); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"국민의힘 부산시당, 기초단체장 및 광역·기초의원 단수후보자 등 의결","link":"https://www.lawissue.co.kr/view.php?ud=2026041616290623999a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 기초단체장 및 광역·기초의원 단수후보자 등 의결 기사입력:2026-04-16 16:30:35 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 16일 제11차 회의를 갖고 서류 및 심층 면접 결과 등 종합평가를 통해 기초단체장 및 광역⋅기초의원 지역구 선거구에 대해 단수후보자, 기초의원 기호(순번) 등을 의결했다고 밝혔다. 단수 후보자 및 기초의원 기호(순번)는 시당 운영위원회 의결을 거쳐 중앙당 최고위원회의 의결로 최종 확정된다. ◇기초단체장(3곳)=영도구 안성민 현 부산광역시의회 의장, 남구 김광면 전 제8·9대 부산광역시의회 의원, 사상구 이대훈 전 태통령비서실 행정관 ◇광역의원(5곳)=서구 제2 이용운 현국회의원실 선임비서관, 부산진구 제1 박희요 현 영산대학교 컨벤션학과 특임교수, 부산진구 제2 이대석 현 제9대 부산광역시의회 부의장, 북구 제3 이종진 현 부산광역시의회 의원, 북구 제4 박종율 현 부산광역시의회 의원 ◇기초의원 후보자 의결(6곳)=△중구 가= 가 이길희 현 중구의회 의원, 나 이대봉 전 중구영도구 당원협의회 운영부장, 다 금동욱 전 중구의회 의원, △중구 나=가 한지원(여) 현 중구의회 의원, 나 이인구 전 제9대 중구의회 전반기 부의장, 