e.match(new RegExp('(?:^|; )' + encodeURIComponent(name) + '=([^;]*)')); return m ? decodeURIComponent(m[1]) : null;\n} function setCookie(name, value, opts) { opts = opts || {}; var path = opts.path || '/'; var sameSite = opts.sameSite || 'Lax'; var secure = (opts.secure !== false); // 기본 true var parts = [ encodeURIComponent(name) + '=' + encodeURIComponent(value), 'path=' + path, 'SameSite=' + sameSite ]; if (secure) parts.push('Secure'); if (opts.domain) parts.push('Domain=' + opts.domain); var maxAgeSec = 0; if (opts.maxAgeDays) maxAgeSec += opts.maxAgeDays * 24 * 60 * 60; if (opts.maxAgeMinutes) maxAgeSec += opts.maxAgeMinutes * 60; if (maxAgeSec > 0) { parts.push('Max-Age=' + maxAgeSec); parts.push('Expires=' + new Date(Date.now() + maxAgeSec * 1000).toUTCString()); } document.cookie = parts.join('; ');\n} function getOrSetCookie(name, defVal, options) { var v = getCookie(name); if (v !== null && v !== '') return v; setCookie(name, defVal, options || {}); return defVal;\n} function makeUUID() { var hasWebCrypto = (window.crypto && typeof window.crypto.getRandomValues === 'function'); var hasRandomUUID = (window.crypto && typeof window.crypto.randomUUID === 'function'); if (hasRandomUUID) return window.crypto.randomUUID(); // 폴백 var buf = new Uint8Array(16); if (hasWebCrypto) crypto.getRandomValues(buf); for (var i=0; i<16; i++) { if (buf[i] === 0) buf[i] = Math.floor(Math.random()*256); } buf[6] = (buf[6] & 0x0f) | 0x40; // version 4 buf[8] = (buf[8] & 0x3f) | 0x80; // variant var hex = []; for (var j=0;j<16;j++){ hex.push((buf[j]+0x100).toString(16).substr(1)); } return hex.slice(0,4).join('') + '-' + hex.slice(4,6).join('') + '-' + hex.slice(6,8).join('') + '-' + hex.slice(8,10).join('') + '-' + hex.slice(10,16).join('');\n} // ---------- 헤더에서도 동일 쿠키/값 사용 ----------\nvar vid = getOrSetCookie('dl_vid', makeUUID(), { maxAgeDays: 365, sameSite: 'Lax', secure: true, path: '/' });\nvar sid = getOrSetCookie('dl_sid', makeUUID(), { maxAgeMinutes: 30, sameSite: 'Lax', secure: true, path: '/' });\n// 디버깅용(원하면 주석처리)\nwindow.__VID = vid;\nwindow.__SID = sid; // --- HTML 이스케이프 ---\nfunction esc(s){ return String(s || '').replace(/[&<>\"']/g, function(m){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]); }); } // --- 텍스트 자르기 ---\nfunction truncate(s, n){ s = String(s||''); return s.length > n ? s.slice(0, n-1) + '…' : s; } function openPop(){ // console.log('poptest', getCookie(\"ebn_dh_pop\")) if(getCookie(\"dailian_pop\") != \"checked\"){ var img = new Image(); img.onload = function() { window.open(\"/popup.html\",\"dailian_popup\",\"width=\" + (this.width) + \"px, height=\" + (this.height + 30) + \"px, toolba"},{"title":"국민의힘, 부산시장 후보 박형준·주진우 경선 진행하기로","link":"https://www.ajunews.com/view/20260317104536348","source":"Bing","content":"단수 공천 거론됐지만 경선으로 의견 모아 6·3 지방선거에서 부산시장에 도전하는 박형준 부산시장(왼쪽)과 주진우 국민의힘 의원이 지난 11일 서울 영등포구 국민의힘 중앙당사에서 열린 광역단체장 후보 면접에 참석해 시작을 기다리고 있다. [사진=연합뉴스] 국민의힘 공천관리위원회가 6·3 지방선거에 나설 부산시장 후보를 결정하기 위해 박형준 부산시장과 주진우 의원 간 경선을 치르기로 했다. 공관위는 17일 경험과 혁신이 맞붙는 경선을 통해 부산시장 후보 선출을 진행하겠다고 이같이 밝혔다. 공관위는 박형준 후보에 대해 \"부산의 글로벌 도시 도약과 미래 전략산업 구축 등 부산의 발전을 위해 정책 역량을 입증해 온 검증된 지도자\"라고 평가했다. 주진우 후보에 대해서는 \"새로운 세대의 정치 감각과 시대적 변화를 과감하게 이끌 수 있는 도전적이고 젊은 리더십을 갖춘 상징적인 후보\"라고 소개했다. 앞서 당 내부에서는 부산시장 후보를 단수 공천으로 결정할지, 경선을 진행할지와 관련해 이견이 있었다. 그러나 박 시장과 주 의원 모두 경선을 치러야 한다는 데 의견을 모으면서 논란은 일단락됐다. 관련기사장동혁, 사퇴 요구 일축...\"선거 마무리하고 평가받을 것\"송언석 \"조작기소 특검, 결론 정해 놓은 답정너식 특검\" 한편 부산에 지역구를 둔 국민의힘 의원들은 이날 장동혁 대표를 찾아 부산시장 후보 경선을 진행해야 한다는 의견을 피력했다. 장 대표와 의원들 간 면담이 끝난 뒤 박성훈 수석대변인은 기자들에게 \"(부산지역 의원들이) 경선을 치르지 않으면 '컨벤션 효과'를 달성할 수 없다는 점에서 부정적인 시각이 많다\"며 \"장 대표도 부산시장 선거 승리를 위해 경선이 필요하다는 입장에 공감을 표했다\"고 설명했다. #경선 #국민의힘 #부산시장 #박형준 #주진우 좋아요0 나빠요0 var prevMyType1 = \"\";\nvar prevMyType2 = \"\";\nif(\"\"==\" on\") { prevMyType1 = 1;\n} else if(\"\"==\" on\") { prevMyType1 = 2;\n} // 뉴스 추천\nfunction fn_news_recommand1(news_id, recommand_type, type_bold) { $.ajax({ url: '/ajax/news_recommand', type: \"POST\", data : { 'news_id':news_id, 'reco