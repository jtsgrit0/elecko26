 대한 광역의원 단수추천을 진행했다. ◎공감언론 뉴시스 [email protected] $('iframe').addClass(\"frameCenter\"); function output(type,ob){ var windoption = \"width=760,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; if ( type == 'print' ) { windoption = \"width=860,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; } if(type == \"email\"){ } if(ob == \"article\"){ if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=NISX20260327_0003567591\"+ '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id=NISX20260327_0003567591&method='+type + '&type='+ob,'', windoption); } }else if(ob == \"photo\"){ var thopho_id = $(\"#hid_foc\").val(); if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=\"+ thopho_id + '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id='+ thopho_id +'&method='+type+'&type='+ob,'',windoption); } } } \"가짜인 줄 알고 팔았는데 진짜 롤렉스\"…이탈리아 남성의 황당 사기극 쓰리빌리언, 300억 투자 유치…\"AI 유전진단 확장\" 트럼프 \"호르무즈 기뢰 부설 모든 선박 사살 지시\" 미군 \"이란과 관련된 유조선 1척 또 나포\" 트럼프 \"이란 내부갈등 미친수준…합의할 때까지 해상봉쇄\" 안성재 식당, 와인 바뀌치기 논란에 사과…\"사안 엄중히 받아들여\" 멕시코 미인대회 출신 여성 피살…유력 용의자는 '시어머니' 정근식, 서울시교육감 '진보' 단일 후보로 선출 檢고위 간부들, 재산 1~3위…'성남시장 출마' 김병욱 75억 이 대통령 부부, 하노이 호안끼엠 깜짝 방문…베트남 국민과 소통 이 대통령 \"글로벌 경제 불확실성 높아져…한·베트남 경제협력 어느 때보다 중요\" 이재명 대통령, 한-베트남 비즈니즈 참석 공급망 등 글로벌 위기 상황 속 양국 우호·협력 더욱 빛날 것 김용범 \"베트남, 한국이 원전 사업에 참여해줬으면 하는 의지 강해…파이낸싱 중요\" 민주당, 송영길·김남준 전략공천…수도권 재보선 공천 교통정리 시작 \"가짜인 줄 알고 팔았는데 진짜 롤렉스\"…이탈리아 남성의 황당 사기극 미군 \"이란과 관련된 유조선 1척 또 나포\" 트럼프 \"이란 내부갈등 미친수준…합의할 때까지 해상봉쇄\" 멕시코 미인대회 출신 여성 피살…유력 용의자는 '시어머니' 뉴욕증시, 이란전 불확실성에 하락 출발…다우 0.41%↓ 트럼프, 마리화나 1급→3급 하향…50년 만에 최고 수준 완화 'MAGA 여성 알고봤더니' 인도 의대생이 만든 AI…매달 수천달러 벌어 뉴욕증시, 이란전 불확실성에 하락 출발…다우 0.41%↓ 韓기업들, 李 순방 계기로 베트남과 8200만불 규모 수출계약 달성 산업차관 \"4차 석유 최고가격 내려야 했지만 동결…3차 땐 올리지 않고 동결\" 내일부터 액상 전자담배 온라인 판매 안돼…가격도↑(종합) 4차 석유 최고가격 또 동결…휘발유 1934원·경유 1923원 김용범 \"베트남, 한국이 원전 사업에 참여해줬으면 하는 의지 강해…파이낸싱 중요\" 대만 증시, 중동정세 불안 나흘 만에 반락 마감…0.43%↓