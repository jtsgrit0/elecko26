Query('#gallery1824366 a').lightBox({ imageLoading: '//img.seoul.co.kr/img/12_lightbox-ico-loading.gif', imageBlank: '//img.seoul.co.kr/img/12_lightbox-blank.gif', imageBtnPrev: '//img.seoul.co.kr/img/12_pre_i.gif', imageBtnNext: '//img.seoul.co.kr/img/12_next_i.gif', imageBtnClose: '//img.seoul.co.kr/img/12_close_i.gif', overlayOpacity:0.6 } ); }); 최봉환 부산 금정구의회 의원 최봉환 부산 금정구의회 의원이 17일 국민의힘 탈당과 함께 오는 6월 지방선거에서 금정구청장 무소속 출마를 선언했다.최 의원은 이날 부산시의회에서 기자회견을 열고 “20년 넘게 몸담아온 보수의 터전을 떠나 험난한 무소속의 길을 선택한 것은, 오직 무너진 풀뿌리 민주주의를 바로 세우고 금정구민의 자존심을 지키기 위한 고육지책”이라고 밝혔다.이번 국민의힘 공천 과정을 ‘특정 세력에 의한 사유화’라고 규정한 최 의원은 “주민의 목소리를 경청하고 지역 발전에 헌신한 일꾼보다 중앙의 눈치만 살피는 이들이 선택받는 작금의 공천 시스템은 지방자치의 본질을 훼손하는 처사”라며 “정당의 옷이 아닌 주민의 눈높이에서 평가받기 위해 기득권을 내려놓겠다”고 강조했다.전국시군자치구의회의장협의회 회장을 역임했던 최 의원은 “무소속 출마는 단순한 선거 전략이 아니라 정당의 간섭 없이 오직 주민만을 위해 일할 수 있는 진정한 지방자치를 실현하겠다는 의지”라고 설명했다.한편 최 의원은 금정구의회 4선으로 제9대 금정구의회 전반기 의장 등을 지내며 지방자치 발전과 지역 현안 해결에 앞장서 왔다는 평가를 받는다. 부산 정철욱 기자 Copyright ⓒ 서울신문 All rights reserved. 무단 전재-재배포, AI 학습 및 활용 금지 window._taboola = window._taboola || []; _taboola.push({ mode: 'thumbnails-a', container: 'taboola-below-article-thumbnails', placement: 'Below Article Thumbnails', target_type: 'mix' }); window._taboola = window._taboola || []; _taboola.push({ mode: 'thumbnails-a', container: 'taboola-below-article-thumbnails-2nd', placement: 'Below Article Thumbnails 2nd', target_type: 'mix' }); #taboola-below-article-thumbnails-2nd .trc_rbox_header { display: none;\n} $(document).ready(function() { const watcher = document.getElementById('watcher').contentWindow; window.addEventListener('message', (e) => { if (e.data.type === 'localStorageChange') { //console.log('감지!', e.data.key, '->', e.data.value); //if(!e.data.value) { // logout(); //} }else if(e.data.type == \"loggedIn\") { const s = document.createElement(\"script\"); s.src = \"/members/loginCheckScript.php\"; document.body.appendChild(s); getLoginInfo(); }else if(e.data.type == \"logged_out\") { location.reload(); } }); getLoginInfo(); }); function getLoginInfo() { $.ajax({ url: \"https://go.seoul.co.kr/members/getLoginInfo.php\", dataType: \"JSON\", type: \"GET\", success: function(data) { if(data.user_id) { if(data.user_id && !localStorage.getItem(\"livere_auth_account_id\")) { localStorage.setItem(\"livere_auth_account_id\", data.user_id); localStorage.setItem(\"livere_auth_challenge_code\", data.challenge_code); } if(localStorage.getItem(\"livere_auth_challenge_code\") !== data.challenge_code) { localStorage.setItem(\"livere_auth_challenge_code\", data.challenge_code); } }else { localStorage.removeItem(\"livere_auth_account_id\"); localStorage.removeItem(\"livere_auth_challenge_code\"); } } }); } var page_getID = \"20260317500302\"; if (page_getID != \"\") { var pageUrl = \"go.seoul.co.kr/news/newsView.php?id=\" + page_getID; } else { var pageUrl = \"\"; } window.livereOptions = { refer: pageUrl, facebookPageId: '264054780362220', facebookUploadUrl: 'https://' + pageUrl, site: 'https://' + pageUrl }; (function (d, s) { var j, e = d.getElementsByTagName(s)[0]; if (typeof LivereTower === 'function') { return; } j = d.createElement(s); j.src = 'https://cdn-city.livere.com/js/embed.dist.js'; j.async = true; e.parentNode.insertBefore(j, e); })(document, 'script'); function closeLivereAd() { $(\"#livereAdArea\").slideUp(\"fast\"); }"},{"title":"개혁신당 최봉환, 금정구청장 선거사무소 개소…\"본격 선거전 돌입\"","link":"https://www.nocutnews.co.kr/news/6503058","source":"Bing","content":"핵심요약함익병·정이한 등 지도부 총출동…부산 금정 '승부처' 규정\"국힘과 선의의 경쟁…보수 가치로 결과로 보답\" 정이한 개혁신당 부산시장 후보. 개혁신당 제공개혁신당 최봉환 전 금정구의회 의장이 선거사무소 개소식을 열고 금정구청장 선거에 본격 뛰어들었다. 당 지도부가 대거 참석해 금정구를 핵심 격전지로 규정하며 세 결집에 나서면서, 보수 진영 내 경쟁 구도에도 관심이 쏠린다. 최 전 의장은 15일 오후 부산 금정구 구서역 인근에서 선거사무소 개소식을 열고 \"본격적인 선거전에 돌입한다\"고 밝혔다.이날 행사에는 함익병 부산시장 선거대책위원회 총괄선대위원장과 개혁신당 지도부가 참석해 출발을 알렸다.부산 금정 '핵심 승부처'…지도부 총출동행사에서 함익병 총괄선대위원장은 \"금정구는 이번 선거의 중요한 승부처\"라며 \"최봉환 후보를 중심으로 반드시 의미 있는 성과를 만들어야 한다\"고 강조했다.정이한 부산시장 후보도 \"최봉환 후보는 현장을 누구보다 잘 아는 준비된 후보\"라며 \"금정에서의 승리가 부산 전체 선거 흐름을 바꿀 수 있는 만큼 시민들의 지지를 부탁한다\"고 말했다\"보수 경쟁으로 승부\"…세 확장 본격화 최 후보는 \"탈당이라는 선택이 마음 아픈 결정이었지만, 개혁신당 역시 같은 보수정당으로서 책임 있는 경쟁을 해야 한다고 생각한다\"며 \"국민의힘과 선의의 경쟁을 통해 좋은 결과를 만들어내겠다\"고 말했다.이어 \"금정구청장뿐 아니라 금정구의회에서도 당선자를 배출하고, 부산시장 선거에서도 두 자릿수 지지율을 달성할 수 있도록 최선을 다하겠다\"고 밝혔다.이날 개소식에는 지역 주민과 지지자 100여 명이 참석해 성황을 이뤘으며, 행사 이후 참석자들은 부산대와 해운대 일대에서 유세를 이어가며 세 확장에 나설 예정이다.정치권에서는 이번 개소식을 계기로 개혁신당이 금정구를 중심으로 보수 표심 공략에 본격 나선 것으로 보고 있다.개혁신당 최봉환 전 금정구의회 의장이 선거사무소 개소식을 열고 금정구청장 선거에 본격 뛰어들었다. 개혁신당 제공특히 국민의힘과의 경쟁 구도가 뚜렷해지면서 향후 지역 선거 판세에도 영향을 미칠 것으로 전망된다. 지금 뜨는 뉴스 산부인과 시술 후 체내서 거즈 나왔는데…'증거 불충분'? 군사 기밀로 폴리마켓 베팅해 6억 꿀꺽한 미군, 딱 걸렸다[이런일이] 정류장서 난데없이 '접착제' 뿌리고 도주…70대 남성 검거 배현진, 장동혁 향해 \"집 안에서 행패 부리는 무능한 가장\" \"고용노동부에 휘발유 뿌리고 방화 시도\"…50대 항소심도 징역 2년 화물연대 \"입으론 교섭, 손으론 탄압\"…가처분 신청 규탄 주사기 13만개 쌓아두고 '버티기'…매점매석 32곳 적발 \"알바 지원했는데 소개팅앱 가입?\"…온라인 피해 사례집 보니 '차관보 만남' 거짓말 논란에 장동혁 \"실무상 착오\" 서울 목동서 지게차가 자전거 들이받아…40대 여성 사망 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 강민정 기자메일구독 6·3 지방선거 구독 정진백 부산 기장군수 후보 현수막 잇단 훼손…경찰 수사 유정복 \"인천을 지키겠다\"…공항공사 통합 저지 총대 與지도부 업은 박찬대 \"인천 민심이 천심\"…지원요청 보따리 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6503058); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('rende