t\", request.responseText); //alert(request.responseText); } }); } 공유하기 공유 카카오톡 페이스북 트위터 네이버블로그 주소복사 내용 요약 요약 네이버 구독 구독 다음 구독독 구독 본문 요약 국민의힘, 부산시장 경선 치른다..\"공천 칼춤\" 반발 수습 국민의힘 공천관리위원회는 17일 부산시장 후보 선출을 위한 당내 경선을 진행하기로 했다.박성훈 의원은 면담을 마치고 기자들과 만나 \"부산지역 의원 전원이 장 대표에게 이정현 공천관리위원장 결정에 대한 재논의를 요청했다\"며 \"장 대표도 부산시장 승리를 위해 경선이 필요하다는 입장에 공감했다\"고 했다.앞서, 공관위는 이정현 공관위원장이 주창한 '혁신 공천'의 일환으로 "},{"title":"국민의힘, 부산시장 후보 박형준·주진우 경선 진행하기로","link":"https://www.ajunews.com/view/20260317104536348","source":"Bing","content":"단수 공천 거론됐지만 경선으로 의견 모아 6·3 지방선거에서 부산시장에 도전하는 박형준 부산시장(왼쪽)과 주진우 국민의힘 의원이 지난 11일 서울 영등포구 국민의힘 중앙당사에서 열린 광역단체장 후보 면접에 참석해 시작을 기다리고 있다. [사진=연합뉴스] 국민의힘 공천관리위원회가 6·3 지방선거에 나설 부산시장 후보를 결정하기 위해 박형준 부산시장과 주진우 의원 간 경선을 치르기로 했다. 공관위는 17일 경험과 혁신이 맞붙는 경선을 통해 부산시장 후보 선출을 진행하겠다고 이같이 밝혔다. 공관위는 박형준 후보에 대해 \"부산의 글로벌 도시 도약과 미래 전략산업 구축 등 부산의 발전을 위해 정책 역량을 입증해 온 검증된 지도자\"라고 평가했다. 주진우 후보에 대해서는 \"새로운 세대의 정치 감각과 시대적 변화를 과감하게 이끌 수 있는 도전적이고 젊은 리더십을 갖춘 상징적인 후보\"라고 소개했다. 앞서 당 내부에서는 부산시장 후보를 단수 공천으로 결정할지, 경선을 진행할지와 관련해 이견이 있었다. 그러나 박 시장과 주 의원 모두 경선을 치러야 한다는 데 의견을 모으면서 논란은 일단락됐다. 관련기사장동혁, 주한 미국대사대리와 면담...방미 성과·한미동맹 논의 국힘 지도부, 서울 중구청장 공천 재검토...서울시당 \"재의결로 확정\" 한편 부산에 지역구를 둔 국민의힘 의원들은 이날 장동혁 대표를 찾아 부산시장 후보 경선을 진행해야 한다는 의견을 피력했다. 장 대표와 의원들 간 면담이 끝난 뒤 박성훈 수석대변인은 기자들에게 \"(부산지역 의원들이) 경선을 치르지 않으면 '컨벤션 효과'를 달성할 수 없다는 점에서 부정적인 시각이 많다\"며 \"장 대표도 부산시장 선거 승리를 위해 경선이 필요하다는 입장에 공감을 표했다\"고 설명했다. #경선 #국민의힘 #부산시장 #박형준 #주진우 좋아요0 나빠요0 var prevMyType1 = \"\";\nvar prevMyType2 = \"\";\nif(\"\"==\" on\") { prevMyType1 = 1;\n} else if(\"\"==\" on\") { prevMyType1 = 2;\n} // 뉴스 추천\nfunction fn_news_recommand1(news_id, recommand_type, type_bold) { $.ajax({ url: '/ajax/news_recommand', type: \"POST\", data : { 'news_id':news_id, 'recommand_type':recommand_type, 'type_bold':type_bold, 'gubun':1 }, dataType:\"json\", error:function(e) { alert('오류가 발생하였습니다.\\n관리자에게 문의주세요.'); }, success: function(data) { // 클릭한 뉴스의 카운터와 폰트를 변경시킨다. if(data.code==\"exist\") { alert(data.message); } else { var iSum = parseInt($(\"#div_recommend_\