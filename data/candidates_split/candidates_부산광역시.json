play:block; clear:both; z-index:99999; }\n#AD174493786251.ad-template .col { float:left; text-align:center; width:50%; }\n#AD174493786251.ad-template .col .ad-view { position:relative; } 이로써 민주당은 부산 16개 기초단체장 후보 공천을 완료했다. 이 중 여성 후보는 6명이다.서부산지역 민주당 후보는 ▲강서구청장 박상준 현 구의원 ▲사상구청장 서태경 전 지역위원장▲사하구청장 김태석 전 구청장 ▲북구청장 정명희(여) 전 구청장이다. 동부산지역은 ▲기장군수 우성빈(여) 전 국회의장실 정책비서관 ▲해운대구청장 홍순헌 전 구청장 ▲수영구청장 김진(여) 구의원 ▲남구청장 박재범 전 구청장이다.중부산지역은 ▲금정구청장 김경지(여) 전 지역위원 ▲동래구청장 탁영일 구의회 의장 ▲연제구청장 이정식 중소상공인살리기협회장 ▲부산진구청장 서은숙(여) 전 구청장이다. 원도심지역은 ▲동구청장 김종우 전 구의원 ▲서구청장 황정재 구의원 ▲중구청장 강희은(여) 구의원 ▲영도구청장 김철훈 전 구청장 등이다.한편 현재 여야 후보가 모두 확정된 곳은 강서구, 사상구, 북구, 수영구, 남구, 동구, 중구, 영도구, 금정구 등 9곳이다.국민의힘은 부산진구, 동래구, 해운대구, 사하구, 연제구, 기장군, 서구 등 남은 7곳의 경선 결과를 오는 19일께 발표할 예정이다. #AD174493715234.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD174493715234.ad-template .col { text-align:center; }\n#AD174493715234.ad-template .col .ad-view { position:relative; } const API_KEY = 'fb8790905a5868f9a873dec18888f6d1'; let aedi = new Aedi(); var aediWritingTime = document.querySelector('meta[property=\"article:published_time\"]').content; aedi.adOpen(API_KEY, document.querySelectorAll('#article-view-content-div :is(figure, table) img'), aediWritingTime); #AD174493836076.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD174493836076.ad-template .col { text-align:center; }\n#AD174493836076.ad-template .col .ad-view { position:relative; } $(function() { const copyUrlOptions=document.querySelectorAll(\".urlBtns, .sns_clipboard\"); // 주소복사 이벤트 (v11-fl-v2 수정) copyUrlOptions.forEach(selector=>{ selector.addEventListener(\"click\", (e)=>{ const target=e.target, targetBtn=target.closest(\"[data-clipboard-text]\"); if (targetBtn===null) return; const url=targetBtn.getAttribute(\"data-clipboard-text\")||\"\"; Util.copyToClipboardToast(selector, '', url); }); }); // 사진 lightBox 이벤트 if (typeof ImageViewer != \"undefined\") { new ImageViewer(\".photo-layout\", 0); } }); #AD174493840098.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493840098.ad-template .col { text-align:center; }\n#AD174493840098.ad-template .col .ad-view { position:relative; } #AD174493844524.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493844524.ad-template .col { text-align:center; }\n#AD174493844524.ad-template .col .ad-view { position:relative; } (function(d,a,b,l,e,r) {\nif(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l);\ne.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js';\nr=a.getElementsByTagName(l)[0];r.parentNode.insertBefore(e,r); })(window,document,'dable','script');\ndable('setService', 'sportalkorea.mt.co.kr');\ndable('sendLogOnce');\ndable('renderWidget', 'dablewidget_M7NmPzob'); 이아름 기자(aha@newsis.com) newsis@newsis.com 다른기사 보기 저작권자 © 뉴시스 무단전재 및 재배포, AI학습 및 활용 금지 #AD174493847810.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493847810.ad-template .col { text-align:center; }\n#AD174493847810.ad-template .col .ad"},{"title":"[6·3부산]민주 구청장 경선, 공명선거 서약에도…시작부터 '잡음'","link":"https://www.newsis.com/view/NISX20260403_0003577273","source":"Bing","content":"영도구·사상구 후보 의혹 제기 [부산=뉴시스] 부산 동래구와 영도구, 사상구 더불어민주당 기초단체장 경선 후보들이 공명선거 서약식을 갖고 본격적인 경선에 돌입했다. (사진 왼쪽부터 시계방향으로) 사상구 서태경, 김부민, 동래구 탁영일, 주순희, 영도구 박성윤, 김철훈 예비후보. (사진=민주당 부산시당 제공) 2026.04.03. [email protected] *재판매 및 DB 금지[부산=뉴시스]원동화 기자 = 부산 동래구와 영도구, 사상구 더불어민주당 기초단체장 경선 후보들이 공명선거 서약식을 갖고 본격적인 경선에 돌입했다. 하지만 직후 일부 후보들이 의혹을 제기하며 공정 경선을 촉구하고 나섰다. 공명선거 서약식은 3일 동구 더불어민주당 부산시당 회의실에서 열렸다. 동래구청장은 주순희·탁영일 후보 간 2인 경선, 영도구청장은 김철훈·박성윤 후보 간 2인 경선, 사상구청장은 김부민·서태경 후보 간 2인 경선으로 각각 치러진다. 이들은 6일 합동연설회, 7일 합동토론회를 진행할 예정이다. 이후 영도구에 출마한 박성윤 전 부산시의원과 사상구 김부민 전 부산시의원은 각각 부산시의회 브리핑룸에서 기자회견을 열고 공정 경선을 촉구했다. 이들은 앞서 단수 추천에 반발해 중앙당에 재심을 요청했고, 받아들여지면서 경선을 치르게 됐다. 박 전 시의원은 \"상무위원회 인준 이전 '단수추천' 단계에서 상대 후보 측이 '단수공천을 받았다'는 내용의 문자메시지와 SNS를 대량 발송해 사실상 공천이 확정된 것처럼 인식이 확산됐다\"며 \"이는 경선의 출발선 자체를 기울게 만든 중대한 공정성 훼손 행위\"라고 밝혔다. [부산=뉴시스] 영도구청장에 출마한 더불어민주당 박성윤 전 부산시의원(왼쪽)과 사상구청장에 출마한 같은 당 김부민 전 부산시의원. (사진=부산시의회 제공) 2026.04.03. [email protected] *재판매 및 DB 금지이어 '단수공천' 문자 발송 경위에 대한 신속하고 공식적인 조사와 시정 조치를 요구했다. 김 전 시의원은 \"당내 경쟁 후보가 지방선거를 앞두고 조직 확대를 추진한다는 명분으로 개인 사조직인 산악회 활동을 조직적으로 확대하고 그 실적을 공천과 연계하겠다는 취지의 지시를 당원들에게 내렸다\"며 \"이는 민주당 윤리규범 제8조 사조직 가입 참여·유도 금지에 해당한다\"고 주장했다. 또 \"해당 산악회는 단순한 친목단체가 아니라 사실상 선거를 염두에 둔 조직으로 운영됐다\"며 \"이는 공직선거법 제89조 유사단체 설치 금지에 해당한다\"고 말했다. 아울러 공적으로 확보한 당원 연락처를 활용해 특정 조직 참여를 독려했다고도 밝혔다. 김 전 시의원은 \"해당 예비후보는 당원들에게 책임 있는 답을 내놓아야 한다\"며 \"선관위는 진상조사와 함께 책임을 묻고 합당한 판단을 내려야 한다\"고 강조했다. ◎공감언론 뉴시스 [email protected] $('iframe').addClass(\"frameCenter\"); function output(type,ob){ var windoption = \"width=760,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; if ( type == 'print' ) { windoption = \"width=860,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; } if(type == \"email\"){ } if(ob == \"article\"){ if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=NISX20260403_0003577273\"+ '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id=NISX20260403_0003577273&method='+type + '&type='+ob,'', windoption); } }else if(ob == \"photo\"){ var thopho_id = $(\"#hid_foc\").val(); if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=\"+ thopho_id + '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id='+ thopho_id +'&method='+type+'&type='+ob,'',windoption); } } } \"인류가 경험 못한 '미토스 대재앙' 온다…금융망 뚫리면 뱅크런(종합) 임우재 전 삼성전기 고문 '80대노인 감금' 가담 혐의 수감중 \"가짜인 줄 알고 팔았는데 진짜 롤렉스\"…이탈리아 남성의 황당 사기극 \"유명 배우 음주운전, 매니저가 뒤집어쓰기도 한다\" 혼다, 한국서 車사업 철수키로…\"모터사이클 사업 집중 지속\" 기업은행, 국세청 서비스에 'IBK인증서' 적용 법원 \"문체부의 정몽규 중징계 처분 정당\"…축구협회 패소 민주당, 인천 계양을 김남준·연수갑 송영길 전략 공천 정근식, 서울시교육감 '진보' 단일 후보로 선출 주한미군 전작권 전환 '2029년' 첫 언급, 한국은 '2028년'…조율 필요할 듯 정부 \"고유가 피해지원금 현금화 등 부정유통 단속 강화\" 이 대통령 \"글로벌 경제 불확실성 높아져…한·베트남 경제협력 어느 때보다 중요\" 이 대통령 \"한·베트남 미래 첨단산업 씨앗 함께 뿌려야\"…비즈니스 포럼 재계 총출동(종합) 주호영 \"대구시장 선거 불출마…장동혁 물러날 때 알아야\" \"가짜인 줄 알고 팔았는데 진짜 롤렉스\"…이탈리아 남성의 황당 사기극 미군 \"이란과 관련된 유조선 1척 또 나포\" 트럼프 \"이란 내부갈등 미친수준…합의할 때까지 해상봉쇄\" 멕시코 미인대회 출신 여성 피살…유력 용의자는 '시어머니' 'MAGA 여성 알고봤더니' 인도 의대생이 만든 AI…매달 수천달러 벌어 뉴욕증시, 이란전 불확실성에 하락 출발…다우 0.41%↓ ICC \"두테르테 전 比대통령, 반인도 범죄 혐의로 재판받을 것\" 확인(1보) 뉴욕증시, 이란전 불확실성에 하락 출발…다우 0.41%↓ 산업차관 \"4차 석유 최고가격 내려야 했지만 동결…3차 땐 올리지 않고 동결\" 4차 석유 최고가격 또 동결…휘발유 1934원·경유 1923원 내일부터 액상 전자담배 온라인 판매 안돼…가격도↑(종합) 韓기업들, 李 순방 계기로 베트남과 8200만불 규모 수출계약 달성 '18년 기다림' 끝났다…북아현2구역 관리처분인가 \"소득 많고 전문직일수록 AI 더 쓴다\"…불평등 심화 경고 기업은행, 국세청 서비스에 'IBK인증서' 적용 KB금융, 1분기 순이익 1조8924억원…전년比 11.5%↑ 내년부터 18세 생애 첫 국민연금 보험료, 국가가 낸다 코스피, 0.90% 상승한 6475.81마감 코스피, 6475.81로 사흘 연속 '최고치' 마감…장중 6500선도 넘겨(종합) \"삼성바이오, 전면파업 불가\"…가처분 신청 일부 인용 NH증권, 1분기 순이익 4757억원…\"사상 최대 실적\" 혼다, 한국서 車사업 철수키로…\"모터사이클 사업 집중 지속\" 日혼다, 한국서 올해 말 자동차 판매 사업 종료 日혼다, 韓진출 23년 만에 자동차 사업 전격 철수…\"모터사이클 판매·車AS는 지속\" 국제 석유제품 가격 내려갔지만…4차 최고가격 또 '동결' 현대차, 1분기 매출 45.9조 '역대 최대'…관세 여파 영업익은 30% 줄어 경영진 얼굴사진 밟고, 찢고…도 넘은 삼성전자 노조 '강경 퍼포먼스' 대한상의, '한-베트남 비즈니스 포럼' 개최…최태원·이재용·구광모 참석 \"인류가 경험 못한 '미토스 대재앙' 온다…금융망 뚫리면 뱅크런(종합) 쓰리빌리언, 300억 투자 유치…\"AI 유전진단 확장\" \"삼성바이오, 전면파업 불가\"…가처분 신청 일부 인용 \"디퓨저·향초 안 쓴다…미세먼지에도 환기는 필요\" 의사의 조언 간호·간병통합서비스, 비수도권 상급종합병원부터 확대 필수의료 형사부담 완화…의료계 \"중과실 범위 모호\" 어쩌다 주인 돼도 정부 허락 맡아야\"… '제2의 현대차-KT 방지법' 국회 통과 임우재 전 삼성전기 고문 '80대노인 감금' 가담 혐의 수감중 법원 \"문체부의 정몽규 중징계 처분 정당\"…축구협회 패소 \"아파트 복도에 '개인 헬스장' 만든 이웃…처벌 못 하나요\" 생후 4개월 '해든이' 살해, 친모 무기징역…친부 4년6개월 선고 \"온몸에 처절한 상처\" 4개월 '해든이' 학대·살해…친모 무기·친부 4년6월 선고(종합) 정근식, 서울시교육감 '진보' 단일 후보로 선출 4개월 아들 학대·살해, 친모 무기·친부 4년6개월 선고 임우재 전 삼성전기 고문 '80대노인 감금' 가담 혐의 수감중 정근식, 서울시교육감 '진보' 단일 후보로 선출 '18년 기다림' 끝났다…북아현2구역 관리처분인가 인천공항, 디지털 전시체험관 '엑스포트' 개관 정근식, 서울교육감 '진보' 단일 후보로 선출…\"우리는 원팀\"(종합) KB부동산 \"서울 아파트값 상승폭 다시 커져\" 삼성전자 노조 4만명 평택서 집회…외신들도 취재경쟁 생후 4개월 '해든이' 살해, 친모 무기징역…친부 4년6개월 선고 주호영 \"6·3 지방선거 대구시장 선거 불출마\" \"온몸에 처절한 상처\" 4개월 '해든이' 학대·살해…친모 무기·친부 4년6월 선고(종합) 정근식, 서울시교육감 '진보' 단일 후보로 선출 4개월 아들 학대·살해, 친모 무기·친부 4년6개월 선고 삼척 하장면 광업소 갱도 낙석 사고…50대 운전자 숨져 태백 장성동 산불, 헬기 10대 투입…2시간여 만에 '완진' \"텍스트힙은 건재하다\"…16기 민음북클럽 2만5천명으로 마감 철쭉 명소, 이젠 열린 관광지…합천 황매산군립공원 인천공항, 디지털 전시체험관 '엑스포트' 개관 무라카미 하루키, 3년 만에 장편 출간 …첫 여주인공 작품 최휘영 \"책은 우리가 나아가야할 길 비춰\"…'책 읽는 대한민국' 선포 경복궁과 팝업스토어의 만남…\"일상이 되는 K-헤리티지\" 제29회 한국가톨릭문학상, 소설가 김숨·시인 황동규 선정 'MLS 8경기 무득점' 손흥민, 콜로라도전 팀내 4번째 저평가 '부상 병동' 삼성, 또 전력 이탈…이재현, 허리 염증으로 엔트리 말소 세금포인트로 KT위즈 홈경기"},{"title":"더불어민주당 부산시당, 동래구·영도구·사상구 3개 기초단체장 경선 결과 발표","link":"https://www.lawissue.co.kr/view.php?ud=202604112050116549a8c8bf58f_12","source":"Bing","content":"더불어민주당 부산시당, 동래구·영도구·사상구 3개 기초단체장 경선 결과 발표 탁영일, 김철훈, 서태경 후보 선정 기사입력:2026-04-11 20:52:14 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 더불어민주당 부산시당더불어민주당 부산시당이미지 확대보기[로이슈 전용모 기자] 더불어민주당 부산시당은 4월 11일 부산 동래구와 영도구, 사상구 등 부산 3개 기초단체장 경선 결과를 발표했다. 4월 10일부터 11일까지 이틀 동안 진행된 경선 결과 동래구청장은 탁영일 후보가 주순희 후보를 제치고 승리했다. 영도구청장 후보 경선은 김철훈 후보가 박성윤 후보를 누르고 최종 후보로 선정됐다. 사상구청장 경선에서는 서태경 후보가 김부민 후보를 앞섰다. 현재 민주당 부산 기초단체장 후보로는 부산진구청장 서은숙, 북구청장 정명희, 수영구청장 김진, 금정구청장 김경지, 기장군수 우성빈, 중구청장 강희은 등 여성 후보가 6명에 이른다. 더불어민주당 부산시당은 서구청장 후보 결선 투표만 남기고 있다. 서구청장 후보 경선 결선 투표는 오는 17일과 18일 이틀 동안 진행된다. 더불어민주당 부산시당은 이와 함께 경선이 결정된 지역구 광역의원과 기초의원, 비례대표 후보 경선도 본격화할 방침이다.전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push({}); (adsbygoogle = window.adsbygoogle || []).push({}); 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 주요뉴스 민주당, 지선 '착!붙 10·11·12호' 공약... '실수로 해약한 예적금 복구·... 정치 장동혁, 자신 향한 내부 비판에 \"해당엔 행위 강력 조치\" 경고성 메시지 정치 대법원, 개인정보보호법 양벌규정 적용 공공기관의 개인 유죄 원심 파기환송 법조 李대통령 \"韓·베트남 관계 참으로 특별…원전·공급망 협력\" 정치 송언석, 일각 임기단축 요구 일축... \"선거 승리에 매진\" 정치 대법원, 보험설계사를 개인정보처리자로 보고 유죄 원심 파기환송 법조 .t_box1>ul>li {width:243px;} .today_box>.t_box1>ul>li>a>.thumb>img {width:243px; height:144px;} 핫포커스 김정문알로에 자회사 케이제이엠바이오, 치료제 없는 난청 관련 건기식 원료... 현대약품, 전립선비대에 의한 배뇨장애 해결 ‘유린타민캡슐’ 선보여 CJ제일제당, ‘고메