dxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 이준석·함익병 등 지도부 총출동… '오렌지 캠페인' 앞세워 본격 선거전 돌입 개혁신당 정이한 부산시장 후보.(사진_선거사무소) [시사매거진 한창기 선임기자] 개혁신당 정이한 부산시장 후보가 오는 26일 선거대책위원회 발대식을 열고 본격적인 선거 체제에 돌입한다. 정이한 후보는 이날 오후 2시 부산 부산진구 부전동 소재 선거사무소에서 발대식을 개최한다. 행사에는 이준석 대표와 함익병 총괄선대위원장을 비롯해 선대위 관계자, 지방선거 출마 희망자들이 대거 참석해 정 후보에 대한 지지세를 결집할 예정이다. 이날 이준석 대표는 정 후보에게 오렌지색 운동화를 직접 신겨주고 선거 점퍼를 입혀주는 퍼포먼스를 진행하며 필승의 의지를 다진다. 지난 대선 이후 다시 부산을 찾은 함익병 총괄선대위원장 역시 정 후보 격려에 나서며 힘을 보탤 계획이다. 선거사무소 2층은 '오렌지 캠페인'을 콘셉트로 조성됐다. 오렌지색 배경 아래 정 후보가 시민들과 소통하며 제작한 인터뷰 사진과 영상을 대형 스크린으로 상영, 현장의 생동감을 시민과 당원들에게 전달한다는 구상이다. 한편 정 후보는 지난 23일 중앙당으로부터 공천장을 수여받고 부산시당위원장 직무대행을 맡았다. 정 후보 측은 기존 동래 당사를 연산교차로 인근으로 이전하고, 시당 조직을 신속히 재정비해 선거 대응력을 강화할 방침이다. 정이한 후보 측은 \"이번 발대식을 기점으로 부산 전역에서 본격적인 선거운동에 총력을 다하겠다\"고 밝혔다. 키워드 #개혁신당 정이한 부산시장 후보 한창기 선임기자 aegookja@sisamagazine.co.kr 다른기사 보기 저작권자 © 시사매거진 무단전재 및 재배포 금지 당신만 안 본 뉴스 #skin-9 > .item:not(:first-child) {margin-top:12px} 금산군, 농어촌 기본소득 시범사업 신청 가능 여부 ‘주목’… 새 코로나 변이 바이러스 ‘매미’ 확산 “군산시향, 10년 만의 귀환… 동백처럼 단단하게 피어나다” '부산 탈환' 내건 조용우 전 민주당 기장군지역위원장, 부산시의원 비례 출마 선언 신천지, 대구서 말씀대성회 개최… 이만희 \"계시록 90% 성취\" 주장 [이홍종의 행복이야기] \"할머니들이 만드는 집밥 같은 음식으로 사람들에게 행복을 주고 싶다\" 영화 '논나' 국힘 부산 기초단체장 공천 완료…'현역 컷오프' 후폭풍에 원팀 균열 #skin-10 > .item {position:relative;margin-top:16px}\n#skin-10 > .item:first-child {margin-top:0}\n#skin-10 .frame::after {content:'';position:absolute;z-index:2;left:0;bottom:0;width:100%;height:100%;background:linear-gradient(rgba(0,0,0,0) 42%,rgba(0,0,0,.9));border:0}\n#skin-10 .auto-titles {position:absolute;z-index:15;left:16px;right:16px;bottom:16px}\n#skin-10 .height-250 {height:250px} 금산군, 농어촌 기본소득 시범사업 신청 가