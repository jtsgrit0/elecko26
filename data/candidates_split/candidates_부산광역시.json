('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 바로가기 메일보내기 복사하기 본문 글씨 줄이기 본문 글씨 키우기 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오톡(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 윤종서 전 중구청장, “조 의원, 나에게 불출마 종용하며 부산시 정무특보 제의” 폭로\n조 의원(후보매수)·최진봉 중구청장(기부행위) 각 피소 부산경찰청 반부패수사대 직접 나설 듯 윤종서 전 부산 중구청장이 9일 오후 긴급 기자회견을 열고, 조승환 국회의원과 최진봉 현 중구청장을 공직선거법 위반 혐의로 경찰에 고소했다고 밝혔다. [사진=이승준기자] 국민의힘 부산 중구청장 공천을 둘러싼 내홍이 결국 형사 고소전(戰)으로 확대됐다. 지난 5일 컷오프(공천 배제)된 윤종서 전 중구청장이 현역 국회의원과 현직 구청장을 공직선거법 위반 혐의로 경찰에 고소하면서, 지방선거를 50여 일 앞둔 시점에 지역 정가를 뒤흔드는 초대형 악재로 비화될 조짐이다. 윤 전 청장은 9일 오후 부산시의회 브리핑룸에서 긴급 기자회견을 열고, 조승환 국회의원(국민의힘, 중·영도구)과 최진봉 중구청장을 각각 공직선거법 위반 혐의로 부산 중부경찰서에 고소했다고 밝혔다. 윤 전 청장은 이번 사안을 “단란주점 후보 매수 사건”이라고 규정하며, 조 의원과 최 청장을 법의 심판대에 세우겠다며 포문을 열었다. 문제의 발단은 지난 2월 13일 부산 중구 소재 한 단란주점 술자리에서 시작됐다. 윤 전 청장 주장에 따르면, 조 의원과 지역구 당협 관계자 등이 설 명절 주민 인사를 마친 뒤 조 의원을 포함한 일행 4명이 술을 마셨다. 이 자리에서 조 의원이 “중구청장 출마를 포기하면 부산 아시아드CC 사장 또는 부산시 정무특보 자리를 주겠다”는 취지의 제안을 했다는 것이다. 윤 전 청장은 이를 두고 단순한 정치적 회유가 아니라, 공직선거법 제232조가 금지하는 ‘후보자 매수 및 이해유도죄’에 해당한다고 날을 세웠다. 선거 출마 포기의 대가로 공직 또는 이에 준하는 자리를 제안한 것은 선거의 공정성을 송두리째 흔드는 중대범죄라는 주장이다. 윤 전 청장이 확보해 놓았다는 소위 ‘술자리 동영상’을 통해 이같은 주장이 사실로 확인될 경우, 단순히 지역공천 잡음을 넘어 현역 국회의원의 정치생명까지 위협할 수 있는 중대 사안인 만큼 향후 정치적 파장이 어디까지 미칠지 가늠하기 힘들 것으로 보인다. 설상가상 여기에 술값 계산 문제까지 불거졌다. 윤 전 청장은 “술자리가 끝나기 5분 전 김명덕 영도구 당협 사무국장이 최진봉 중구청장을 데리고 왔고, 최 청장이 술값 19만 원을 결제했다”고 직격했다. 윤 전 청장은 본지 기자와의 통화에서 “결재 장면이 담긴 CCTV를 확보한 상태”이기 때문에, “최 청장은 공직선거법 제113조 ‘기부행위 금지’ 조항을 위반한 데 대한 어떠한 변명도 통하지 않을 것”이라고 강조했다. 선거와 관련된 이해관계자들에게 금품이나 향응을 제공하는 행위는 대표적인 불법 선거운동 유형으로 분류된다. 즉 액수의 과다를 떠나 선거 국면에서는 매우 민감한 것이 사실이다. 한편 이번 사건이 더욱 파장을 키우는 이유는 컷오프 당사자의 단순 폭로 수준을 넘어 정식으로 형사 고소가 접수되면서 사법의 영역으로 국면이 전환됐다는 점이다. 특히 현역 국회의원이 연루된 공직선거법 위반 사건인 만큼, 사건의 볼륨과 정치적 민감성을 고려할 때 부산경찰청 반부패·경제범죄수사대가 직접 수사에 나설 가능성도 거론된다. 국민의힘이 ‘혁신 공천’을 강조해 온 상황에서 벌어진 이번 사태는 그 명분 자체를 뒤흔드는 치명타가 될 것으로 예상된다. 공천 탈락 후보의 반발을 넘어 후보 매수, 향응 제공, 밀실 회유 논란까지 3중 악재가 동시에 겹치면서 “혁신공천은 커녕, 더러운 야합 공천”이라는 냉소가 부산 정치권 안팎에 급속도로 번지고 있다. 향후 경찰수사에서 단란주점 술자리 참석자의 진술, 공직 제안 발언의 주체 및 진위 여부, 술값 결제 경위 등이 핵심 쟁점이 될 것으로 보인다. 사실관계가 확인될 경우 부산 중구청장 선거는 물론 부산지역 국민의힘 공천 결과 전반을 놓고 ‘대국민 신뢰도’ 확보 여부를 기준으로 후폭풍이 거세질 수 있다. [스트레이트뉴스 부산/울산=이승준 기자] 저작권자 © 스트레이트뉴스 무단전재 및 재배포 금지 키워드 Tags #조승환 최진봉 윤종서 김명덕 국민의힘 단란주점\n#부산시 정무특보 공직선거법 이승준 기자 pre-sj@hanmail.net 다른기사 보기 SNS 기사보내기 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오톡(으)로 기사보내기 URL복사(으)로 기사보내기 이메일(으)로 기사보내기 다른 공유 찾기 기사스크랩하기 $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 당신만 안 본 뉴스 #skin-9 > .item:not(:first-child) {margin-top:12px} [단독] “전환배치인가 퇴출인가”…데이원컴퍼니 논란 확산 LS·대한전선, 수주잔고 10조 고지 돌파…\"장기 슈퍼사이클 진입\" 기업은행, ‘중소기업 동반성장’ 지속가능 빛나 \"진주 경제 살릴 적임자\"… 청년·소상공인단체 박명균 예비후보 지지 [르포] '강남·여의도·용산 다 20분\"...공시촌 노량진, 하이엔드로 상전벽해 [단독] 한화투자, ‘디지털자산 전문증권사’ 전환 속도 [살집 말집] 옥정중앙역 대방 디에트르, '넘사벽' 최고가 vs 대방 '억울해' #skin-10 > .item {position:relative;margin-top:16px}\n#skin-10 > .item:first-child {margin-top:0}\