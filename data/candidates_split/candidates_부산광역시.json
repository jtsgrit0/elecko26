 overflow: hidden; text-overflow: ellipsis; white-space: nowrap; position: relative; font-size: 0.875rem; font-weight: 600; color: var(--nd-body-color, #000); } #skin-27 .auto-wrapper { flex: 1 1 0; min-width: 0; max-width: 100%; }\n실시간 이소희 의원, ‘환자 학생 학교생활 개선’ 정책토론회 27일 개최 박수현 민주당 충남도지사 예비후보, “소상공인 경제에 역량 집중” 김현정 의원 주최 , 권오을 보훈부 장관 초청 특강 을지대 간호대학, 제36회 나이팅게일 선서식 개최 미동산수목원 숲길 5코스 완주 도전… 숲길걷기 교육생 모집 괴산·음성 농촌용수 개발,국비 282억원 확보로 농업 경쟁력 강화 우리금융, 보통주비율 중장기 목표 조기 달성 평택복지재단, 2026년 사회복지사 역량성장 과정 4회기 교육 성료 동국대, 세계적 석학 피터 싱어 초청 강연 성료 계룡시, ‘2026년 인구정책위원회’ 개최…인구증가 방안 모색 $(function() { $('#roll-27').slick({ arrows: false, // 화살표표시 dots: false, // pager vertical: true, // 세로방향 verticalSwiping: true, // 세로swiping infinite: true, // 무한넘기기 autoplay: true, // 자동전환 //autoplaySpeed: 4000, // 자동전환속도 speed: 600, // 넘기는 속도 });\n}); 로그인 회원가입 기자명 이상철 기자 입력 2026.04.24 21:17 SNS 기사보내기 공유 인쇄 본문 글씨 키우기 본문 글씨 줄이기 SNS 기사보내기 (사진제공:민주당 부산시당) 성평등 공약 선포식 [부산=글로벌뉴스통신] 더불어민주당 전국여성위원회(위원장 이수진)는 24일(금) 오전 11시 30분 더불어민주당 부산시당에서 ‘성평등 공약 선포식’을 개최했다. 부산 선포식에는 강희은 부산 중구청장 후보, 김경지 금정구청장 후보, 김진 수영구청장 후보를 비롯해, 부산지역 광역·기초 의원들 30여명이 참여해 성평등 지방선거를 다짐했다. 이수진 전국여성위원장은 “부산지역에서 여성기초단체장 후보가 6명이나 나왔다는게 감격스럽다”며 “여기 모인 여성 광역·기초의원 후보들이 부산의 미래를 위해 멋진 꿈을 꾸고 있을 것”이라고 말문을 열었다. 이수진 위원장은 “대한민국 제2의 도시, 해양·물류 산업의 중심지이자 서비스·관광·돌봄 노동이 밀집된 도시인 부산에서 여성들의 삶은 불안정 고용, 낮은 임금, 경력단절, 일자리 부족으로 청년 유출 등의 문제를 겪고 있다”고 짚었다. 또한 특히나 낮은 부산의 여성 정치대표성을 지적하며 이번 지방선거에서 “부산의 변화의 바람이 대한민국 정치 구조의 변화를 이끄는 신호가 될 것”이라고 기대감을 나타냈다. 30대 청년인 강희은 중구청장 후보는 “부산 중구의 첫 30대 구청장 후보”라고 자신을 소개하고, “여성위원회의 다양한 선배들 덕분에 여성정치인으로서, 청년정치인으로서 용기낼 수 있었다”며 “기초단체장으로서 실현할 수 있는 성평등 공약으로 성평등 중구, 성평등 부산을 만들겠다”고 포부를 밝혔다. #AD157863668313.ad-template { float:right; position:relative; display:block; clear:both; z-index:1; padding:15px; }\n#AD157863668313.ad-template .col { text-align:center; }\n#AD157863668313.ad-template .col .ad-view { position:relative; } 김경지 금정구청장 후보는 “부산은 가부장적 문화가 다른 지역에 비해 강한 지역임에도 불구하고 이번 지방선거에서 여성기초단체장 후보가 6명이나 나왔다”며 “아마도 이번만은 꼭 바꿔달라는 당원들과 부신시민들의 염원인 것 같다”고 말했다. 덧붙여 “여성후보들이 승리해서 일 할 권리를 갖는 것이 시민들과 당원들에게 성평등 약속을 실현하는 첫걸음”이라고 목소리를 높였다. 김진 수영구청장 후보는 “수영구를 보수세가 강하다고 하지만, 인구변화로 인해 이번만큼은 승리할 수 있을 것”이라고 자신감을 보였다. 또한 “엄마로서, 딸·며느리, 아내로서 그리고 작가로서 남성 후보와는 다르게 주민들의 피부에 와닿는 공약을 만들 수 있다”고 강조했다. 기초의원 후보 두 명도 발언에 동참했다. 강소영 영도구의원 후보는 선박수리업을 하는 남편과 함께 선박 현장에서 일하면서 겪었던 성차별적 환경을 토로했다. 강 후보는 “금녀 구역인 선박현장에서 ‘여자가 무슨 선박수리 일을 하냐’고 별의별 말들을 들었지만, 저에게 이 일은 생계의 문제였다”며, “부당한 일이나 여성으로서 차별을 겪고 있는 분들에게 힘이 되고 싶다”고 출마의 포부를 밝혀 큰 박수를 받았다. 신송자 동구의원 후보도 홀로 두 아이를 키우면서 겪었던 어려움을 토로하고, “지역사회에서 꾸준히 봉사활동에 매진하다보니 주변에서 동구의 발전을 위해 본보기가 되라는 추천을 받았다”며 출마의 이유를 밝혀 눈길을 끌었다. 이번에 전국여성위원회가 제안하는 성평등 공약은 약 1,000여 명의 여성 유권자를 대상으로 온·오프라인 설문과 심층면접을 바탕으로 도출됐다. 공약은 일자리·경제활동, 돌봄·가족, 젠더폭력·안전, 건강·기후환경, 대표성·추진체계 등 5개 영역으로 구성되며, 각 지역 상황에 맞는 ‘맞춤형 성평등 공약’으로 활용될 예정이다. 전국여성위원회가 제안하는 대표적인 공약으로는 성평등 임금공시제 도입 및 확산 ▲지역 민간 고용평등상담실 설치 및 확대 ▲1인 여성 자영업자 지원센터 설치 및 운영 ▲지역 돌봄 통합 추진체계 강화와 재정 확보 ▲지역 디지털 성범죄지원센터 강화 ▲여성 1인 가구 안전한 지역 만들기 ▲공공 산후조리원 운영 및 방문형 산모·신생아 건강지원 ▲병원 안심 동행 서비스 활성화 ▲기후위기 대응 여성참여 확대 ▲지역 성평등정책 전담 부서·기관 확대 및 강화 등이 있다. $(function() { const copyUrlOptions=document.querySelectorAll(\".urlBtns, .sns_clipboard\"); // 주소복사 이벤트 (v11-fl-v2 수정) copyUrlOptions.forEach(selector=>{ selector.addEventListener(\"click\", (e)=>{ const target=e.target, targetBtn=target.closest(\"[data-clipboard-text]\"); if (targetBtn===null) return; const url=targetBtn.getAttribute(\"data-clipboard-text\")||\"\"; Util.copyToClipboardToast(selector, '', url); }); }); // 사진 lightBox 이벤트 if (typeof ImageViewer != \"undefined\") { new ImageViewer(\".photo-layout\", 0); } }); SNS 기사보내기 이메일(으)로 기사보내기 다른 공유 찾기 기사스크랩하기 $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseTe