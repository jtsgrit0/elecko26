약 해제·해지 기준과 수분양자 대응 포인트 [기고]법무부 보호자특별교육, 소년 사범의 성장을 위한 마중물 (adsbygoogle = window.adsbygoogle || []"},{"title":"부산 민심, ‘검증된 현역’ 택했다···국민의힘 기초단체장 7곳 공천 확정","link":"https://www.msn.com/ko-kr/news/other/%EB%B6%80%EC%82%B0-%EB%AF%BC%EC%8B%AC-%EA%B2%80%EC%A6%9D%EB%90%9C-%ED%98%84%EC%97%AD-%ED%83%9D%ED%96%88%EB%8B%A4%EA%B5%AD%EB%AF%BC%EC%9D%98%ED%9E%98-%EA%B8%B0%EC%B4%88%EB%8B%A8%EC%B2%B4%EC%9E%A5-7%EA%B3%B3-%EA%B3%B5%EC%B2%9C-%ED%99%95%EC%A0%95/ar-AA21eHbr?ocid=BingNewsVerp","source":"Bing"},{"title":"국민의힘, 부산 '광역의원 3곳·기초의원 4곳' 경선 발표","link":"https://www.msn.com/ko-kr/news/politics/%EA%B5%AD%EB%AF%BC%EC%9D%98%ED%9E%98-%EB%B6%80%EC%82%B0-%EA%B4%91%EC%97%AD%EC%9D%98%EC%9B%90-3%EA%B3%B3-%EA%B8%B0%EC%B4%88%EC%9D%98%EC%9B%90-4%EA%B3%B3-%EA%B2%BD%EC%84%A0-%EB%B0%9C%ED%91%9C/ar-AA21nKYJ?ocid=BingNewsVerp","source":"Bing"},{"title":"국힘 부산 동래 출마예정자, 박중묵 구청장 예비후보 지지 선언","link":"https://www.yna.co.kr/view/AKR20260409077800051","source":"Bing","content":"부산 동래구 현직 구의원들과 시의원·구의원 출마예정자들이 국민의힘 동래구청장 후보로 박중묵 예비후보를 지지한다고 선언했다.\n동래구의회 현직 의원 3명과 시의원·구의원 출마예정자들은 9일 부산시의회에서 기자회견을 열어 \"현재 동래는 변화와 혁신, 안정적인 행정 경험을 바탕으로 동래의 미래를 이끌어갈 준비된 리더가 절실히 필요하다\"며 \"오랜 기간 지역을 위해 일해 온 박 예비 후보자가 동래의 미래를 책임질 가장 확실한 선택\"이라고 말했다.\n이어 \"박 예비 후보자는 시의원 3선 의정 경험과 국회의원 보좌관, 구청장 비서실장 등 풍부한 행정 경험을 해와 정책과 현장을 모두 아는 검증된 인물\"이라며 \"실천력과 소통력, 균형 잡힌 발전 전략을 갖춰 동래를 한 단계 도약하게 할 것\"이라고 했다. 인공지능이 자동으로 줄인 '세 줄 요약' 기술을 사용합니다.전체 내용을 이해하기 위해서는 기사 본문과 함께 읽어야 합니다. 오수희기자 구독\n구독중 이전\n다음 이미지 확대 부산 동래 구의원·출마예정자들, 박중묵 예비후보 지지 선언\n촬영 오수희 기자 (부산=연합뉴스) 오수희 기자 = 부산 동래구 현직 구의원들과 시의원·구의원 출마예정자들이 국민의힘 동래구청장 후보로 박중묵 예비후보를 지지한다고 선언했다. 동래구의회 현직 의원 3명과 시의원·구의원 출마예정자들은 9일 부산시의회에서 기자회견을 열어 \"현재 동래는 변화와 혁신, 안정적인 행정 경험을 바탕으로 동래의 미래를 이끌어갈 준비된 리더가 절실히 필요하다\"며 \"오랜 기간 지역을 위해 일해 온 박 예비 후보자가 동래의 미래를 책임질 가장 확실한 선택\"이라고 말했다. 이어 \"박 예비 후보자는 시의원 3선 의정 경험과 국회의원 보좌관, 구청장 비서실장 등 풍부한 행정 경험을 해와 정책과 현장을 모두 아는 검증된 인물\"이라며 \"실천력과 소통력, 균형 잡힌 발전 전략을 갖춰 동래를 한 단계 도약하게 할 것\"이라고 했다. 그러면서 \"동래는 말이 아닌 결과로 증명할 리더를 선택해야 한다\"며 \"박 예비 후보자와 함께 구민 중심의 행정, 공정하고 투명한 구정 운영, 그리고 미래 세대를 위한 동래를 만들어 가겠다\"고 덧붙였다. 국민의힘 부산 동래구청장 공천을 두고는 장준용 현 구청장과 박 예비후보, 권오성 전 시의원이 경쟁하고 있다. osh9981@yna.co.kr 제보는 카카오톡 okjebo <저작권자(c) 연합뉴스,\n무단 전재-재배포, AI 학습 및 활용 금지> 2026/04/09 11:05 송고\n2026년04월09일 11시05분 송고 #부산 #동래구청장 #박중묵 예비후보 댓글 좋아요 슬퍼요 화나요 후속요청 <button type=\"button\" class=\"btn-type300 style20 arr01\" data-pop-open=\"pop-comment\" data-stat-code=\"article_comment01\"> {{#if IS_COUNT}} <span class=\"bold color21\">{{COUNT_TEXT}}</span> <span class=\"txt01\">개 댓글 전체보기</span> {{else}} <span class=\"txt01\">댓글 작성하기</span> {{/if}} </button> 국내 최대 원스톱 콘텐츠 제공 플랫폼 함께 보면 좋은 콘텐츠 by\n데이블 window['dablewidget_OoRAgyMX'] = function(){ (function(d,a,b,l,e,r) { if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l); e.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js'; r=a.getElementsByTagName(l)[0];r.parentNode.insertBefore(e,r); })(window,document,'dable','script'); dable('setService', 'yna.co.kr'); dable('sendLogOnce'); dable('renderWidget', 'dablewidget_OoRAgyMX');\n} 광고 window['div-gpt-ad-1587522573500-0'] = function(){ googletag.cmd.push(function() { googletag.defineSlot('/21961356670/korean_pc_web_article_body_bottom1_btf_300x250_200417', [300, 250], 'div-gpt-ad-1587522573500-0').addService(googletag.pubads()); googletag.display(\"div-gpt-ad-1587522573500-0\"); }); } window['div-gpt-ad-1589789760428-0'] = function(){ googletag.cmd.push(function() { googletag.defineSlot('/21961356670/korean_pc_web_article_body_bottom2_btf_300x250_200518', [300, 250], 'div-gpt-ad-1589789760428-0').addService(googletag.pubads()); googletag.display('div-gpt-ad-1589789760428-0'); }); } 함께 읽기 좋은 콘텐츠 Taboola 후원링크 window['taboola-below-article-widget_08162024-pc'] = function(){ window._taboola = window._taboola || []; _taboola.push({ mode: 'thumbs-feed-2x4', container: 'taboola-below-article-widget_08162024-pc', placement: 'Below Article Widget_08162024', target_type: 'mix' }); window._taboola = window._taboola || []; _taboola.push({flush: 