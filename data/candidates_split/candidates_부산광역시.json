 로그인 회원가입 기사검색 #AD174493702965.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493702965.ad-template .col { text-align:center; }\n#AD174493702965.ad-template .col .ad-view { position:relative; } // 기사면 상단 네비게이션 호출 articleHeader.setScroll(); $(window).scroll(function() { var currY = $(this).scrollTop(); var postHeight = $(this).height(); var scrollHeight = $('body').height(); var scrollPercent = (currY / (scrollHeight - postHeight)) * 100; $('.aht-bar').css('width', scrollPercent +\"%\"); // hide for font size dropdown if(currY < 300) { $(\"#fontsize-sticky\").foundation(\"close\"); } }); 이전 기사보기 다음 기사보기 정성철, 김성수 해운대구청장 의혹 직격…\"당 차원 엄중 대응 필요\" 글자크기 설정 가 가 기사의 본문 내용은 이 글자크기로 변경됩니다. 스크롤 이동 상태바 지역 정성철, 김성수 해운대구청장 의혹 직격…\"당 차원 엄중 대응 필요\" 이주현 기자 입력 2026.04.14 17:39\n댓글 0 글자크기 설정 가 가 기사의 본문 내용은 이 글자크기로 변경됩니다. $(function() { // information group $(\".info-group\").on(\"click\", \".info-update\", function(e) { const _this = $(e.currentTarget); if(_this.hasClass(\"show\")) { _this.removeClass(\"show\"); } else { _this.addClass(\"show\"); } }); // scrap button $('.helper-tool-group').on('click', '.page-scrap', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 2026-04-14 17:39:49(부산=뉴스1) 이주현 기자 = 정성철 국민의힘 해운대구청장 예비후보.(정성철 예비후보 측 제공. 재판매 및 DB금지) 정성철 국민의힘 해운대구청장 예비후보가 각종 비리 의혹에 휩싸인 김성수 현 해운대구청장과 관련해 당 차원의 신속한 대응을 촉구했다.정 예비후보는 15일 입장문을 내고 \"최근 언론을 통해 연일 보도되고 있는 김 구청장의 각종 의혹은 매우 심각한 상황\"이라며 \"당 차원의 엄중하고 신속한 조치가 필요하다\"고 밝혔다.그는 \"30억 원대 편법 대출 의혹을 비롯해 거액 현금 수수, 재산 신고 누락, 인허가권 남용 의혹에 이어 특정 병원 개원을 위한 행정력 사유화 정황이 담긴 육성 녹취까지 공개됐다\"며 사안의 중대성을 강조했다.이어 \"이 같은 치명적인 리스크를 안고 본선에 직행할 경우, 민주당의 공세에 제대로 대응할 명분과 논리를 잃게 된다\"며 \"구민들에게 지지를 호소할 최소한의 자격마저 흔들릴 수 있다\"고 우려했다.정 예비후보는 또 \"연일 이어지는 보도로 인해 해운대 지역 민심이 빠르게 이탈하고 있으며, 당 소속 후보들 사이에서도 선거판 전체가 흔들릴 수 있다는 위기감이 커지고 있다\"고 말했다.그러면서 \"비리 정황이 육성으로 공개된 상황을 방치할 경우 해운대를 넘어 부산 전체 선거 판세에도 악영향을 미칠 것\"이라며 \"당을 위기에서 구하고 선거 승리를 이루기 위해 지도부와 공천관리위원회의 결단이 필요하다\"고 촉구했다.한편 김성수 구청장은 입장문을 통해 관련 혐의를 전면 부인했다. 부정 대출 건에 대해서는 김 구청장은 \"은행이 지정한 감정평가 기관의 평가를 거쳐 아내 명의 부동산에 담보를 설정했고, 정상적인 심사를 통해 대출이 이뤄졌다\"고 해명했다.직권남용 의혹에 대해서는 \"병원 인허가는 시청 소관 업무로 구청장이 개입할 여지가 없다\"고 설명했다. #AD174493715234.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD174493715234.ad-template .col { text-align:center; }\n#AD174493715234.ad-template .col .ad-view { position:relative; } const API_KEY = 'fb8790905a5868f9a873dec18888f6d1'; let aedi = new Aedi(); var aediWritingTime = document.querySelector('meta[property=\"article:published_time\"]').content; aedi.adOpen(API_KEY, document.querySelectorAll('#article-view-content-div :is(figure, table) img'), aediWritingTime); #AD174493836076.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD174493836076.ad-template .col { text-align:center; }\n#AD174493836076.ad-template .col .ad-view { position:relative; } $(function() { const copyUrlOptions=document.querySelectorAll(\".urlBtns, .sns_clipboard\"); // 주소복사 이벤트 (v11-fl-v2 수정) copyUrlOptions.forEach(selector=>{ selector.addEventListener(\"click\", (e)=>{ const target=e.target, targetBtn=target.closest(\"[data-clipboard-text]\"); if (targetBtn===null) return; const url=targetBtn.getAttribute(\"data-clipboard-text\")||\"\"; Util.copyToClipboardToast(selector, '', url); }); }); // 사진 lightBox 이벤트 if (typeof ImageViewer != \"undefined\") { new ImageViewer(\".photo-layout\", 0); } }); #AD174493840098.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493840098.ad-template .col { text-align:center; }\n#AD174493840098.a