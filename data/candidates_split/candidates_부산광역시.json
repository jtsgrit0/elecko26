선 일정이 확정났다\"며 \"경선 일정은 추후 공관위 논의를 거친 후 발표할 예정\"이라고 말했다. 지금 뜨는 뉴스 장동혁 거짓말 파문…美 '뒤통수' 인물은 차관 비서실장 정유라 \"아들 못만나\"…교도소 측 \"스마트접견까지 허용\"[오목조목] [단독]층간소음이 '스토킹' 됐다…영화 같은 실화[노컷브이] '前삼성가 사위' 임우재의 몰락…무당 애인 범행 도운 혐의로 실형 [단독]\"故김수미 건강 악화로 '친정엄마' 중단 검토도\" vs \"그런 적 없다\" 현대차 1분기 최대 매출에도 영업익 30.8% 감소…관세·전쟁 '타격' 서울 아파트 매매가격 상승폭 확대, 강남3구 중 송파구 하락에서 반전 정유라 아들 못 만난다고 했지만…[어텐션 뉴스] 국힘, 정동영 해임 건의안 당론 제출키로 분명히 박살냈다는데?…\"이란 국방 전력 60% 건재\" ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 정혜린 기자메일구독 6·3 지방선거 구독 국힘 강기윤 창원시장 후보, 사전선거운동 의혹 선관위 조사 충북 현역 단체장 전원 등판 완료…거센 도전 속 선거전 점화 선관위 \"이진숙 무소속 출마, 탈당 시한 5월 13일…투표함 24시간 공개\" 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6506308); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"국민의힘 부산시당, 11차 공천관리위원회 개최 결과 발표","link":"https://www.globalnewsagency.kr/news/articleView.html?idxno=471294","source":"Bing","content":"2026-04-23 23:22 (목) #skin-27 { --nd-atx-title-font-size: 0.8125rem; --nd-atx-title-font-weight: 400; --nd-atx-title-line-height: 21px; display: flex; flex-direction: row; align-items: center; gap: 0.75rem; } #skin-27::after {