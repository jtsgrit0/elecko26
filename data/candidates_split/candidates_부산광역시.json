도주…70대 남성 검거 배현진, 장동혁 향해 \"집 안에서 행패 부리는 무능한 가장\" \"고용노동부에 휘발유 뿌리고 방화 시도\"…50대 항소심도 징역 2년 '구성 핵시설' 한미 간 이견 확인…靑 \"출구 찾는중\" 연일 천장 뚫었던 코스피, 잠시 숨 고르며 개장 전국 경유가격도 2천원 돌파…석유 최고가 4차 동결에도 상승세 다시 채우려면 6년…美, 대만 유사시 '미사일 전력 구멍' 우려 현대차, 中 맞춤형 '아이오닉 V' 공개…연간 50만대 팔겠다 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 강민정 기자메일구독 6·3 지방선거 구독 \"휴대폰 가지고 경로당으로 오셔요\"…당내 경선 여론조사 대리응답 적발 이정현 \"광주·전남, 후공정 산업 중심 전환…30% 혁명 필요\" 국힘 대구 중구청장 정장수 후보 단수 추천…수성구청장 4인 경선 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6492372); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"민주당, 광역의회 중대선거구 도입 추진…진보 5당과 공동선언","link":"https://www.asiae.co.kr/article/2026040216395724904","source":"Bing","content":"사이트맵메뉴 열기 증권 경제 부동산 산업·IT 정치 사회 국제 문화·라이프 오피니언 전국 Visual-News 2026년 04월 24일(금) 로그인 / 회원가입 소셜 아이콘영역 님 EN 검색창 열기 검색창 열기 닫기버튼 if(is_PC){ document.write(` <!-- S: [광고:PC-12]--> <div class=\"d-none d-lg-block\"> <script type=\"text/javascript\" src=\"https://a1.asiae.co.kr/RealMedia/ads/adstream_jx.ads/Asiae_pc/politics@Middle1\"></sc`+`ript> </div> <!-- E: [광고:PC-12] -->\n`);\n} if(is_Mobile){ documen