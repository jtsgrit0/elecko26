kn.visibility=\"hidden\";} else if (ns6||ie4) skn.display=\"none\" } //--> 이 기사를 공유해보세요 ⓒ 프라임경제(http://www.newsprime.co.kr) 무단전재 및 재배포금지 var cmtPageNo = 1; loadComment = function(pageNo) { if (pageNo == 0) { return; } cmtPageNo = pageNo; $.get('/news/comment.html', {no:729964, target_code:'A', sid:'', page:cmtPageNo}, function(data) { $('#commentPane')."},{"title":"개혁신당 부산, 출마자 입당식 개최...구청장 1명·기초의원 7명","link":"https://www.pennmike.com/news/articleView.html?idxno=118459","source":"Bing","content":"후원계좌 : 기업0221385881 정기구독(후원) 신청 펜앤마이크TV 바로가기 펜앤경제TV 바로가기 기사검색 검색항목 제목 본문 글작성자 검색 상세검색 전체메뉴 버튼 홈 이슈포커스 정치 사회 경제·산업 외교·안보 미디어 줌인뉴스룸 칼럼 기획·연재 펜앤여론조사 박명훈 입력 2026.04.09 16:52 수정 2026.04.09 19:20 다른 공유 찾기 기사스크랩하기 글씨크기 본문 글씨 줄이기 본문 글씨 키우기 인쇄하기 이준석 “기존 부산 후보들은 부산의 문제에 책임져야” 개혁신당 부산 출마예정자 입당식.[사진=박명훈 기자] 개혁신당 부산시당은 9일 오후 정이한 부산시장 후보 선거사무실에서 출마자들의 입당식이 개최됐다. 이날 입당식에는 이준석 개혁신당 대표를 비롯해 정이한 후보 등 개혁신당 관계자들이 참석했다. 개혁신당 출마자는 최봉환 금정구청장 후보를 비롯해 기초의원 후보 ▲권민찬 금정구 라 ▲조연우 기장군 다 ▲홍예준 동래구 나 ▲신유림 부산진구 다 ▲오다겸 사하구 마 ▲고귀한 연제구 가 ▲김신재 해운대구 다 ▲문현진 김해 사 등이다. 이날 이준석 대표는 “정이한 후보가 젊음을 상징하는 후보가 됐다”며 “부산의 여러 후보들은 부산 여러 문제에 대한 책임이 있다. 가령 전재수 의원은 문재인 정부 시절 부산을 어떻게 발전시켰는가. 이번 개혁신당 젊은 후보들을 대안으로 검토해 주시면 좋을 것 같다”고 전했다. #AD174781467253.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD174781467253.ad-template .col { text-align:center; }\n#AD174781467253.ad-template .col .ad-view { position:relative; } var ___BANNER = \"ban_1747814697_517\"; #AD170564269262.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD170564269262.ad-template .col { text-align:center; }\n#AD170564269262.ad-template .col .ad-view { position:relative; } 이어 정이한 후보는 “부산이 전국 지방선거의 교두보가 되고, 보수 풀뿌리 민주주의의 대안으로 자리잡을 수 있게 시당 차원에서도 각고의 노력을 해나가겠다”고 덧붙였다. 부산=박명훈 기자 parkmh1998@naver.com 박명훈 parkmh1998@naver.com 다른기사 관련기사 정이한, ‘침례병원’ 재가동 대안은 “공공병원 전제 ‘민간위탁운영’” 펜앤마이크는 '자유·진실·시장'의 가치를 바탕으로 대한민국의 헌정 질서와 체제를 지켜갑니다. 정기구독(후원)으로 응원하기 저작권자 © 펜앤마이크 무단전재 및 재배포 금지 #AD169217468927.ad-template {