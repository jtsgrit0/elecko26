ment).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오스토리(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 국민의힘 부산시당 전경. #AD162702432432.ad-template { float:right; position:relative; display:block; clear:both; z-index:1; padding:10px 0 0 15px;}\n#AD162702432432.ad-template .col { text-align:center; }\n#AD162702432432.ad-template .col .ad-view { position:relative; } (미디어인뉴스=김성원 기자) 국민의힘 부산시당 공천관리위원회가 제9회 전국동시지방선거를 앞두고 부산지역 기초단체장 후보 선출 결과를 공개했다. 공관위는 19일 회의를 통해 경선이 진행된 7개 지역의 최종 후보를 확정했다. 이번 심사를 거쳐 본선행이 결정된 인물은 총 7명으로, 지역별로는 서구 공한수, 부산진구 김영욱, 동래구 장준용, 해운대구 김성수, 사하구 김척수, 연제구 주석수, 기장군 정명시 후보가 이름을 올렸다. 특히 눈에 띄는 점은 현직 구청장들의 강세다. 서구와 부산진구, 동래구, 해운대구, 연제구 등 5개 지역에서 현역 단체장이 경선 경쟁을 뚫고 다시 후보로 확정되며 조직력과 인지도를 입증했다. 경선은 지난 17일부터 이틀간 진행됐으며, 당원과 시민의 의견을 절반씩 반영하는 방식으로 치러졌다. 구체적으로는 선거인단 투표와 일반 여론조사 결과를 각각 50% 비율로 합산해 최종 순위를 가렸다. #AD159522330798.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD159522330798.ad-template .col { text-align:center; }\n#AD159522330798.ad-template .col .ad-view { position:relative; } var cont_ODI2= \"#article-view-content-div p\";\nvar cont_num_ODI2= \"10\"; 공관위는 투표 결과와 여론조사 수치를 동일 기준으로 환산한 뒤 합산하고, 여기에 후보별 가산점과 감점 요소를 반영해 최종 결과를 도출했다고 설명했다. 이러한 절차를 통해 공정성과 객관성을 확보하는 데 중점을 뒀다는 입장이다. 국민의힘 부산시당은 이번 경선 결과를 바탕으로 본선 경쟁력을 강화하고, 지역별 맞춤 전략을 통해 지방선거 승리를 노린다는 계획이다. 키워드 #국민의힘\n#구청장공천\n#후보확정 김성원 기자 ulruru5@gmail.com 다른기사 보기 저작권자 © 미디어인뉴스 무단전재 및 재배포 금지 당신만 안 본 뉴스 #skin-9 > .item {margin-top:12px}\n#skin-9 > .item:first-child {margin-top:0}\n#skin-9 .auto-titles {letter-spacing:-.05em} 민주당 서울시당 기초단체장 4차 