e.log(\"request.responseText\", request.responseText); //alert(request.responseText); } }); } 공유하기 공유 카카오톡 페이스북 트위터 네이버블로그 주소복사 네이버 구독 구독 다음 구독독 구독 googletag.cmd.push(function() { googletag.display('div-gpt-ad-1741066356758-0'); }); 사회 전국 민주당 부산시당, 제6차 지선 공천 발표…광역·기초의원 후보 윤곽 뉴스1 입력 2026.04.07 15:23 수정 2026.04.07 15:23 확대 축소 출력 더불어민주당 부산시당 로고.(민주당 부산시당 제공. 재판매 및 DB금지) (부산=뉴스1) 이주현 기자 = 더불어민주당 부산시당 공"},{"title":"부산 민주당, 기초단체장 경선 스타트…중·서·금정·수영 4곳 경쟁 시작","link":"https://www.nocutnews.co.kr/news/6492372","source":"Bing","content":"핵심요약중·서·금정·수영 4개 지역서 9명 출사표…경선 대진 확정합동연설회·토론회로 검증 강화…유튜브 생중계 병행내달 3~4일 ARS 투표…4일 오후 결과 발표 부산시당 선거관리위원회는 27일 부산시의회에서 후보 발표와 함께 공명선거 서약식을 열었다. 부산시의회 제공더불어민주당 부산시당이 6·3 지방선거를 앞두고 기초단체장 후보 선출을 위한 경선 일정에 본격 착수했다. 중구·서구·금정구·수영구 등 4개 지역에서 총 9명의 후보가 등록을 마치며 당내 경쟁 구도가 형성됐다. 부산시당 선거관리위원회는 27일 부산시의회에서 후보 발표와 함께 공명선거 서약식을 열고, 공정하고 투명한 경선 운영 방침을 공식화했다. 시당은 이번 경선을 통해 당원 결집과 본선 경쟁력 확보의 발판을 마련하겠다는 계획이다.4개 지역 9명 경쟁…경선 구도 윤곽 이번 경선에는 지역별로 복수 후보가 맞붙는다.중구청장 경선에는 강희은 중구의회 부의장과 김시형 전 중구의회 부의장이 나섰고, 서구청장 경선에는 황정 민주당 정책위 부의장과 정진영 전 서구의회 운영기획위원장, 황정재 서구의회 부의장이 출마했다.금정구청장 경선은 이재용 금정구의회 의원과 김경지 변호사가 맞대결을 벌이며, 수영구청장 경선에는 김성발 전 지역위원장과 김진 전 수영구의회 의장이 경쟁 구도를 형성했다.합동연설회·토론회로 '검증 강화'민주당 부산시당은 후보 검증 절차를 강화하기 위해 합동연설회와 지역별 토론회를 연이어 개최한다.부산시당 선거관리위원회는 27일 부산시의회에서 후보 발표와 함께 공명선거 서약식을 열었다. 부산시의회 제공 합동연설회는 오는 30일 오후 6시 30분 부산시당 대회의실에서 열리며, 이어 31일에는 중구와 서구, 다음 달 1일에는 금정구와 수영구 순으로 토론회가 진행된다.모든 일정은 해당 지역 당원에게 공개되며, 시당 공식 유튜브 채널 '부산민주당TV'를 통해 실시간 중계도 이뤄질 예정이다.4월 3~4일 ARS 투표…경선 결과 발표경선 투표는 4월 3일부터 4일까지 이틀간 진행된다. 안심번호 선거인단과 권리당원 선거인단을 대상으로 ARS 방식으로 실시되며, 최종 결과는 4일 오후 8시 발표된다.김도경 부산시당 선거관리위원장은 \"이번 경선은 당원들의 뜻을 모으고 본선 승리를 준비하는 중요한 과정\"이라며 \"모든 후보가 공정한 환경에서 경쟁할 수 있도록 투명한 선거 관리에 최선을 다하겠다\"고 밝혔다.민주당 부산시당은 이번 1차 경선을 시작으로 다른 지역 공천 절차도 순차적으로 진행하며 지방선거 체제 전환에 속도를 낼 방침이다. 지금 뜨는 뉴스 이진숙 대구시장 불출마 \"대구까지 좌파 넘어가면 안 돼\" 휘발유값보다 무서운 전기요금 충격 임박 \"전력 30% 가스가 전기도매가 83% 좌우\"[기후로운 경제생활] 美중앙 사령부 \"이란 국적 선박 추가 나포\" 유흥업소 직원 호객 중 말다툼에 흉기 휘둘러…살인미수 구속 잠수 장비 이용해 해삼 1120kg 불법 채취한 일당 적발 '바쉐론 수수 의혹' 김건희 \"로봇개 들어본 적도 없어\" 모수 '와인 바꿔치기 논란'[어텐션 뉴스] 검찰 '사기적 부정거래' 의혹 방시혁 구속영장 반려 [르포]'World IT Show'에서 만난 통신 3사 AI의 미래는? 한동훈, 부산서 국민의힘 '메기' 될까 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 강민정 기자메일구독 6·3 지방선거 구독 이진숙 대구시장 불출마 \"대구까지 좌파 넘어가면 안 돼\" \"군소정당으로 불리지만 지역 현안은 우리가 적임자\"…출마 잇따라 한동훈, 부산서 국민의힘 '메기' 될까 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6492372); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"}]},{"id":"member_김진_1776651905224","name":"김진","party":"더불어민주당","district":"부산광역시 수영구","imageUrl":"https://cpmadang.org/sites/default/files/thumbnail.100154466.JPEG","bio":"부산대학교 대학원 심리학과 졸업(문학석사) (전)수영구의회 의장\n(현)수영구의회 의원","electionDate":"2026-06-03T00:00:00.000","term":0,"achievementsList":["부산대학교 대학원 심리학과 졸업(문학석사) (전)수영구의회 의장\n(현)수영구의회 의원"],"actions":[],"policies":[],"pressReports":[{"title":"[뉴스] 더불어민주당 김진 후보, 주요 공약 발표","url":"https://example.com/news/김진_article","source":"모의 뉴스","publishedAt":"2026-04-20T04:14:45.535Z"}],"sourceUrl":"","crawledDate":"2026-04-20T02:25:05.224Z","confidence":0.7,"rawText":"","analysis":"cpmadang.org에서 새로 추가된 후보자입니다.","positiveActivities":[{"keyword":"후원","source":"https://www.yna.co.kr/view/AKR20260411053200051","snippet":"...-ad-1589789760428-0'); }); } 함께 읽기 좋은 콘텐츠 Taboola 후원링크 window['taboola-below-article-widget_08162024..."},{"keyword":"기부","source":"https://www.etoday.co.kr/news/view/2572709","snippet":"...번지나 좋아요0 화나요0 슬퍼요0 추가취재 원해요0 주요 뉴스 SK하이닉스 직원의 '1억 기부'가 놀라운 이유 [이슈크래커] “자퇴하고 싶어요” “휴학해도 되나요?” 고졸·전문대졸..."}],"news":[{"title":"[6·3부산] 민주당, 중구·수영구·금정구·서구 구청장 경선 결과 발표","link":"https://www.msn.com/ko-kr/news/other/6-3%EB%B6%80%EC%82%B0-%EB%AF%BC%EC%A3%BC%EB%8B%B9-%EC%A4%91%EA%B5%AC-%EC%88%98%EC%98%81%EA%B5%AC-%EA%B8%88%EC%A0%95%EA%B5%AC-%EC%84%9C%EA%B5%AC-%EA%B5%AC%EC%B2%AD%EC%9E%A5-%EA%B2%BD%EC%84%A0-%EA%B2%B0%EA%B3%BC-%EB%B0%9C%ED%91%9C/ar-AA208KSu?ocid=BingNewsVerp","source":"Bing"},{"title":"부산 구청장·군수 16곳, 민주·국힘 후보 확정…어떤 색 바람 불까","link":"https://www.hani.co.kr/arti/area/yeongnam/1255049.html","source":"Bing","content":"본문전국영남부산 구청장·군수 16곳, 민주·국힘 후보 확정…어떤 색 바람 불까김광수기자수정 2026-04-20 17:55펼침기사를 읽어드립니다Your browser does not support theaudio element.0:00민주당, 국민의힘광고6월3일 지방선거 부산 구청장·군수 선거에서 맞붙을 더불어민주당·국민의힘 후보가 결정됐다. 국민의힘은 4년 전처럼 16곳 모두 싹쓸이를 노리고, 더불어민주당은 13명을 당선시켰던 2018년 지방선거를 재현하려고 한다.가장 관심을 끄는 곳은 영도·부산진·남·북·해운대·사하구다. 2018년 지방선거 때 당선됐던 민주당 기초단체장 13명 가운데 6명이 4년 만의 복귀를 노린다. 4년 동안의 구정 경험과 높은 인지도를 활용해서 국민의힘 두차례 연속 싹쓸이 저지에 나선다.김철훈 민주당 후보는 영도구청장 선거에서 부산시의원 4선의 안성민 국민의힘 후보와 붙는다. 서은숙 후보는 부산진구청장 선거에서 김영욱 국민의힘 후보와 세번째 붙는다. 2018년엔 서 후보가 10.6%포인트, 2022년엔 김 구청장이 24.5%포인트 이겼다.광고박재범 민주당 후보는 재선을 노리던 오은택 남구청장을 제치고 경선 없이 공천을 받은 김광명 국민의힘 후보와 남구청장을 두고 겨룬다. 정명희 민주당 후보는 공직선거법 위반 혐의로 1심에서 벌금 150만원의 당선무효형을 선고받고 항소한 오태원 국민의힘 후보와 북구청장 선거에서 두번째 붙는다.홍순헌 민주당 후보는 해운대구청장 선거에서 재선에 도전하는 김성수 국민의힘 후보와 두번째 외다리 승부를 겨룬다. 2022년엔 김 후보가 22.7%포인트 이겼다. 김태석 민주당 후보는 5대1의 경선을 뚫고 본선에 진출한 김척수 국민의힘 후보와 사하구청장 선거에서 붙는다.광고광고처음 기초단체장을 노리는 민주당 여성 후보 4명은 강력한 남성 후보와 붙는다. 강희은 민주당 후보는 중구청장 선거에서 3선에 도전하는 최진봉 국민의힘 후보와 붙는다. 김경지 민주당 후보는 지난 보궐선거에서 패배를 안겼던 윤일현 국민의힘 후보와 금정구청장 선거에서 다시 승부를 겨룬다. 김진 민주당 후보는 수영구청장 선거에서 3선에 도전하는 강성태 국민의힘 후보와 우성빈 민주당 후보는 기장군수 선거에서 기장군경찰서장을 지낸 정명시 국민의힘 후보와 붙는다. 수영·서구와 기장군은 민주당 후보가 당선된 적이 없다.김광수 선임기자 kskim@hani.co.kr장동혁 “지방선거 뒤 당당히 평가받겠다”…사퇴 압박 거세져도 ‘버티기’다리 부어서 입원한 40대 숨져…지난해 26명 사망한 이 질병“성과급 수억? 우린 쉴 곳도 없어”…허탈한 반도체 하청 노동자"},{"title":"민주당, 서구 제외 부산 기초단체장 후보 확정","link":"https://www.yna.co.kr/view/AKR20260411053200051","source":"Bing","content":"6·3 지방선거에 출마할 더불어민주당 부산 동래구, 영도구, 사상구 기초자치단체장 후보 경선 결과가 11일 발표됐다.\n더불어민주당 부산시당은 10일부터 이틀간 치러진 경선에서 동래구청장은 탁영일 후보, 영도구청장은 김철훈 후보, 사상구청장은 서태경 후보로 결정됐다고 밝혔다.\n이로써 민주당은 결선투표를 남긴 서구청장 후보를 제외하고 부산지역 구청장 후보를 모두 결정했다. 인공지능이 자동으로 줄인 '세 줄 요약' 기술을 사용합니다.전체 내용을 이해하기 위해서는 기사 본문과 함께 읽어야 합니다. 손형주기자 구독\n구독중 이전\n다음 동래구 탁영일·사상구 서태경·영도구 김철훈 후보 확정 이미지 확대 더불어민주당 부산시당\n[더불어민주당 부산시당 제공] (부산=연합뉴스) 손형주 기자 = 6·3 지방선거에 출마할 더불어민주당 부산 동래구, 영도구, 사상구 기초자치단체장 후보 경선 결과가 11일 발표됐다. 더불어민주당 부산시당은 10일부터 이틀간 치러진 경선에서 동래구청장은 탁영일 후보, 영도구청장은 김철훈 후보, 사상구청장은 서태경 후보로 결정됐다고 밝혔다. 이로써 민주당은 결선투표를 남긴 서구청장 후보를 제외하고 부산지역 구청장 후보를 모두 결정했다. 현재 부산 기초단체장 선거 민주당 후보로는 서은숙(부산진구), 정명희(북구), 김진(수영구), 김경지(금정구), 우성빈(기장군), 강희은(중구), 홍순헌(해운대구), 서태경(사상구), 김태석(사하구), 박재범(남구), 박상준(강서구), 김철훈(영도구), 탁영일(동래구), 김종우(동구), 이정식(연제구)이 확정됐다. 이중 여성 후보는 6명에 이른다. 민주당 부산시당은 서구청장 후보 경선 결선 투표는 17일부터 이틀간 치러지며 경선이 결정된 지역구 광역·기초 의원 후보 경선도 진행될 예정이라고 설명했다. handbrother@yna.co.kr 관련 뉴스 부산 기초단체장 여야 공천 갈등 확산…고소·가처분 등 반발(종합) 부산 기초단체장 경선 과정에서 여야 모두 갈등 확산 與, 부산시장 후보에 전재수 확정…경선서 이재성에 승리 \"민주당인 줄 알았는데…\" 국민의힘, 부산 곳곳 '파란 현수막' 제보는 카카오톡 okjebo <저작권자(c) 연합뉴스,\n무단 전재-재배포, AI 학습 및 활용 금지> 2026/04/11 21:07 송고\n2026년04월11일 21시07분 송고 #민주당 댓글 좋아요 슬퍼요 화나요 후속요청 <button type=\"button\" class=\"btn-type300 style20 arr01\" data-pop-open=\"pop-comment\" data-stat-code=\"article_comment01\"> {{#if IS_COUNT}} <span class=\"bold color21\">{{COUNT_TEXT}}</span> <span class=\"txt01\">개 댓글 전체보기</span> {{else}} <span class=\"txt01\">댓글 작성하기</span> {{/if}} </button> 국내 최대 원스톱 콘텐츠 제공 플랫폼 함께 보면 좋은 콘텐츠 by\n데이블 window['dablewidget_OoRAgyMX'] = function(){ (function(d,a,b,l,e,r) { if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l); e.async=1;e.charset='utf-8'