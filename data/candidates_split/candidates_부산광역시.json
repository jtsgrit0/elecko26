 이영숙, 황운철)이다. 민주당 당헌 제102조(재심)에 따라 심사 결과에 대해 공표 시점으로부터 48시간 이내 재심 신청이 가능하다. 민주당은 앞서 지난 26일 22곳에 대한 광역의원 단수추천을 진행했다. ◎공감언론 뉴시스 [email protected] $('iframe').addClass(\"frameCenter\"); function output(type,ob){ var windoption = \"width=760,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; if ( type == 'print' ) { windoption = \"width=860,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; } if(type == \"email\"){ } if(ob == \"article\"){ if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=NISX20260327_0003567591\"+ '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id=NISX20260327_0003567591&method='+type + '&type='+ob,'', windoption); } }else if(ob == \"photo\"){ var thopho_id = $(\"#hid_foc\").val(); if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=\"+ thopho_id + '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id='+ thopho_id +'&method='+type+'&type='+ob,'',windoption); } } } 말레이시아서 납치된 40대 한국인 남성 구조…납치범 3명도 한국인 이경실, '고가 달걀 논란' 해명…\"아들 무혐의·수익 0원\" 소유, '월세 1300만원' 한남동 집 공개…\"연예인도 가려 받아\" 암 수술 끝나니까 '이혼 통보'…알고 보니 3년 동안 외도 파키스탄 언론 \"美·이란 협상팀 이슬라마바드 방문 예정\" 이 대통령, 인도·베트남과 공급망 협력·시장 확대…'글로벌 사우스' 공략 속도 경찰, '이재명 조폭연루설' 주장 조직폭력배 무고 혐의 수사 말레이시아서 납치된 40대 한국인 남성 구조…납치범 3명도 한국인 이 대통령, 서울공항 도착…인도·베트남 5박6일 순방 마무리 이 대통령, 서울공항 도착…인도·베트남 5박6일 순방 종료 정청래-유시민, 화해 후 첫 만남 민주 충북지사 후보군 \"원팀\"…신용한·노영민·송기섭·한범덕 치맥회동 이진숙, 내일 기자회견 예고…대구시장 출마 여부 입장 밝히나 한미, '정동영 구성 발언' 논란속 워싱턴서 차관급 협의 파키스탄 언론 \"美·이란 협상팀 이슬라마바드 방문 예정\" 美국방 \"이란 봉쇄 더 강화…핵무기 포기않으면 경제 붕괴\" \"트럼프, 美이란 평화협상 위해 윗코프·쿠슈너 파키스탄 파견\" 트럼프, '미국간 항구 물자이동 미국선박 제한' 유예 90일 연장 헤그세스, \"13일 미군 해협 봉쇄 후 34척 이란쪽으로 되돌아가\" 뉴욕증시, 중동 전쟁 불확실성에 혼조 출발…나스닥 0.64%↑ 美법무부, 연준 파월 수사 종결…후임인 워시 인준 가시권 이 대통령, 인도·베트남과 공급망 협력·시장 확대…'글로벌 사우스' 공략 속도 뉴욕증시, 중동 전쟁 불확실성에 혼조 출발…나스닥 0.64%↑ 美법무부, 연준 파월 수사 종결…후임인 워시 인준 가시권 홍콩 증시, 반도체주 강세로 사흘 만에 반등 마감…H주 0.49%↑ 美검찰, 연준 파월 수사 종결…후임인 워시 인준 가시권 대만 증시, 美 반도체주 강세에 사상 