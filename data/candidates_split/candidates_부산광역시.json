겠구나\" 눈물 문근영, 빙판길 사고 후 희소병 진단…\"손가락 신경 괴사 위기도\" 류진, BTS 진·뷔 닮은 두 아들 공개 \"연예계 관심 있어\" 엄지윤 \"김원훈과 키스신, 비비크림 맛 싫었다\" 배우 이남희 별세 향년 64…연극·영화·드라마 오가 월드컵 D-50 ETF 전성시대 소상공인 단결권 미토스 쇼크 삼성전자 성과급 딜레마"},{"title":"부산진구청장 가상대결…서은숙 42.3% vs 김영욱 32.2%","link":"https://www.nocutnews.co.kr/news/6485156","source":"Bing","content":"부산CBS 6·3 지방선거 여론조사부산진구청장 후보 적합도, 민주 서은숙·국힘 김영욱 1위부산진구청장 전·현직 가상대결…서은숙, 김영욱에 오차범위 밖 우세정당 지지도 민주 43.0%·국힘 33.3%…부산진구 민심 민주 우세, 이상호-김영욱 접전국힘 당내 적합도 김영욱·김승주 경쟁…갑 정성국·을 이헌승 지역 구도 변수 서은숙 더불어민주당 전 부산진구청장(왼쪽)과 김영욱 국민의힘 현 부산진구청장. 각 정당 측 제공부산진구를 대상으로 실시한 부산CBS 여론조사 결과 더불어민주당 서은숙 전 부산진구청장과 국민의힘 김영욱 부산진구청장의 가상대결에서 42.3% 대 32.2%로 나타나 서 전 구청장이 오차범위 밖에서 앞서는 것으로 조사됐다. 정당 지지도 역시 더불어민주당이 국민의힘을 오차범위 밖에서 앞서 부산진구 민심의 흐름이 수치로 확인됐다.이번 조사에서는 민주당과 국민의힘 모두 당내 구청장 후보 적합도에서 각각 전직 구청장과 현직 구청장이 가장 높은 지지율을 기록했다. 전·현직 구청장이라는 이력으로 지역 내 인지도가 높은 점이 이번 조사에서도 영향을 미친 것으로 분석된다.부산진구청장 전·현직 가상대결…서은숙 오차범위 밖 우세부산진구청장 가상대결. KSOI 제공 부산CBS가 여론조사 전문기관 한국사회여론연구소(KSOI)에 의뢰해 3월 13~14일 이틀간 부산진구 만 18세 이상 유권자 501명을 대상으로 실시한 조사에서 부산진구청장 가상대결은 서은숙 전 부산진구청장 42.3%, 김영욱 부산진구청장 32.2%로 집계됐다.그 외 인물은 7.0%, 없음 9.3%, 잘 모름 9.1%였다.같은 조사에서 민주당 이상호 전 대통령비서실 경제수석실 행정관과 김영욱 구청장의 가상대결에서는 이상호 34.6%, 김영욱 32.0%로 오차범위 안 접전으로 나타났다.그 외 인물은 10.5%, 없음 11.6%, 잘 모름 11.2%였다.민주당 내부 후보 적합도 조사에서는 서은숙 전 구청장이 33.8%로 가장 높았고, 이상호 전 행정관이 19.3%로 뒤를 이었다.그 외 인물 13.9%, 없음 18.9%, 잘 모름 14.0%로 집계됐다.부산진구 정당 지지도 민주당 43.0%·국민의힘 33.3%부산진구 정당 지지도. KSOI 제공부산진구 정당 지지도는 더불어민주당 43.0%, 국민의힘 33.3%로 집계됐다.개혁신당 2.5%, 조국혁신당 2.3%, 진보당 1.9%, 그 외 정당 1.7%였고, 지지 정당 없음 13.7%, 잘 모름 1.6%로 조사됐다.민주당이 국민의힘을 오차범위 밖에서 앞서면서 부산진구 유권자들의 정당 선호 역시 민주당 쪽으로 기울어 있는 것으로 나타났다.전현직 구청장을 상대로 당내 경쟁에 나선 더불어민주당 이상호 전 행정관(왼쪽)과 김승주 국민의힘 전 부산진구 약사회장. 각 정당 제공국힘 당내 적합도 김영욱·김승주 경쟁…정성국(갑)·이헌승(을) 부산진구 국회의원 지역 구도 변수국민의힘 부산진구청장 후보 적합도에서는 김영욱 부산진구청장이 27.2%로 가장 높았고, 김승주 전 부산진구약사회장이 11.8%로 뒤를 이었다.그 외 인물은 14.3%, 없음 31.0%, 잘 모름 15.8%로 집계됐다.부산진구는 국회의원 선거구 기준으로 갑과 을로 나뉘는 지역이다.국민의힘 정성국(부산진구갑, 초선, 왼쪽) 국회의원과 이헌승(부산진구을, 4선, 오른쪽) 국회의원. 국민의힘 제공갑은 국민의힘 초선 정성국 의원 지역구이고, 을은 국민의힘 4선 이헌승 의원 지역구다. 김승주 전 약사회장은 갑 지역 인물로, 김영욱 구청장은 을 지역 인물로 분류된다.지역 정치권에서는 이러한 갑·을 구도가 이번 구청장 선거에서도 변수로 작용할 가능성이 있다는 분석이 나온다. 현직 구청장인 김영욱 구청장은 재임 기간 쌓은 인지도를 바탕으로 비교적 높은 지지율을 기록한 것으로 해석된다.반면 김승주 전 약사회장은 출마 선언을 한 지 얼마 되지 않아 상대적으로 인지도 차이가 반영된 결과로 풀이된다.특히 이번 여론조사에서 '없음'과 '잘 모름' 응답이 절반 가까이 차지해 국민의힘 후보군에 대한 유권자 판단이 아직 유동적인 상황이라는 해석도 나온다.국민의힘 부산진구청장 후보 적합도. KSOI 제공향후 후보 구도와 선거 국면에 따라 지지율이 달라질 가능성도 있다는 분석이다.이번 조사는 통신사 제공 휴대전화 가상번호를 활용한 무선 ARS 방식으로 진행됐으며 표본오차는 95% 신뢰수준에서 ±4.4%p다. 응답률은 5.7%다. 기타 자세한 사항은 중앙선거여론조사심의위원회 홈페이지를 참고하면 된다. 지금 뜨는 뉴스 [단독]\"故김수미 건강 악화로 '친정엄마' 중단 검토도\" vs \"그런 적 없다\" \"우리 애 다쳤으니 고소\"…사라지는 수학여행･운동장, 당신의 생각은?[노컷투표] 정유라 \"아들 못만나\"…교도소 측 \"스마트접견까지 허용\"[오목조목] 이란 '선박 줄나포'에 겨우 1척 통과…호르무즈 다시 막혔다 주호영 대구시장 불출마…남은 변수는 이진숙 무소속 출마 주호영 결국 불출마 선언…\"선거 더 꼬이게 할 수 없어\" 李대통령 \"베트남과 전략적협력으로 '홍강의 기적' 만들어야\"[영상] '평생교육법' 등 교육부 소관 11개 법안, 국회 통과 할머니가 매니저였던 10년…문근영이 전한 특별한 동행 현대차 1분기 최대 매출에도 영업익 30.8% 감소…관세·전쟁 '타격' ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 강민정 기자메일구독 6·3 지방선거 구독 '강원교육감 선거 D-41' 신경호·유대균 '보수 단일화 주목' 김광수 교육감 예비후보 등록…제주교육감 선거 3파전 \"무능·무책임 4년\" vs \"리틀 윤석열\"…이장우·허태정, 벌써부터 전면전 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6485156); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"민주당, 광역의회 중대선거구 도입 추진…진보 5당과 공동선언","link":"https://www.asiae.co.kr/article/2026040216395724904","source":"Bing"}]},{"id":"member_이종철","name":"이종철","party":"국민의힘","district":"부산광역시 사하구","imageUrl":"https://cpmadang.org/sites/default/files/thumbnail.100154666.JPG","bio":"부산대학교 상과대학 무역학과 졸업(경제학사) (전) 부산광역시 민선6기 출범준비위원회 정책실장\n(전) 국회사무처 (의원실) 근무","electionDate":"2026-06-03T00:00:00.000","term":1,"achievementsList":["부산대학교 상과대학 무역학과 졸업(경제학사) (전) 부산광역시 민선6기 출범준비위원회 정책실장\n(전) 국회사무처 (의원실) 근무"],"actions":[],"policies":[],"pressReports":[{"title":"[뉴스] 국민의힘 이종철 후보, 주요 공약 발표","url":"https://example.com/news/이종철_article","source":"모의 뉴스","publishedAt":"2026-04-20T02:28:06.221Z"}],"sourceUrl":"https://cpmadang.org/taxonomy/term/83820","crawledDate":"2026-04-19T21:59:43.459Z","confidence":0.9,"rawText":"2026년 9대 전국지방동시선거\n  의령군함안군합천군\n\n    \n    \n        \n        \n\n\n      \n        국민의힘\n        \n                                        \n                \n                \n          이종철(李鍾哲)\n          \n     ","analysis":"이종철·폴 김 팰팍 시의원 선대위 발족","news":[{"title":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표","link":"https://www.lawissue.co.kr/view.php?ud=2026042118353662769a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표 기사입력:2026-04-21 18:37:29 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 21일 제13차 회의를 갖고 광역⋅기초의원 경선 결과를 발표하고, 광역⋅기초의원 후보자들을 의결했다고 밝혔다. 이번 경선은 4.19.~20. 양일간 실시된 선거인단 투표(모바일 전자투표 및 ARS 투표) 결과를 100%로 반영했다. 최종 결과는 선거인단 모바일 전자투표 및 ARS 투표 결과를 선거인단 유효투표수 기준으로 합산, 이를 100% 기준 비율로 변환하고 후보별 가⋅감산점을 적용해 확정했다. ◇광역의원 후보자 의결(3곳) ▲동래구 제2선거구 : 송우현(현 부산광역시의회 의원) ▲사하구 제2선거구 : 최종원(전 국회 5급 선임비서관) ▲금정구 제1선거구 : 하은미(현 금정구의회 3선 의원) ◇기초의원 후보자 의결(4곳)\n▲해운대구 마 선거구=가 : 박기훈(현 해운대구의회 의원), 나 : 김민성(현 국민의힘 해운대구을 청년위원장)\n▲ 해운대구 바 선거구=가 : 장성철(현 해운대구의회 의장), 나 : 이국두(현 국민의힘 해운대구 재송2동협의회장)\n▲ 사하구 가 선거구(기호 나)= 윤보수(현 사하구의회 의원)\n▲사하구 나 선거구(기호 나