세·전쟁 '타격' '평생교육법' 등 교육부 소관 11개 법안, 국회 통과 서울 아파트 매매가격 상승폭 확대, 강남3구 중 송파구 하락에서 반전 ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 정혜린 기자메일구독 6·3 지방선거 구독 충북 현역 단체장 전원 등판 완료…거센 도전 속 선거전 점화 선관위 \"이진숙 무소속 출마, 탈당 시한 5월 13일…투표함 24시간 공개\" 정근식, 서울교육감 진보 단일후보 확정…1차 투표서 과반득표 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6506308); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"국민의힘, 부산 공천 반란···수영·해운대 후보들 “밀실 사천 강력 규탄”","link":"https://www.msn.com/ko-kr/news/other/%EA%B5%AD%EB%AF%BC%EC%9D%98%ED%9E%98-%EB%B6%80%EC%82%B0-%EA%B3%B5%EC%B2%9C-%EB%B0%98%EB%9E%80-%EC%88%98%EC%98%81-%ED%95%B4%EC%9A%B4%EB%8C%80-%ED%9B%84%EB%B3%B4%EB%93%A4-%EB%B0%80%EC%8B%A4-%EC%82%AC%EC%B2%9C-%EA%B0%95%EB%A0%A5-%EA%B7%9C%ED%83%84/ar-AA21ygGA?ocid=BingNewsVerp","source":"Bing"},{"title":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표","link":"https://www.lawissue.co.kr/view.php?ud=2026042118353662769a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표 기사입력:2026-04-21 18:37:29 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 21일 제13차 회의를 갖고 광역⋅기초의원 경선 결과를 발표하고, 광역⋅기초의원 후보자들을 의결했다고 밝혔다. 이번 경선은 4.19.~20. 양일간 실시된 선거인단 투표(모바일 전자투표 및 ARS 투표) 결과를 100%로 반영했다. 최종 결과는 선거인단 모바일 전자투표 및 ARS 투표 결과를 선거인단 유효투표수 기준으로 합산, 이를 100% 기준 비율로 변환하고 후보별 가⋅감산점을 적용해 확정했다. ◇광역의원 후보자 의결(3곳) ▲동래구 제2선거구 : 송우현(현 부산광역시의회 의원) ▲사하구 제2선거구 : 최종원(전 국회 5급 선임비서관) ▲금정구 제1선거구 : 하은미(현 금정구의회 3선 의원) ◇기초의원 후보자 의결(4곳)\n▲해운대구 마 선거구=가 : 박기훈(현 해운대구의회 의원), 나 : 김민성(현 국민의힘 해운대구을 청년위원장)\n▲ 해운대구 바 선거구=가 : 장성철(현 해운대구의회 의장), 나 : 이국두(현 국민의힘 해운대구 재송2동협의회장)\n▲ 사하구 가 선거구(기호 나)= 윤보수(현 사하구의회 의원)\n▲사하구 나 선거구(기호 나) =정삼균(현 사하구의회 의원) ※ 사하구 가⋅나 선거구 기호 가 후보자는 제9차 공천관리위원회(4.9.) 의결전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push({}); (adsbygoogle = window.adsbygoogle || []).push({}); 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 주요뉴스 민주당, 지선 '착!붙 10·11·12호' 공약... '실수로 해약한 예적금 복구·... 정치 장동혁, 자신 향한 내부 비판에 \"해당엔 행위 강력 조치\" 경고성 메시지 정치 대법원, 개인정보보호법 양벌규정 적용 공공기관의 개인 유죄 원심 파기환송 법조 李대통령 \"韓·베트남 관계 참으로 특별…원전·공급망 협력\" 정치 송언석, 일각 임기단축 요구 일축... \"선거 승리에 매진\" 정치 대법원, 보험설계사를 개인정보처리자로 보고 유죄 원심 파기환송 법조 .t_box1>ul>li {width:243px;} .today_box>.t_box1>ul>li>a>.thumb>img {width:243px; height:144px;} 핫포커스 김정문알로에 자회사 케이제이엠바이오, 치료제 없는 난청 관련 건기식 원료... 현대약품, 전립선비대에 의한 배뇨장애 해결 ‘유린타민캡슐’ 선보여 CJ제일제당, ‘고메치킨’ 신제품 2종 선보여 KFC, 프리미엄 닭다리통살로 재탄생한 ‘블랙라벨더블다운맥스’ 선보여 세븐일레븐, 2021 추석선물세트 판매 시작 CU, 추석 선물로 기존 편의점에서 판매하지 않았던 상품들 대거 선보여 $(document).ready(function(){ iFrameResize({ log: false, checkOrigin: false }, '#clsnhiCommentIFrameID');\n}); /*\n$(document).ready(function(){ $('#clsnhiCommentIFrameID').iFrameSizer({ log : true, // For development autoResize : true, // Trigering resize on events in iFrame contentWindowBodyMargin: 15, // Set the default browser body margin style (in px) doHeight : true, // Calculates dynamic height doWidth : false, // Calculates dynamic width enablePublicMethods : true, // Enable methods within iframe hosted pag