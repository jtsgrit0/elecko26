: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오톡(으)로 기사보내기 네이버밴드(으)로 기사보내기 네이버블로그(으)로 기사보내기 네이버라인(으)로 기사보내기 핀터레스트(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 “정관선 속도전·공공셔틀 도입…동부산 30분 생활권 구축”\n“첨단산업·의료·청년정책 묶어 체류형 도시로 전환” 우성빈 더불어민주당 기장군수 후보가 16일 부산시의회에서 ‘10대 핵심 공약’을 발표하며 기장 미래 비전을 밝히고 있다.(왼쪽 세 번째 최택용 기장군지역위원장) / 사진=우성빈 캠프 제공 #AD175263175630.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD175263175630.ad-template .col { text-align:center; }\n#AD175263175630.ad-template .col .ad-view { position:relative; } (더쎈뉴스 / The CEN News 이승렬 기자) 우성빈 더불어민주당 기장군수 후보가 16일 이날 앞서 오후 2시 부산시의회에서 기자회견으로 밝힌 내용을 토대로 자신의 사회관계망서비스(SNS)를 통해 교통·산업·복지 등을 아우르는 ‘10대 핵심 공약’을 발표하며 본격적인 정책 경쟁에 불을 붙였다. 우 후보는 “기장은 개별 자원은 충분하지만 서로 연결되지 못해 시너지를 내지 못하고 있다”며 “자원을 전략적으로 묶어 효과를 극대화하는 군수가 되겠다”고 밝혔다. 핵심은 교통이다. 그는 “정관선은 이미 방향이 잡힌 만큼 착공까지 행정 절차를 최대한 앞당기고 환승체계와 버스 노선을 동시에 설계해야 한다”며 “동해선 배차 간격 단축과 함께 ‘기장일광선’ 유치를 추진하겠다”고 말했다. 철도 개통 전 공백을 메우기 위해 신도시·읍면·산단·역세권을 연결하는 ‘기장형 공공셔틀버스’ 도입도 공약했다. 산업 분야에서는 기장을 동부산 첨단산업 거점으로 키우겠다는 구상을 내놨다. 방사선의·과학, 전력반도체, 배터리, 바이오헬스, 원전 해체 산업을 묶고 AI 데이터센터 등 신산업 유치를 통해 ‘기회발전특구’ 효과를 극대화하겠다는 전략이다. 의료 인프라 확충도 주요 공약으로 제시됐다. 우 후보는 “동부산권은 응급·중증 의료 접근성이 취약하다”며 “거점병원 유치와 함께 응급이송 체계, 야간진료 협력망을 구축해 생활 의료 불안을 줄이겠다”고 밝혔다. 청년 정책은 일자리·주거·생활을 묶은 ‘정주 패키지’로 제시됐다. 산단 취업 연계, 교통비 지원, 주거비 부담 완화와 함께 창업 지원과 문화 인프라 확충을 병행해 “떠나는 기장이 아닌 돌아오는 기장을 만들겠다”는 구상이다. #AD175343047579.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD175343047579.ad-template .col { text-align:center; }\n#AD175343047579.ad-template .col .ad-view { position:relative; } (adsbygoogle = window.adsbygoogle || []).push({}); 교육 분야에서는 교육행복타운을 중심으로 AI·코딩·메이커 교육, 돌봄·진로 프로그램을 결합하고, 부산대 미래융합캠퍼스 유치도 추진하겠다고 밝혔다. 관광 전략은 ‘체류형 전환’에 방점이 찍혔다. 오시리아 관광단지와 해안권, 전통시장, 어촌 체험을 연계해 숙박과 야간 콘텐츠를 강화하고 지역 상권 소비를 늘리겠다는 계획이다. 이와 함께 침수 대응과 생활SOC 확충, 문화·콘텐츠 기반 지역경제 활성화, ‘15분 복지’ 구축 등 생활 밀착형 공약도 포함됐다. 우 후보는 “기장은 부산의 끝이 아니라 미래가 시작되는 곳”이라며 “교통은 앞당기고 산업은 키우고 삶의 질은 높이겠다”고 밝혔다. (더쎈뉴스 / The CEN News) 이승렬 기자 ottnews@kakao.com #AD175263179225.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD175263179225.ad-template .col { text-align:center; }\n#AD175263179225.ad-template .col .ad-view { position:relative; } #AD175343049890.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD175343049890.ad-template .col { text-align:center; }\n#AD175343049890.ad-template .col .ad-view { position:relative; } (adsbygoogle = window.adsbygoogle || []).push({}); 추천 뉴스 1 [단독] 악성 허위 고발에 경찰부터 복지부까지 행정력 낭비…3년 간 경쟁 병원 흔들기 결국 1,500만 원 배상 판결 (더쎈뉴스 / The CEN News 주진노 기자) 경쟁 병원을 무너뜨리기 위해 수사기관과 행정기관을 제집 드나들듯 하며 3년 동안 집요하게 허위 고발을 일삼아 온 김모 씨(피고)에게 법원이 철퇴를 내렸다.서울서부지방법원(판사 최은주)은 지난 10일, H병원 이00 대표원장이 김 씨를 상대로 제기한 손해배상 청구 소송에서 “피고는 원고에게 1,500만 원을 배상하라”고 판결했다.이번 판결문에는 김 씨가 H병원을 괴롭히기 위해 동원한 치밀하고도 악랄한 수법들이 고스란히 담겼다. 단순한 공익 제보자가 아닌, 특정 목적을 가진 ‘전문 고 2 ‘현역가왕3’ 설 연휴 맞아 모바일 투표 1,063만 돌파…NS홈쇼핑 “독점 영상·방청권 이벤트까지” (더쎈뉴스 / The CEN News 주진노 기자) NS홈쇼핑이 설 연휴 기간 동안 인기 음악 예능 프로그램 ‘현역가왕3’의 공식 모바일 투표와 방송 비하인드 스토리 영상을 단독으로 제공한다고 13일 밝혔다.NS홈쇼핑은 ‘현역가왕3’의 공식 투표 파트너로서 앱을 통해 투표와 콘텐츠 소비가 모두 이뤄지도록 시스템을 마련했다. 특히 설 당일인 17일에는 준결승 1라운드인 ‘국민트롯 대첩’이 방송될 예정이며, 명절 연휴 중 가족들과 본방송을 시청한 뒤 앱에서 모바일 투표와 독점 영상을 이어서 감상할 수 있다.앱 접속자 증가도 눈에 띈다. 3 ‘극장서 방탄소년단 월드투어’…고양·도쿄 콘서트, 75개국 동시 생중계 (더쎈뉴스 / The CEN News 주진노 기자) 방탄소년단(BTS)의 월드투어 무대가 오는 4월 극장 스크린을 통해 전 세계 음악팬들과 만난다.빅히트 뮤직은 4월 11일 고양과 18일 도쿄에서 펼쳐지는 ‘BTS WORLD TOUR ‘ARIRANG’’ 공연 실황이 라이브 뷰잉 방식으로 생중계된다고 13일 밝혔다.라이브 뷰잉은 여러 관객이 극장에 모여 콘서트를 실제 공연처럼 보는 중계 서비스로, 이번 이벤트는 75개 국가 및 지역의 3,500여 극장에서 상영된다. 일부 국가는 시차로 인해 딜레이 중계될 예정이며 상영 국가와 관의 수 4 [금값 시세] 순금 103만원대 유지... 금 보합 속 은·백금 동반 하락 (더쎈뉴스 / The CEN News 한나래 기자) 2026년 2월 11일 한국금거래소 시세에 따르면 순금(24K·3.75g)의 살 때 가격은 전일 대비 0.1%(1,000원) 하락한 103만5,000원을 기록했다. 팔 때 가격은 86만 원으로 전일과 동일한 수준을 유지하며 보합 흐름을 나타냈다.금 제품 시세는 변동 없이 유지됐다. 18K 금 시세(제품 시세 적용 기준)는 63만2,100원으로 전일과 같은 가격을 기록했으며, 14K 금 시세 역시 49만200원으로 가격 변동 없이 보합세를 보였다.백금 시세는 하락 흐름을 나타냈다. 5 ‘나는솔로’ 촬영 후 데이트 제안?...30기 본격적인 ‘로맨스 온도’ 상승 (더쎈뉴스 / The CEN News 권진아 기자) ‘나는 SOLO’ 30기 솔로남녀가 첫 데이트 선택에서 예상치 못한 반전 결과와 마주하며 ‘솔로나라’를 아수라장으로 만든다.11일 방송되는 ENA, SBS Plus ‘나는 SOLO’에서는 자기소개 타임 이후 본격적인 로맨스 탐색전에 돌입한 30기 멤버들의 모습이 그려진다.서로를 파악한 솔로남녀들은 본격적으로 대화를 나누며 로맨스 온도를 높이는 가운데, 첫 데이트 선택이 불러올 파장에 이목이 쏠리고 있다.이날 방송에서는 찰떡궁합 ‘개그 티키타카’를 선보이는 커플이 등장해 눈길을 끈다 키워드 #우성빈\n#기장군수\n#공약발표 이승렬 기자 ottnews@kakao.com 기자페이지 ㆍ 부산권 대학, 베트남서 유학생 유치전…‘정주형 인력 확보’ 실험 본격화\nㆍ ‘미라클호’ 1년, 5만 명 탑승…부산 크루즈, "},{"title":"우성빈 \"말보다 실행하는 기장군수될 것\"…10대 정책공약 발표","link":"https://www.newspim.com/news/view/20260416000960","source":"Bing","content":"우성빈 \"말보다 실행하는 기장군수될 것\"…10대 정책공약 발표 기사입력 : 2026년04월16일 14:45 최종수정 : 2026년04월16일 14:45 카카오톡 페이스북 트위터 밴드 가 가 프린트 ※ 본문 글자 크기 조정 가더 작게 가작게 가보통 가크게 가더 크게 닫기 ※ 번역할 언어 선택 -- 선택 -- 닫기 AI 핵심 요약 beta 분석 중... 우성빈 예비후보가 16일 부산시의회에서 10대 정책공약을 발표했다. 기장일관선 유치와 무료 셔틀버스 등 교통혁명을 공약으로 제시했다. 청년지원과 체류형 관광 등으로 군민 삶을 바꾸겠다고 다짐했다. !AI가 자동 생성한 요약으로 정확하지 않을 수 있어요. const totalItems = document.querySelectorAll('.summary-item').length; const aiCard = document.getElementById('aiSummary').querySelector('.box'); const statusLabel = document.getElementById('statusLabel'); let current = 0; function reveal() { if (current < totalItems) { const el = document.getElementById(`ai-summary-item-${current}`); el.classList.add('visible'); current++; setTimeout(reveal, 400); } else { aiCard.classList.remove('scanning'); statusLabel.style.display = \"none\"; setTimeout(() => { aiCard.classList.add('shimmer-on'); }, 120); } } window.onload = () => { setTimeout(reveal, 500); }; 교통 혁신 및 산업 유치 계획 제시 [부산=뉴스핌] 남동현 기자 = 부산 기장군수에 출마를 선언한 더불어민주당 우성빈 예비후보가 10대 정책공약을 발표했다.\n우성빈 예비후보는 16일 오후 2시 부산시의회 3층 브리핑룸에서 기자회견을 열고 \"말보다 실행으로 증명하는 군수, 편가르기보다 문제를 해결하는 군수, 보여주기보다 실제 군민의 삶을 바꾸는 군수가 되겠다\"고 밝혔다.\n그는 \"기장군은 개별 자원들이 제대로 발전하지 못하고, 서로 전략적으로 융합돼 시너지 효과를 내지 못하고 있다\"며 \"저는 바로 기장군이 가진 자원의 효과를 전략적으로 극대화시키는 군수가 되겠다\"고 강조했다.\n[부산=뉴스핌] 남동현 기자 = 더불어민주당 우성빈 기장군수 예비후보(가운데)가 16일 오후 2시 부산시의회 3층 브리핑룸에서 기자회견을 열어 정책공약을 발표하고 있다. 2026.04.16\n우 예비후보는 이날 ▲기장일관선 유치 등 동부산 30분 교통혁명 ▲기장형 무료 공공셔틀버스(신도시·읍면·산단·철도역)와 기장동행버스(기장읍·장안읍·철마) 도입 ▲AI데이터센터 등 신산업 유치 등 미래산업 동부거점 조성을 정책공약으로 제시했다.\n또 ▲청년창업 전담 지원 조직 설치 등 청년이 떠나지 않는 기장 ▲아이 키우기 좋은 교육도시 기장 ▲당일치기 관광 아닌 체류형 관광 조성 ▲재난에 강한 생활안전도시 ▲문화·콘텐츠·골목상권이 연결되는 기장형 문화경제 ▲15분 복지 기장 등을 제시했다.\n우 예비후보는 \"교통은 앞당기고, 산업은 키우고, 삶은 더 따뜻하게 만들겠다\"면서 \"청년이 돌아오고 어르신이 안심하고, 아이들이 행복하게 자라는 기장. 저 우성빈이 반드시 해내겠다. 기장군의 대표가 돼 우리 기장을 부산 대표 도시로 만들겠다\"고 다짐했다.\nndh4000@newspim.com [관련키워드] 더불어민주당우성빈부산 기장군기초단체장전국동시지방선거 <저작권자(c) 글로벌리더의 지름길 종합뉴스통신사 뉴스핌(Newspim), 무단 전재-재배포 금지> 디지털뉴스콘텐츠 이용규칙 보기 뒤로가기 맨위로 GAM - 해외주식 투자 도우미 [AI의 종목 이야기] 룰루레몬 주가 13% 급락, '나이키 출신' 새 CEO 불신 나이키 1400명 감원…대부분 기술직 [홍콩 대장주] 메이퇀 ③ 신성장 동력의 '폭발적 성장' [홍콩 대장주] 메이퇀② 실적은 고속 상승, 밸류는 역대 저점 (function(d, a, b, l, e, r) { if (d[b] && d[b].q) return; d[b] = function() { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; r = a.getElementsByTagName(l)[0]; r.parentNode.insertBefore(e, r); })(window, document, 'dable', 'script'); dable('setService', 'newspim.com'); dable('sendLogOnce'); dable('renderWidget', 'dablewidget_xlz2K3vl'); [뉴스핌 베스트 기사] 사진 금연구역 내 모든 담배 사용 불가 [세종=뉴스핌] 신도경 기자 = 24일부터 '연초의 잎'으로 만든 담배뿐 아니라 연초나 니코틴이 들어간 모든 제품이 담배로 규정돼 금연구역에서 모든 담배제품을 사용할 수 없다.\n이날 보건복지부에 따르면, '담배사업법' 개정안 시행으로 '연초'나 '니코틴'뿐 아니라 '연초의 잎'에서 유래하지 않은 제품 역시 연초의 잎 소재 담배와 동일하게 담배에 포함된다. 기사 이해를 돕기 위해 생성형 AI로 제작한 이미지 [일러스트=제미나이] 담배의 정의가 확대됨에 따라 담배 제조업자와 수입판매업자는 담뱃갑 포장지와 담배에 관한 광고에 경고 그림이나 경고문구 내용을 표기해야 한다. 또한 담배에 대한 광고는 잡지 등 정기간행물에 품종군별로 연 10회 이내·1회당 2쪽 이내로 게재해야 한다. 행사 후원, 소매점 내부, 국제항공기·국제여객선 내에만 제한적으로 허용된다.\n여성과 청소년을 대상으로 하는 광고나 행사 후원은 금지된다. 광고에는 담배 품명, 종류, 특징을 알리는 것 외의 내용이나 흡연을 권장·유도하거나 여성이나 청소년을 묘사하는 내용 등을 모두 포함할 수 없다. 만일 담배에 가향 물질이 포함되는 경우 이를 표시하는 문구·그림·사진을 제품의 포장이나 광고에 사용할 수 없다.\n건강경고 또는 광고에 대한 규제를 위반할 경우는 1년 이하의 징역 또는 1000만원 이하의 벌금이 부과될 수 있다. 가향물질 표시 금지에 대한 규제를 위반할 경우는 500만원 이하의 과태료가 부과된다. 기사 이해를 돕기 위해 생성형 AI로 제작한 이미지 [일러스트=제미나이] 담배 자동판매기는 '담배사업법'에 따라 설치장소나 거리기준 등 요건을 갖춰 소매인 지정을 받은 자만 설치할 수 있다. 담배 자동판매기는 18세 미만 출입금지 장소, 소매점 내부, 19세 미만인 자가 담배 자동판매기를 이용할 수 없는 흡연실에만 설치할 수 있다. 성인인증장치도 부착해야 한다.\n담배에 대한 광고물은 소매점 외부에 광고내용이 보이게 전시 또는 부착할 수 없다. 담배 자동판매기 설치 기준을 위반하면 500만원, 성인인증장치 미부착은 300만원의 과태료가 부과된다.\n흡연자는 금연구역에서 모든 담배제품을 사용할 수 없다. 금연구역에서 담배제품을 사용할 경우 10만원 이하의 과태료가 부과될 수 있다.\n한편, 복지부는 당초 지방자치단체의 담배 규제 사항을 점검·단속하려고 했으나 현장의 혼란을 막기 위해 오는 6월 23일까지 계도기간을 두기로 했다. 담배자판기 설치나 성인인증장치 부착 기준 준수 등을 집중적으로 안내한다.\n복지부 관계자는 \"재고가 소진될 때까지 다소 시간이 걸려 생산 제품에 새로 표시하는 것이 어려운 점을 고려했다\"고 설명했다. sdk1991@newspim.com 2026-04-24 09:40 사진 SK하이닉스 '과열 vs 추가 랠리' 갈림길 [서울=뉴스핌] 이나영 기자= SK하이닉스가 사상 최대 실적을 발표한 가운데, 시장의 관심이 실적 자체를 넘어 향후 주가 흐름으로 빠르게 이동하고 있다. 이달 들어 약 37%에 육박하는 상승세를 이어온 만큼, 이번 실적이 추가 상승으로 이어질지 여부가 핵심 변수로 떠오른 모습이다.\n24일 한국거래소에 따르면 SK하이닉스는 전날 장중 126만7000원까지 오르며 신고가를 경신한 뒤, 0.16% 오른 122만5000원에 거래를 마쳤다. 이달 1일 89만3000원이던 주가는 약 37.1% 상승하며 단기간 가파른 오름세를 나타냈다.\n이번 실적은 매출과 수익성 측면에서 모두 시장 기대를 뒷받침하는 수준으로 평가된다. SK하이닉스는 1분기 매출 52조5763억원, 영업이익 37조6103억원, 순이익 40조3459억원을 기록했다. 분기 매출이 50조원을 넘어선 것은 처음이며, 영업이익률은 72%로 창사 이래 최고치를 경신했다. 전년 동기 대비 영업이익은 405% 증가하며 실적 성장세가 뚜렷하게 확인됐다.\n다만 이날 주가는 하락 출발한 뒤 장중 등락을 거듭하다가 강보합으로 마감하며, 실적 발표 직후 상승 흐름이 곧바로 이어지지는 않는 모습을 보였다. 이는 시장의 기대가 이미 실적 수치 이상으로 선반영돼 있었던 영향으로 분석된다. 실제로 SK하이닉스 주가는 연초 60만원대 중반에서 출발해 90만원대를 거쳐 120만원대까지 올라서는 등 올해 들어 뚜렷한 상승 추세를 이어왔다. 실적 발표 전 삼성증권은 영업이익 40조2090억원을, KB증권은 40조830억원을 예상하는 등 주요 증권사들은 40조원대 이익을 전망해왔다. 키움증권과 흥국증권 역시 유사한 수준의 추정치를 제시했다. 실제 실적은 시장 예상 범위 내에서 확인됐지만, 주가 측면에서는 이미 반영된 기대를 점검하는 흐름이 나타난 것으로 해석된다.\n김지현 다올투자증권 연구원은 \"4월 이후 코스피가 약 27% 상승하는 과정에서 협상 기대감과 반도체 실적 모멘텀이 상당 부분 선반영됐다\"고 분석했다. 이를 단순 조정으로 보기보다 상승 이후 흐름을 점검하는 과정으로 해석하는 시각도 적지 않다. 김선우 메리츠증권 연구원은 \"1분기 실적은 사상 최대 수준으로 시장 기대에 부합했다\"며 \"본"},{"title":"기장군 국민의힘 후보 난립, 민주당 우성빈 16.5%로 우세","link":"https://www.etoday.co.kr/news/view/2571367","source":"Bing"},{"title":"기장군