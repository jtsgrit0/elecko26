, 이재숙)이다. 4인 경선 지역은 ▲기장군 제2선거구(김민정, 라기오, 이영숙, 황운철)이다. 민주당 당헌 제102조(재심)에 따라 심사 결과에 대해 공표 시점으로부터 48시간 이내 재심 신청이 가능하다. 민주당은 앞서 지난 26일 22곳에 대한 광역의원 단수추천을 진행했다. ◎공감언론 뉴시스 [email protected] $('iframe').addClass(\"frameCenter\"); function output(type,ob){ var windoption = \"width=760,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; if ( type == 'print' ) { windoption = \"width=860,height=700,left=300,top=100,resizable=no,scrollbars = yes\"; } if(type == \"email\"){ } if(ob == \"article\"){ if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=NISX20260327_0003567591\"+ '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id=NISX20260327_0003567591&method='+type + '&type='+ob,'', windoption); } }else if(ob == \"photo\"){ var thopho_id = $(\"#hid_foc\").val(); if(type ==\"pdf\"){ //alert('pdf 서비스 점검 중입니다.'); //return false; location.href=\"/pdf?id=\"+ thopho_id + '&type='+ob+'&title='+encodeURI($('.title_area').text()); }else{ window.open('/common/?id='+ thopho_id +'&method='+type+'&type='+ob,'',windoption); } } } 최진실 딸 준희 \"부산 출신 시어머니와 대화, 매 순간 듣기평가\" 송혜교, 소피 마르소와 어깨 나란히…국보급 미모 임우재 전 삼성전기 고문 '80대노인 감금' 가담 혐의 수감중 엄지윤 \"김원훈과 키스신, 비비크림 맛 싫었다\" 문근영, 억대 기부 이유…\"공무원 부모님, 떵떵거리며 쓰고 싶지 않다고\" \"美, 이스라엘에 '이란 휴전 26일까지 연장' 통보\" 와이넷 \"유명 배우 음주운전, 매니저가 뒤집어쓰기도 한다\" 민주당, 인천 계양을 김남준·연수갑 송영길 전략 공천 정근식, 서울시교육감 '진보' 단일 후보로 선출 주한미군 전작권 전환 '2029년' 첫 언급, 한국은 '2028년'…조율 필요할 듯 이 대통령, 오늘 '한-베트남 비즈니스 포럼' 참석…이재용·최태원·구광모 등 참석 정부 \"고유가 피해지원금 현금화 등 부정유통 단속 강화\" 주호영 \"대구시장 선거 불출마…장동혁 물러날 때 알아야\" 민주당, 송영길·김남준 전략공천…수도권 재보선 공천 교통정리 시작 \"美, 이스라엘에 '이란 휴전 26일까지 연장' 통보\" 와이넷 미군 \"이란과 관련된 유조선 1척 또 나포\" 트럼프 \"호르무즈 기뢰 부설 모든 선박 사살 지시\" 멕시코 미인대회 출신 여성 피살…유력 용의자는 '시어머니' 트럼프 \"내 요구에 이란, 여성 8명 처형 취소\"…이란 \"가짜뉴스\"(종합) 'MAGA 여성 알고봤더니' 인도 의대생이 만든 AI…매달 수천달러 벌어 이 대통령, 오늘 '한-베트남 비즈니스 포럼' 참석…이재용·최태원·구광모 등 참석 오만산 LNG·헬륨 들어오나…산업차관, 오만가스공사 CEO 면담 4차 석유 최고가격 또 동결…휘발유 1934원·경유 1923원 산업차관 \"4차 석유 최고가격 내려야 했지만 동결…3차 땐 올리지 않고 동결\" 뉴욕증시, 이란전 불확실성에 하락 출발…다우