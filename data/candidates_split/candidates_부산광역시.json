on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 이승연 \"절차 생략된 단수추천 취소해야\"·김정욱 \"밀실 사천·이중잣대 공천 중단하라\"\n두 후보 모두 부산시당 공관위 재심 청구… 무소속 출마 가능성엔 \"공식 절차 지켜본 뒤 판단\" 23일 오후 3시 국민의힘 부산시의원 공천에 반발한 수영구 제2선거구 이승연 예비후보와 해운대구 제1선거구 김정욱 예비후보가 기자회견을 열고 '밀실공천 취소'와 '공정경선 보장'을 촉구하고 있다.(사진_한창기 선임기자) [시사매거진 한창기 선임기자] 국민의힘 부산시의원 공천을 둘러싼 반발이 수영구와 해운대구에서 동시에 분출됐다. 23일 오후 기자회견에 따르면 수영구 제2선거구 이승연 예비후보와 해운대구 제1선거구 김정욱 예비후보는 각각 공천 과정의 절차적 하자와 '밀실 사천' 의혹을 제기하며 재심 청구와 가처분 신청 방침을 밝혔다. 이승연 예비후보는 이날 기자회견에서 자신이 별다른 결격 사유 없이 컷오프됐다며, 수영구 제2선거구 공천 과정에서 선거구 조정과 단수추천이 불투명하게 이뤄졌다고 밝혔다. 그는 당규상 단수추천은 복수 신청자 중 1인의 경쟁력이 현저히 우위일 경우에 가능하지만, 상대 후보의 경쟁력이 자신보다 월등하다는 객관적 근거는 제시되지 않았다고 주장했다. 이어 이 예비후보는 원래 수영구 제1선거구에 공천을 신청한 후보가 수영구 제2선거구에서 공천 또는 경선 절차를 밟으려면 재공모 등 별도 절차가 선행돼야 한다고 주장했다. 그는 \"절차를 생략한 단수추천은 명백한 하자\"라며 중앙당 재심 신청과 함께 법원 가처분 신청도 진행 중이라고 밝혔다. 김정욱 예비후보도 같은 자리에서 해운대 지역 공천을 두고 주진우 의원 측의 '밀실 사천'과 '이중잣대 공천'을 강하게 비판했다. 김 예비후보는 지역 연고와 정체성이 불분명한 인사에게 전략공천이 시도되고, 기존 당원과 지역 활동 인사들이 배제되고 있다고 주장하며 부산시당 공관위에 공정 경선을 요구했다. 그는 또 신정철 현 시의원의 컷오프 사유로 거론된 '젊은 인재 발탁' 논리를 언급하며, 자신을 포함한 다른 청년·중진 예비후보들에게는 왜 같은 기준이 적용되지 않았는지 납득하기 어렵다고 밝혔다. 아울러 해운대갑 당협 측이 자신에 대해 '공헌 활동이 부족하다'는 취지의 입장을 낸 데 대해서도, 부산시당 부위원장과 각종 당직 수행, 지역 민원 해결 활동을 이어왔다며 정면 반박했다. 두 예비후보는 재심이 받아들여지지 않을 경우에 대해서도 입장을 밝혔다. 이승연 예비후보는 \"무소속 출마 여부는 재심과 가처분 결과가 나온 뒤 주민들과 논의해 결정하겠다\"고 했고, 김정욱 예비후보도 \"당의 공식 절차를 지켜본 뒤 판단하겠다\"며 \"모든 가능성은 열려 있다\"고 말했다. 이날 기자회견장에서는 참석자들이 \"국민의힘은 밀실공천을 취소하라\", \"공정선거를 보장하라\"고 구호를 외치며 공천 재검토를 촉구했다. 두 후보는 이번 사안을 단순한 지역 내 공천 갈등이 아니라 당의 공정성과 공천 제도 전반을 점검해야 할 문제로 규정하며 중앙당 차원의 제도 개선도 요구했다. 키워드 #국민의힘 부산시의원\n#수영구 제2선거구 이승현 예비후보\n#해운대구 제1선거구 김정욱 예비후보\n#국민의힘\n#국민의힘 부산시당 한창기 선임기자 aegookja@sisamagazine.co.kr 다른기사 보기 저작권자 © 시사매거진 무단전재 및 재배포 금지 당신만 안 본 뉴스 #skin-9 > .item:not(:first-child) {margin-top:12px} 금산군, 농어촌 기본소득 시범사업 신청 가능 여부 ‘주목’… 새 코로나 변이 바이러스 ‘매미’ 확산 “군산시향, 10년 만의 귀환… 동백처럼 단단하게 피어나다” 신천지, 대구서 말씀대성회 개최… 이만희 \"계시록 90% 성취\" 주장 [조용우 환경칼럼] 원전 지원금, 지역 공동체를 살리는가 무너뜨리는가 국힘 부산 기초단체장 공천 완료…'현역 컷오프' 후폭풍에 원팀 균열 해외에서 꽃피운 태권도 지도력…국제무대에서 성과 입증 #skin-10 > .item {position:relative;margin-top:16px}\n#skin-10 > .item:first-child {margin-top:0}\n#skin-10 .frame::after {content:'';position:absolute;z-index:2;left:0;bottom:0;width:100%;height:100%;background:linear-gradient(rgba(0,0,0,0) 42%,rgba(0,0,0,.9));border:0}\n#skin-10 .auto-titles {position:absolute;z-index:15;left:16px;right:16px;bottom:16px}\n#skin-10 .height-250 {height:250px} 금산군, 농어촌 기본소득 시범사업 신청 가능 여부 ‘주목’… /**************************************************\n*\tCOMMENT SKIN FILE\n*\n*\tAUTHOR\t: SOHO (for ndsoft)\n*\tFILE\t: /fine_home/comment/skin/skin01/_style.css\n*\tINCLUDE : /fine_home/comment/skin/skin01/_comment.html\n*\tNOTE\t:\n*\n**************************************************/\n/* layout */\n#comment {display:block;margin:2.5rem auto}\n[data-whatintent=\"touch\"] #comment button, [data-whatintent=\"touch\"] #comment button:focus {outline:0} /* titles */\n.cmt-header::after {content:'';display:table;clear:both}\n.cmt-header .titles {float:left;font-size:1.25rem;font-weight:normal;line-height:35px;color:#000}\n.cmt-header .comment-count {font-weight:bold}\n.cmt-header .my-cmt {float:right;font-size:.875rem;line-height:35px;color:rgba(0,0,0,.95)}\n.cmt-header .my-cmt > i[class^=\"icon-\"] {display:inline-block;overflow:hidden;width:15px;height:15px;font-size:.5rem;line-height:13px;color:#000;border:1px solid rgba(0,0,0,.5);border-radius:50%;text-align:center;vertical-align:middle} /* write */\n.comment-write {display:block;overflow:hidden;margin-bottom:2.1875rem;background-color:#fff;border:1px solid rgba(0,0,0,.25);border-radius:.3125rem}\n.comment-write .wrt-header {display:block;padding:1.25rem}\n.comment-write .wrt-header::after {content:'';display:table;clear:both}\n.comment-write .user-name {float:left;font-size:.9375rem;line-height:28px}\n#comment-guest {float:right;font-size:0;white-space:nowrap}\n#comment-guest input[type=\"text\"], #comment-guest input[type=\"password\"] {display:inline-block;width:115px;height:28px;margin:0;font-size:.8125rem;border-radius:2rem}\n#comment-guest input[type=\"password\"] {margin-left:.25rem}\n.comment-write .comment-content {display:block;min-height:65px;margin:0 auto;padding:0 1.25rem;font-size:.9375rem;font-weight:300;font-weight:var(--wgt300, 300);line-height:1.625;color:#000;border:none;border-radius:0}\n.comment-write .comment-content[readonly] {background:none}\n.comment-write .recaptcha-container {display:block;font-size:0;text-align:"},{"title":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표","link":"https://www.lawissue.co.kr/view.php?ud=2026042118353662769a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표 기사입력:2026-04-21 18:37:29 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 21일 제13차 회의를 갖고 광역⋅기초의원 경선 결과를 발표하고, 광역⋅기초의원 후보자들을 의결했다고 밝혔다. 이번 경선은 4.19.~20. 양일간 실시된 선거인단 투표(모바일 전자투표 및 ARS 투표) 결과를 100%로 반영했다. 최종 결과는 선거인단 모바일 전자투표 및 ARS 투표 결과를 선거인단 유효투표수 기준으로 합산, 이를 100% 기준 비율로 변환하고 후보별 가⋅감산점을 적용해 확정했다. ◇광역의원 후보자 의결(3곳) ▲동래구 제2선거구 : 송우현(현 부산광역시의회 의원) ▲사하구 제2선거구 : 최종원(전 국회 5급 선임비서관) ▲금정구 제1선거구 : 하은미(현 금정구의회 3선 의원) ◇기초의원 후보자 의결(4곳)\n▲해운대구 마 선거구=가 : 박기훈(현 해운대구의회 의원), 나 : 김민성(현 국민의힘 해운대구을 청년위원장)\n▲ 해운대구 바 선거구=가 : 장성철(현 해운대구의회 의장), 나 : 이국두(현 국민의힘 해운대구 재송2동협의회장)\n▲ 사하구 가 선거구(기호 나)= 윤보수(현 사하구의회 의원)\n▲사하구 나 선거구(기호 나) =정삼균(현 사하구의회 의원) ※ 사하구 가⋅나 선거구 기호 가 후보자는 제9차 공천관리위원회(4.9.) 의결전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []