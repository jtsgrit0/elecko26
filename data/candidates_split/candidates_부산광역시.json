영도구의회 의원), 서구 가 가 – 주지웅(현. 서구의회 의원), 나 – 강경미(女)(전. 서구의회 운영기획위원장), 기장군 가 가 – 김명원(현. 대원종합토건 대표이사), 나 – 박기조(현. 기장군의회 문화복지행정위원장), 기장군 다 가 – 박우식(현. 기장선⋅정관선 특별추진위원장), 나 – 구본영(현. 기장군의회 부의장), 다 – 송창섭(전. 정관읍 청년회 회장)이 의결 되었다. 부산시당은 “단수 후보자 및 기초의원 기호(순번)는 시당 운영위원회 의결을 거쳐 중앙당 최고위원회의 의결로 최종 확정된다”고 밝혔다. $(function() { const copyUrlOptions=document.querySelectorAll(\".urlBtns, .sns_clipboard\"); // 주소복사 이벤트 (v11-fl-v2 수정) copyUrlOptions.forEach(selector=>{ selector.addEventListener(\"click\", (e)=>{ const target=e.target, targetBtn=target.closest(\"[data-clipboard-text]\"); if (targetBtn===null) return; const url=targetBtn.getAttribute(\"data-clipboard-text\")||\"\"; Util.copyToClipboardToast(selector, '', url); }); }); // 사진 lightBox 이벤트 if (typeof ImageViewer != \"undefined\") { new ImageViewer(\".photo-layout\", 0); } }); SNS 기사보내기 이메일(으)로 기사보내기 다른 공유 찾기 기사스크랩하기 $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이상철 기자 lsc1106@hanmail.net 기자의 다른기사 보기 기사제보 저작권자 © 글로벌뉴스통신GNA 무단전재 및 재배포 금지 #AD173975763124.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD173975763124.ad-template .col { float:left; text-align:center; width:50%; }\n#AD173975763124.ad-template .col .ad-view { position:relative; } 당신만 안 본 뉴스\n#skin-22 { --nd-atx-gutter-y: 0.75rem; --nd-atx-title-font-size: 0.9375rem; --nd-atx-title-font-weight: 400; --nd-atx-title-line-height: 23px; } #skin-22 > .item + .item { margin-top: var(--nd-atx-gutter-y); } 더불어 민주당 부산시당, 불공정 밀실·기획 공천 논란 제81차 대한민국 국가원로회 포럼 개최 성료 부산 북구갑 주민 1만명,박민식 지지 강북문인협회, 'AI문학의 윤리와 저작권 문제' 문학강연 개최 한국방송통신대