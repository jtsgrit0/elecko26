구 제1선거구에서는 박경훈(전 수영구의회 의원)과 조병제(현 수영구의회 의원)이 2인 경선을 치를 예정이다. 기초의원 경선 지역은 남구 가·나·라 등 3곳으로, 모두 2인 경선으로 진행된다. 국민의힘 부산시당 관계자는 \"광역의원의 경우 북구 제1선거구 외에는 모두 후보나 경선 일정이 확정났다\"며 \"경선 일정은 추후 공관위 논의를 거친 후 발표할 예정\"이라고 말했다. 지금 뜨는 뉴스 부하 여직원 사진 연인처럼 AI 합성해 올린 공무원 재판행 대리기사 차에 매단 채 운전해 숨지게 한 30대…검찰, 징역 30년 구형 'CU 사태' 결국 평행선…BGF로지스-화물연대 26일 재교섭 [단독]삼전 노조 \"파업 시 이재용 자택 앞 집회 후 사업장 점거\" 모수 '와인 바꿔치기 논란'[어텐션 뉴스] 강태흠 감독의 함은정·오현경 '첫 번째 남자', 20회 연장 확정 검찰 '사기적 부정거래' 의혹 방시혁 구속영장 반려 하나금융 순익 1.2조 '역대 최대'…우리금융만 '어닝 미스' 진보 단일후보 정근식 \"천만 시민 염원 받들어 본선 승리할 것\" 李대통령 \"장특공, 보유감면 축소하고 거주감면 늘려야\" ※CBS노컷뉴스는 여러분의 제보로 함께 세상을 바꿉니다. 각종 비리와 부당대우, 사건사고와 미담 등 모든 얘깃거리를 알려주세요. 이메일 jebo@cbs.co.kr 카카오톡@노컷뉴스 사이트https://url.kr/b71afn 부산CBS 정혜린 기자메일구독 6·3 지방선거 구독 임성무 대구교육감 후보 \"서중현과 단일화 닫아둘 수 없지만 조건 문제\" 국민의힘 25~26일 충북지사 본경선…민주당 정청래 방문 '맞불' 장세일, '민주당 영광 원팀' 결집…\"본선 승리 위한 단일대오 구축\" 0 0 window.NocutReplyHost = \"https://reply.nocutnews.co.kr\"; (function () { try { NocutReply.load(\"https://nocutnews.co.kr/news/\" + 6506308); } catch { } })(); (function (d, a, b, l, e, _) { if (d[b] && d[b].q) return; d[b] = function () { (d[b].q = d[b].q || []).push(arguments) }; e = a.createElement(l); e.async = 1; e.charset = 'utf-8'; e.src = '//static.dable.io/dist/plugin.min.js'; _ = a.getElementsByTagName(l)[0]; _.parentNode.insertBefore(e, _); })(window, document, 'dable', 'script'); dable('setService', 'nocutnews.co.kr'); dable('renderWidget', 'dablewidget_GlYGEgoy', { ignore_items: true }); 이 시각 주요뉴스 (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_GlYrJRXy'); (function (d, a) { d[a] = d[a] || function () { (d[a].q = d[a].q || []).push(arguments) }; }(window, 'dable')); dable('renderWidget', 'dablewidget_xlz6kelZ');"},{"title":"[6·3부산]국힘 광역의원 낙천 반발…\"일방 컷오프·이중잣대\"","link":"https://www.msn.com/ko-kr/news/politics/6-3%EB%B6%80%EC%82%B0-%EA%B5%AD%ED%9E%98-%EA%B4%91%EC%97%AD%EC%9D%98%EC%9B%90-%EB%82%99%EC%B2%9C-%EB%B0%98%EB%B0%9C-%EC%9D%