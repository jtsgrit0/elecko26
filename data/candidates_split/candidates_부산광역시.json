: 1, loop: true, speed: 500, autoplay: { delay: 7000, disableOnInteraction: false, }, pagination: { el: '.aside-topnews .swiper-"},{"title":"부산 민주당, 기초단체장 경선 스타트…중·서·금정·수영 4곳 경쟁 시작","link":"https://www.nocutnews.co.kr/news/6492372","source":"Bing"}]},{"id":"member_박미순","name":"박미순","party":"국민의힘","district":"부산광역시 남구제4선거구","imageUrl":"https://cpmadang.org/sites/default/files/thumbnail.100156863.JPG","bio":"부경대학교 글로벌정책대학원 사회복지학 석사 (전)제7,8,9대 남구의원\n(전)제9대 남구의회 전반기 의장","electionDate":"2026-06-03T00:00:00.000","term":1,"achievementsList":["부경대학교 글로벌정책대학원 사회복지학 석사 (전)제7,8,9대 남구의원\n(전)제9대 남구의회 전반기 의장"],"actions":[],"policies":[],"pressReports":[{"title":"[뉴스] 국민의힘 박미순 후보, 주요 공약 발표","url":"https://example.com/news/박미순_article","source":"모의 뉴스","publishedAt":"2026-04-20T04:05:36.479Z"}],"sourceUrl":"https://cpmadang.org/taxonomy/term/83820","crawledDate":"2026-04-19T22:24:56.845Z","confidence":0.9,"rawText":"2026년 9대 전국지방동시선거\n  부산 남구\n\n    \n    \n        \n        \n\n\n      \n        국민의힘\n        \n                                        \n                \n                \n          박미순(朴美順)\n          \n         ","analysis":"박미순 부산 남구의회의장, 제15회 지방의정봉사대상 수상\n\n박미순 부산 남구의회 의장, 제15회 대한민국지방의정봉사대상 수상\n\n박미순 부산 남구의장 “구민 모두가 행복한 남구 만들기에 최선 다하겠다”","news":[{"title":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표","link":"https://www.lawissue.co.kr/view.php?ud=2026042118353662769a8c8bf58f_12","source":"Bing","content":"국민의힘 부산시당, 광역⋅기초의원 경선 결과 발표 기사입력:2026-04-21 18:37:29 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 (제공=국민의힘부산시당)(제공=국민의힘부산시당)이미지 확대보기[로이슈 전용모 기자] 국민의힘 부산광역시당 공천관리위원회(위원장 정동만 국회의원)는 4월 21일 제13차 회의를 갖고 광역⋅기초의원 경선 결과를 발표하고, 광역⋅기초의원 후보자들을 의결했다고 밝혔다. 이번 경선은 4.19.~20. 양일간 실시된 선거인단 투표(모바일 전자투표 및 ARS 투표) 결과를 100%로 반영했다. 최종 결과는 선거인단 모바일 전자투표 및 ARS 투표 결과를 선거인단 유효투표수 기준으로 합산, 이를 100% 기준 비율로 변환하고 후보별 가⋅감산점을 적용해 확정했다. ◇광역의원 후보자 의결(3곳) ▲동래구 제2선거구 : 송우현(현 부산광역시의회 의원) ▲사하구 제2선거구 : 최종원(전 국회 5급 선임비서관) ▲금정구 제1선거구 : 하은미(현 금정구의회 3선 의원) ◇기초의원 후보자 의결(4곳)\n▲해운대구 마 선거구=가 : 박기훈(현 해운대구의회 의원), 나 : 김민성(현 국민의힘 해운대구을 청년위원장)\n▲ 해운대구 바 선거구=가 : 장성철(현 해운대구의회 의장), 나 : 이국두(현 국민의힘 해운대구 재송2동협의회장)\n▲ 사하구 가 선거구(기호 나)= 윤보수(현 사하구의회 의원)\n▲사하구 나 선거구(기호 나) =정삼균(현 사하구의회 의원) ※ 사하구 가⋅나 선거구 기호 가 후보자는 제9차 공천관리위원회(4.9.) 의결전용모 로이슈(lawissue) 기자 sisalaw@lawissue.co.kr <저작권자 © 로이슈, 무단 전재 및 재배포 금지> 로이슈가 제공하는 콘텐츠에 대해 독자는 친근하게 접근할 권리와 정정ㆍ반론ㆍ추후 보도를 청구 할 권리가 있습니다. 메일:law@lawissue.co.kr / 전화번호:02-6925-0217 (adsbygoogle = window.adsbygoogle || []).push({}); (adsbygoogle = window.adsbygoogle || []).push({}); 글씨 축소 글씨 확대 프린트 페이스북 트위터 구글플러스 주요뉴스 베트남 정상회담 마친 李대통령 '탕롱황성' 찾아 친교... 인도 모디 총리에... 정치 장동혁, 2선 후퇴 등 당내 일부 거취 압박에 \"사퇴가 선거승리 도움 되나\" 정치 대법원, 뇌물수수사건 개별 추징 아닌 공동추징 부분 원심 파기 환송 법조 李대통령, 한-베트남 포럼서 양국 기업 에너지 협력 강조... \"베트남과 희토... 산업·경제 정청래, 오늘 인천 찾아 민생 행보… 보선 출마 송영길·김남준 동행 예정 정치 '평양무인기 의혹' 尹·김용현 일반이적 혐의 오늘 1심변론 종결 법조 .t_box1>ul>li {width:243px;} .today_box>.t_box1>ul>li>a>.thumb>img {width:243px; height:144px;} 핫포커스 김정문알로에 자회사 케이제이엠바이오, 치료제 없는 난청 관련 건기식 원료... 현대약품, 전립선비대에 의한 배뇨장애 해결 ‘유린타민캡슐’ 선보여 CJ제일제당, ‘고메치킨’ 신제품 2종 선보여 KFC, 프리미엄 닭다리통살로 재탄생한 ‘블랙라벨더블다운맥스’ 선보여 세븐일레븐, 2021 추석선물세트 판매 시작 CU, 추석 선물로 기존 편의점에서 판매하지 않았던 상품들 대거 선보여 $(document).ready(function(){ iFrameResize({ log: false, checkOrigin: false }, '#clsnhiCommentIFrameID');\n}); /*\n$(document).ready(function(){ $('#clsnhiCommentIFrameID').iFrameSizer({ log : true, // For development autoResize : true, // Trigering resize on events in iFrame contentWindowBodyMargin: 15, // Set the default browser body margin style (in px) doHeight : true, // Calculates dynamic height doWidth : false, // Calculates dynamic width enablePublicMethods : true, // Enable methods within iframe hosted page //interval : 0, // interval in ms to recalculate body height, 0 to disable refreshing interval : 32, checkOrigin : false, scrolling : false, // Enable the scrollbars in the iFrame callback : function(messageData){ // Callback fn when message is received $('p#callback').html( '<b>Frame ID:</b> ' + messageData.iframe.id + ' <b>Height:</b> ' + messageData.height + ' <b>Width:</b> ' + messageD