; // 구독료 금액 설정 $('.subscription_fee .payment_box .price_sel li label').on('click', function(){ var price = $(this).prop('for').replace('price_','').replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); $(this).closest('.payment_box').find('.price span').text(price); }); $('.subscription_fee .payment_box .add_btn div').on('click', function(){"},{"title":"민주당 세종시당 ‘공천 잡음’ 일파만파","link":"https://www.ccdailynews.com/news/articleView.html?idxno=2411501","source":"Bing","content":"기자명 이능희 기자 입력 2026.04.20 16:14 댓글 0 바로가기 복사하기 본문 글씨 줄이기 본문 글씨 키우기 SNS 기사보내기 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오스토리(으)로 기사보내기 카카오톡(으)로 기사보내기 네이버밴드(으)로 기사보내기 URL복사(으)로 기사보내기 이메일(으)로 기사보내기 다른 공유 찾기 기사스크랩하기 $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } }); }); 이 기사를 공유합니다 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 카카오스토리(으)로 기사보내기 카카오톡(으)로 기사보내기 네이버밴드(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 임채성 의장·여미전 의원 반발\n재심 청구 및 법적 대응 나서 더불어민주당 세종시당의 9회 전국동시지방선거 공천 심사 과정이 절차적 정당성과 형평성 논란에 휩싸였다. 현역 의원들이 잇따라 ‘부적격’ 판정에 반발하며 재심을 청구하고 법적 대응을 예고하는 등 공천 파열음이 커지고 있다. 임채성 세종시의회 의장(종촌동·10선거구)은 세종시당의 ‘부적격’ 통보에 대해 절차적 공정성을 문제 삼으며 재심을 공식 청구했다. 임 의장은 “부적격 사유가 명확하지 않고, 사실관계가 확인되지 않은 의혹들이 포함됐다”며 소명 절차를 거쳤음에도 부적격 판정을 내린 시당의 결정에 깊은 유감을 표했다. 특히 그는 최근 시당의 ‘반복적인 추가 공모’와 ‘공관위원의 후보 출마’를 강도 높게 비판했다. 임 의장은 “4월 8일 재공모에 이어 16일 또다시 10선거구 추가 공모를 진행한 것은 특정 결론을 염두에 둔 것 아니냐”고 의구심을 제기했다. 또 “심사를 담당했던 공천관리위원이 사퇴 직후 해당 선거구 후보로 지원한 것은 ‘심판이 선수로 뛰는 행위’”라며 이는 공천의 신뢰를 무너뜨리는 행태라고 지적했다. 같은 당 소속 여미전 세종시의원(해밀·산울동·4선거구) 역시 시당의 부적격 판정에 불복해 서울남부지방법원에 효력 정지 가처분 신청을 제기했다. 여 의원은 ‘다주택 소유’를 이유로 부적격 판정을 받았으나, 이에 대해 “주택 처분 계획에 따라 매각을 진행해왔고 이미 문제가 해소된 상태”라며 형평성 문제를 제기했다. 여 의원은 “타 지역이나 세종시 내 다른 공천 후보 중에도 다주택자가 포함되어 있다”며 특정인에 대한 표적 심사 의혹을 제기했다. 중앙당 구제 신청까지 각하된 상황에서 법적 대응이라는 마지막 카드를 꺼낸 여 의원은, “당의 방침을 따르기 위해 노력했음에도 실질적인 상황을 반영하지 않은 채 매각 계약 당일에 부적격 통보를 한 것은 받아들일 수 없다”고 강조했다. 이번 공천 잡음으로 인해 세종시당이 당초 약속했던 ‘억울한 컷오프 없는 공천’은 공염불이 됐다는 비판이 나온다. 임 의장과 여 의원은 이번 공천 과정이 원칙을 잃고 감정이 개입된 ‘사천 논란’으로 변질되고 있다고 입을 모았다. 두 의원은 “공천은 특정 세력의 전유물이 아닌 시민을 위한 과정”이라며 이번 재심과 법적 절차를 통해 공정성과 객관성이 반드시 회복돼야 한다고 목소리를 높였다. 민주당 세종시당의 공천 심사를 둘러싼 내홍이 격화되는 가운데, 시당 측이 이에 대해 어떤 해명을 내놓을지 지역 정가의 이목이 쏠리고 있다. /세종=이능희기자 이능희 기자 nhlee777@hanmail.net 다른기사 보기 저작권자 © 충청일보 무단전재 및 재배포 금지 당신만 안 본 뉴스 #skin-9 > .item {margin-top:12px}\n#skin-9 > .item:first-child {margin-top:0}\n#skin-9 .auto-titles {letter-spacing:-.05em} 청주 오송역 인근 농지 1만㎡ ‘쪼개기 투기’…검찰, 집요한 추적 끝에 32명 적발 고유가 피해지원금, 오는 27일부터 지급…인당 10만~60만원 민주당 청주시장 결선 앞두고 세 결집 ‘사활’ 세종시장 후보 조상호 청주시장 후보 이장섭 충북 수출, 사상 첫 100억 달러 돌파…반도체 ‘독주’ 속 구조 편중 심화 청주시향 노조, 공연장 시위 논란…“관객 문화향유권 침해” 비판 확산 교장실 흉기 사건 이후…학교장 대응 논란 확산 #skin-10 > .item {position:relative;margin-top:16px}\n#skin-10 > .item:first-child {margin-top:0}\n#skin-10 .frame::after {content:'';position:absolute;z-index:2;left:0;bottom:0;width:100%;height:100%;background:linear-gradient(rgba(0,0,0,0) 42%,rgba(0,0,0,.9));border:0}\n#skin-10 .auto-titles {position:absolute;z-index:15;left:16px;right:16px;bottom:16px;font-weight:normal}\n#skin-10 .height-250 {height:250px} 청주 오송역 인근 농지 1만㎡ ‘쪼개기 투기’…검찰, 집요한 추적 끝에 32명 적발 #AD159788754983.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD159788754983.ad-template .col { text-align:center; }\n#AD159788754983.ad-template .col .ad-view { position:relative; } jQuery( document ).ready(function() { vote.voteCheck( jQuery('#reply-write-btn, .reply-container'), // 폐쇄시 제거할 영역 'S', // 실명제 구분값 '/news/articleView.html' // 리턴URL ); }); 댓글삭제 삭제한 댓글은 다시 복구할 수 없습니다. 그래도 삭제하시겠습니까? 비밀번호 삭제 닫기 기사 댓글 0 댓글 접기 로그인 후 이용 가능합니다. 댓글 내용입력 0 / 400 비회원 로그인 이름 비밀번호 댓글 내용입력 0 / 400 등록 댓글쓰기 계정을 선택하시면 로그인·계정인증을 통해 댓글을 남기실 수 있습니다. 회원 로그인 비회원 글쓰기 이름 비밀번호 자동등록방지 var captchaC