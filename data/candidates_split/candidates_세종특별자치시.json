© 뉴스1 무단전재 및 재배포, AI학습 및 활용 금지 #AD174493847810.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493847810.ad-template .col { text-align:center; }\n#AD174493847810.ad-template .col .ad-view { position:relative; } #AD174493849510.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; padding-bottom:35px; }\n#AD174493849510.ad-template .col { text-align:center; }\n#AD174493849510.ad-template .col .ad-view { position:relative; } (function(d,a,b,l,e,r) {\nif(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l);\ne.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js';\nr=a.getElementsByTagName(l)"},{"title":"국힘 세종시당, 경선 3곳 김충식·김학서·양진호 공천 확정…김대곤 전략 투입","link":"https://www.ohmynews.com/NWS_Web/View/at_pg.aspx?CNTN_CD=A0003222902","source":"Bing","content":"정치대전충청 26.04.09 15:20ㅣ최종 업데이트 26.04.09 15:20 국힘 세종시당, 경선 3곳 김충식·김학서·양진호 공천 확정…김대곤 전략 투입 조치원 김충식, 전의·전동·소정 김학서... 고운동 양진호, 장군·한솔 김대곤 확정 뉴스피치 김이연심(guevarakim) 글씨 크게보기 글자 크기조절 가 가 가 가 인쇄 본문듣기 원고료로 응원하기 추천 댓글 공유 큰사진보기 ▲국민의힘 세종시당 사무실 ⓒ 뉴스피치 김이연심 기자 관련사진보기 국민의힘 세종시당이 제9회 전국동시지방선거를 앞두고 경선 지역 후보 확정과 함께 전략공천을 단행하며 전체 공천 윤곽이 드러나는 모습이다.\n국민의힘 세종시당 공천관리위원회(위원장 이준배)는 9일 조치원읍 제1선거구, 제5선거구(전의·전동·소정), 고운동 제11선거구 등 경선 실시 지역 3곳의 후보를 최종 확정하고, 제6선거구(장군면·한솔동)에는 김대곤 전 세종시 정책수석을 전략공천했다고 밝혔다.\n이번에 확정된 3개 선거구는 모두 복수 후보가 경쟁한 경선 지역으로, 중앙당 공천관리위원회의 '복수 후보 시 경선 원칙'에 따라 책임당원 100%로 구성된 선거인단이 참여해 지난 4월 3일부터 5일까지 투표가 진행됐다. AD 경선 결과 조치원읍 제1선거구에서는 김충식 현 의원이 53.59%를 득표하며 3자 구도에서 1위를 차지했다. 제5선거구(전의·전동·소정)에서는 김학서 현 의원이 51.54%로 1위에 올랐고, 고운동 제11선거구에서는 양진호 후보가 56.25%를 기록하며 공천을 확정했다.\n전반적으로 현역 또는 당내 기반을 갖춘 후보들이 경쟁력을 입증했다는 평가가 나온다. 공천관리위원회는 경선 결과 발표 이후 4월 7일까지 이의신청을 접수했으나 별다른 이의가 제기되지 않아 8일부로 후보를 최종 확정했다.\n특히 고운동 제11선거구 경선에 참여했던 김대곤 전 세종시 정책수석이 제6선거구(장군·한솔)에 전략공천되면서, 경선과 별도로 후보 재배치가 이뤄진 점도 눈길을 끈다. 제6선거구는 더불어민주당 현역 시의원이 있는 지역으로, 당내에서는 경쟁력을 고려한 전략적 판단이라는 설명이다.\n앞서 세종시당은 지난 3월 31일 1차 공천 발표를 통해 김광운(조치원읍 제2선거구), 김동빈(부강·금남·대평 제3선거구), 최원석(도담동 제7선거구), 이규영(종촌동 제10선거구), 서용숙(고운동 제12선거구), 박윤경(보람동 제13선거구), 홍나영(소담동 제14선거구), 한민정(새롬동 제16선거구) 후보 등 8개 선거구 단수 후보를 확정한 바 있다.\n이에 따라 국민의힘 세종시당 공천은 경선과 단수 추천, 전략공천을 거치며 대부분 선거구에서 윤곽이 드러난 상태다. 다만 반곡·집현동 선거구는 선거구 분할 등 획정 변수로 인해 공천 확정이 보류됐다.\n국민의힘 세종시당 공천관리위원회는 \"이번 경선은 당원의 의사를 충실히 반영해 공정성과 민주성을 기반으로 진행됐다\"며 \"시민 삶을 실질적으로 개선할 수 있는 경쟁력 있는 후보 중심으로 책임 공천을 이어가겠다\"고 밝혔다. 이어 \"제6선거구에 김대곤 후보를 전략공천한 것은 지역 특성과 경쟁 구도를 고려한 결정\"이라며 \"세종시 정책수석과 주민자치연합회장 등을 역임한 지역 이해도가 높은 인물\"이라고 평가했다. 덧붙이는 글 | 이 기사는 세종시 공동체 미디어 '뉴스피치'에도 실립니다.뉴스피치(Newspeach)는 세종시 중장년 여성들이 주축이 되어 창간한 지역 기반 공동체 미디어로, 젠더 관점의 보도를 통해 지역 사회의 다양한 의제를 조명하고 건강한 공동체 형성에 기여하는 새로운 언론을 지향합니다. #세종시#국민의힘#뉴스피치 저작권자(c) 오마이뉴스(시민기자), 무단 전재 및 재배포 금지 오탈자 신고 네이버 채널구독 다음 채널구독 window.googletag = window.googletag || {cmd: []}; googletag.cmd.push(function() { googletag.defineSlot('/21682743634,60494604/S003/ohmynews/ga01/pc/post_byline_bottom_btf_336x280', [336,280], 'tdn_S003_ohmynews_ga01_pc_post_byline_bottom_btf_336x280').addService(googletag.pubads().set('page_url', '//ohmynews.com')); googletag.pubads().enableSingleRequest(); googletag.enableServices(); googletag.display('tdn_S003_ohmynews_ga01_pc_post_byline_bottom_btf_336x280'); }); 추천 댓글 스크랩 페이스북 트위터 공유 이 기사가 마음에 드시나요? 좋은기사 원고료로 응원하세요 원고료로 응원하기 (function(d,a){d[a]=d[a]||function(){(d[a].q=d[a].q||[]).push(arguments)};}(window,'dable')); $(function() { dable('renderWidget', 'dablewidget_A370BMXx'); }); 글 뉴스피치 김이연심 (guevarakim) 내방 아이콘구독하기 뉴스피치(Newspeach)는 세종시 중장년 여성들이 주축이 되어 창간한 지역 기반 공동체 미디어로, 젠더 관점의 보도를 통해 지역 사회의 다양한 의제를 조명하고 건강한 공동체 형성에 기여하는 새로운 언론을 지향합니다. 이 기자의 최신기사세종시법 국회 통과... 시의회 비례대표 2→3석 증원 갤러리 오마이포토 한강버스 운영사업 업무협약(변경) 동의안 부결 촉구 1/6 이전 다음 이전 다음 if ($('#mycarousel').length > 0) { $('#mycarousel').jcarousel({ scroll: 7, initCallback: mycarousel_initCallback }); } 세종대왕 동상, 묵은 때 벗겨내고 깨끗한 봄맞이 사북항쟁 시기 국가폭력에 대한 공식 사과 이행 촉구 사북사건 피해자 및 유가족 기자회견 또 '선서 거부'한 박상용 검사 조국, 평택을 재선거 출마 선언... \"'국힘 제로' 실현할 것\" 독자의견0 Please activate JavaScript for write a comment in LiveRe."},{"title":"국민의힘 세종시의원 경선…김충식·김학서·양진호 공천 확정","link":"https://www.fnnews.com/news/202604091038010700","source":"Bing"}]},{"id":"member_이순열","name":"이순열","party":"더불어민주당","district":"세종특별자치시제7선거구","imageUrl":"https://cpmadang.org/sites/default/files/thumbnail.100160431.JPG","bio":"경북대학교 행정학과 졸업 (전) 세종특별자치시의회 의장\n(현) 세종특별자치시의회 의원","electionDate":"2026-06-03T00:00:00.000","term":1,"achievementsList":["경북대학교 행정학과 졸업 (전) 세종특별자치시의회 의장\n(현) 세종특별자치시의회 의원"],"actions":[],"policies":[],"pressReports":[{"title":"[뉴스] 더불어민주당 이순열 후보, 주요 공약 발표","url":"https://example.com/news/이순열_article","source":"모의 뉴스","publishedAt":"2026-04-20T03:56:26.008Z"}],"sourceUrl":"https://cpmadang.org/taxonomy/term/83820","crawledDate":"2026-04-19T22:11:00.570Z","confidence":0.9,"rawText":"2026년 9대 전국지방동시선거\n  세종\n\n    \n    \n        \n        \n\n\n      \n        더불어민주당\n        \n                                        \n                \n                \n          이순열(李順烈)\n          \n          ","analysis":"세종시의회 의정활동 1년여 넘긴 민주당 이순열 의원 “초심을 잃지 말자”\n\n세종시의회 김현옥·박란희·이순열 의원, 대한민국 미래 '제21대 대선' 사전투표...“29일·30일”\n\n이순열 세종시의원, '의정보고회' 찍고 7선거구 정조준\n\n이순열 세종시의원 후보 “도담동 든든한 일꾼 될 것”\n\n이순열 세종시의장, 신년 기자간담회 열고 올해 의회 운영 방향 밝혀\n\n이순열 세종시의회 의장, 대한민국시도의회의장협의회 제7차 임시회 참석\n\n세종시의회 첫 여성 의장 '이순열 의원' 의정보고회…4년 의정 8천 장 사진 의미\n\n이순열 세종시의장 ‘지방자치법 개정 건의안' 만장 일치\n\n이순열 시의원 “의회 사전보고·인사청문회 제도화 촉구”\n\n이순열 세종시의원, 해양수산부 관련 발언 '도마위'\n\n민주당세종시당, 세종시의회 9선거구 보궐선거 이순열 씨 공천\n\n세종시의회 보궐선거 제9선거구 ‘이순열 ’ 당선\n\n4대 세종시의장 이순열·임채성, 나란히 시의원 3선 출사표","news":[{"title":"이순열 \"발로 뛴 4년, 이제는 친숙한 의원 되고파\"","link":"https://www.dtnews24.com/news/articleView.html?idxno=810440","source":"Bing","content":"기자명 권예진 기자 입력 2026.04.14 17:46 수정 2026.04.15 12:57 댓글 2 SNS 기사보내기 기사저장 카카오톡(으)로 기사보내기 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 URL복사(으)로 기사보내기 이메일(으)로 기사보내기 다른 공유 찾기 이 기사를 공유합니다 카카오톡(으)로 기사보내기 페이스북(으)로 기사보내기 트위터(으)로 기사보내기 URL복사(으)로 기사보내기 닫기 바로가기 본문 글씨 키우기 본문 글씨 줄이기 #article-view.default06 .article-more:hover {color:#e61d24} [인터뷰] 더불어민주당 이순열 예비후보(7선거구)\n\"찾아가는 의회, 민원상담소 통해 소통할 것\" 이순열 세종시의원이 대전충남녹색연합으로부터 받은 감사패를 들고 있다. 권예진 기자. 이순열 세종시의원(더불어민주당, 도담·어진)은 ‘발로 뛰는 시의원’으로 익히 알려져 있다. 환경, 노동, 청소년 등 지역사회 사각지대에 빨간불이 켜지면 어디라도 달려가 현장에서 목소리를 냈다. 그런 그가 이번 6·3 지방선거에 또 한 번 도전장을 내민다. 3대 의회부터 의장을 지낸 그에게는 이번이 세 번째 도전이다. 이 의원에게 세 번의 도전이 부담스러운 것도 사실이다. 그는 이번 출마 도전 이유에 대해 “경선부터 본선도 쉽지 않을 것을 안다. 개인적 목표보다는 구체화되는 행정수도 완성 속에서 도담동의 정체성을 확립하려 한다”고 의지를 다졌다. 이번 지방 선거에 도전하며 그가 추구하는 정치 지향점은 ‘친숙한 의원’이다. 찾아가는 마을 의회와 마을 상담소를 통해 시민이 체감할 수 있는 제대로된 의정 활동을 보여주고 싶다고. 현장형 의원에서 한발 더 나아가 친숙한 의원을 꿈꾸는 이순열 의원을 만나 그의 비전을 들어봤다. -4년간 의정활동을 돌아본다면. “4대 의회의 첫 시작부터 굳게 다짐했던 건 소통하는 시의원이었다. 꾸준한 소통을 통해 의회의 문턱을 낮추고 싶었다. 아무래도 시민이 직접 의회를 찾아오는 건 힘들 수 있다고 생각했고, 소통을 통해 주민의 생각을 알고 싶었다. 그래서 임기 내내 자율방범대 활동을 한 달에 한 번씩 꼭 참여해 이런저런 소통을 많이 했다. 그 시간동안 나눴던 대화들로 많은 조례를 발의하고 시민을 위한 의정활동을 해왔다고 느낀다. ” - 환경단체가 기후에너지환경부와 4대강 재자연화 추진에 대한 협의를 이뤄냈다. 처음 세종보 해체를 촉구하는 천막 농성을 시작할 때부터 관심이 많았는데, 어떤 심정인지 궁금하다. “집회 참석부터 같이 밤을 새기도 하며 700일이라는 시간을 함께했다. 가장 안도하는 건 천막 농성이 안전하게 마무리 된 점이다. 동시에 현 정부가 자본의 논리보다 생명의 가치를 더 중요하게 바라보고 있다는 점도 확인했다. 천막농성 해단식을 진행할 때 지난 2014년 세종보 인근에서 흙공을 던지던 사진이 떠올랐다. 그때는 악취로 눈이 따갑고 속이 메스꺼울 정도였다. 그랬던 강이 다시 힘차게 흐를 걸 생각하니 감회가 새롭다. 아직 해결해야 할 과제들이 남아 있지만, 정부와 함께 풀어나갈 수 있을 것이라 믿는다.” - 세종시의원 3선에 도전한다. 이에 따른 부담도 있을 것 같은데. “쉽지 않은 길이라는 것은 잘 알고 있다. 다만 개인적인 성장보다는 제가 맡고 있는 도담동의 정체성을 확립해야 한다는 책임감이 더 크게 다가왔다. 세종은 2030년이면 행정수도 완성 단계에 접어든다. 그때까지 재선 의원으로서 행정수도 완성을 위한 마무리를 해내야 한다는 책임감을 느꼈다. 이를 위해서는 처음부터 모든 것을 다시 배우는 초선 의원보다는, 그동안의 경험을 바탕으로 성과를 만들어낼 수 있는 검증된 의원이 필요하다고 생각했다. 이게 3선 도전에 나선 가장 큰 이유다.” 인터뷰 질문에 대답하고 있는 이순열 세종시의원. 권예진 기자. -청소년 조례와 관련해 관심이 많은 걸로 안다. 재선에 성공한다면 추진하고 싶은 또 다른 조례나 사업이 있는지. “세종의 청소년은 대부분 타지역에서 이주해 온 경우가 많아 지역에 정을 붙일 기회가 부족하다. 반면 부모들은 공무원이 대다수라 자녀의 일탈을 우려하는 분위기가 있다. 그래서 청소년들이 마음껏 도전하고 활동할 수 있는 공간과 기회를 마련해주는 것이 중요하다. 재선에 성공한다면 복합커뮤니티센터를 활용해 성인 자치 프로그램처럼 청소년들이 직접 참여하고 활동할 수 있는 프로그램을 확대하고 싶다. 또 꿈끼카드도 보다 실용적으로 활용될 수 있도록 사용처 확대 방안을 검토해 볼 계획이다.” -마지막으로 하고 싶은 말이 있다면. “지방자치가 시행된 지 30년이 지났지만, 여전히 지자체는 강한 단체장 중심 구조이고, 의회는 상대적으로 약한 위치에 머물러 있다. 의회의 본래 역할은 집행부를 병렬적으로 감시하고 견제하는 데 있다. 그것이 곧 시민이 목소리를 대변하는 일이다. 이와 함께 또 한 번 시민의 선택을 받는다면 소통하는 의원에서 더 나아가 ‘친숙한 의원’이 되고 싶다. 정기적인 마을 의회, 마을 상담소를 통해 민원인과 소통하려 한다. 집행부 감시부터 적극적 민원 수용까지 피부로 체감되는 의정활동을 펼치는 의원이 되고 싶다.” 권예진 기자 kwonyj2755@daum.net 기자의 다른기사 키워드 #이순열\n#세종시의원\n#지방선거\n#3선\n#세종보\n#청소년\n#의정활동\n#지방자치\n#집행부\n#협치\n#더불어민주당\n#도담\n#어진 저작권자 © 디트NEWS24 무단전재 및 재배포 금지 #AD172352833971.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD172352833971.ad-template .col { text-align:center; }\n#AD172352833971.ad-template .col .ad-view { position:relative; } /**************************************************\n*\tCOMMENT SKIN FILE\n*\n*\tAUTHOR\t: SOHO (for ndsoft)\n*\tFILE\t: /fine_home/comment/skin/skin01/_style.css\n*\tINCLUDE : /fine_home/comment/skin/skin01/_comment.html\n*\tNOTE\t:\n*\n**************************************************/\n/* layout */\n#comment {display:block;margin:2.5rem auto}\n[data-whatintent=\"touch\"] #comment button, [data-whatintent=\"touch\"] #comment button:focus {outline:0} /* titles */\n.cmt-header::after {content:'';display:table;clear:both}\n.cmt-header .titles {float:left;font-size:1.25rem;font-weight:normal;line-height:35px;color:#000}\n.cmt-header .comment-count {font-weight:bold}\n.cmt-header .my-cmt {float:right;font-size:.875rem;line-height:35px;color:rgba(0,0,0,.95)}\n.cmt-header .my-cmt > i[class^=\"icon-\"] {display:inline-block;overflow:hidden;width:15px;height:15px;font-size:.5rem;line-height:13px;color:#000;border:1px solid rgba(0,0,0,.5);border-radius:50%;text-align:center;vertical-align:middle} /* write */\n.comment-write {display:block;overflow:hidden;margin-bottom:2.1875rem;background-color:#fff;border:1px solid rgba(0,0,0,.25);border-radius:.3125rem}\n.comment-write .wrt-header {display:block;padding:1.25rem}\n.comment-write .wrt-header::after {content:'';display:table;clear:both}\n.comment-write .user-name {float:left;font-size:.9375rem;line-height:28px}\n#comment-guest {float:right;font-size:0;white-space:nowrap}\n#comment-guest input[type=\"text\"], #comment