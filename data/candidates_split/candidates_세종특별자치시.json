 닫기 $(document).ready(function(e) { $('.scrap-btn').on('click', function(e) { var idxno = $(this).data('idxno'); if(confirm(\"기사를 스크랩 하시겠습니까?\")){ $.ajax({ type: 'post', dataType: 'json', url: '/news/articleScrap.ajax.php', data: {'tp':'A', 'idxno':idxno}, success: function(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } });\n}); 5명 후보 합동연설회…\"이재명 정부 시험대\" 본선 전초전 더불어민주당 세종시장 예비후보 합동연설회. 사진 왼쪽부터 고준일 전 세종시의회 의장, 이춘희 전 세종시장, 조상호 전 세종시경제부시장, 홍순식 충남대 겸임교수, 김수현 민주당 당 대표 특보. 민주당 유튜브 채널 화면 더불어민주당 세종시장 후보 경선이 합동연설회를 시작으로 본궤도에 올랐다. '행정수도 완성'을 둘러싼 해법 경쟁과 세종 미래 비전 대결이 동시에 점화됐다. 민주당은 1일 서울 당사에서 본경선 후보 5인을 대상으로 온라인 합동연설회를 열고 본격적인 경선 일정에 돌입했다. 경선에는 고준일 전 세종시의회 의장, 이춘희 전 세종시장, 조상호 전 세종시 경제부시장, 홍순식 충남대 겸임 부교수, 김수현 민주당 당대표 특보(기호순) 등이 참여한다. 이날 연설회는 후보들의 단순 소개를 넘어 '행정수도 완성 방식'을 둘러싼 노선 경쟁 성격이 뚜렷했다. 후보들 모두 이재명 정부와의 연계성을 강조했으나, 접근법에서는 뚜렷한 차이를 드러냈다. 조상호 예비후보는 '과거와 미래의 대결'을 전면에 내걸며 세대교체와 실행력을 강조했다. 행정수도 특별법 제정과 산업·일자리 중심 자족도시 구축을 핵심 축으로 제시했다. #AD167945983919.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD167945983919.ad-template .col { float:left; text-align:center; width:50%; }\n#AD167945983919.ad-template .col .ad-view { position:relative; } googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591652277-0'); }); googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591665792-0'); }); 홍순식 예비후보는 재정 위기를 전면에 부각하며 세종을 '정책 실패'로 규정했다. 국가 책임 강화와 단계적 입법 전략을 제시하고, 행정수도특별법 지연과 관련해 현실적 입법 접근 필요성을 강조했다. 고준일 예비후보는 세대교체와 현장 중심 정치를 내세웠다. '기다리는 도시에서 실행하는 도시로의 전환'을 강조하며 40대 리더십과 산업·의료·교통 전반의 구조 개선 필요성을 제시했다. 이춘희 예비후보는 검증된 행정 경험을 전면에 내세웠다. 향후 4년을 '행정수도 완성의 골든타임'으로 규정하며 대통령 집무실·국회 이전과 연계한 도시계획 추진을 핵심 과제로 제시했다. 김수현 예비후보는 개혁성과 운동권 출신 이력을 강조했다. 행정수도 완성을 실행의 문제로 규정하며 개헌과 특별법 병행 추진, 자족경제·문화·복지 확대 구상을 제시했다. 후보들은 '행정수도 완성'이라는 큰 틀에서는 공감대를 형성했지만, 세부적인 방법론에서는 △특별법 일괄 추진 △단계적 입법 △도시 기능 확장 △재정 구조 개편 등 입장이 갈렸다. 정치권에서는 이번 경선을 \"이재명 정부 초기 국정 동력을 가늠할 시험대\"로 보고 있다. 세종시가 행정수도로서 상징성이 큰 도시인만큼, 실제로 후보들은 \"정권 성패를 가를 선거\"라는 점을 강조하며 결집을 호소했다. 민주당은 오는 3일 합동 토론회를 거쳐 4일부터 6일까지 본경선을 실시한다. 권리당원 투표 50%와 일반 여론조사 50%를 합산하는 방식이다. 과반 득표자가 없을 경우 상위 1, 2위 후보를 대상으로 14일부터 16일까지 사흘간 결선 투표가 이어진다. 지역 정가에서는 다자 구도 특성상 결선 가능성에 무게를 두고 있다. 결국 본선 경쟁력과 함께 '행정수도 완성의 현실적 해법'을 누가 설득력 있게 제시하느냐가 경선 승부를 가를 핵심 변수로 작용할 전망이다. 곽우석 기자 wooskw@daejonilbo.com 다른 기사 보기 + 구독 저작권자 © 대전일보 무단전재 및 재배포 금지 #AD168075932066.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD168075932066.ad-template .col { text-align:center; }\n#AD168075932066.ad-template .col .ad-view { position:relative; } googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591683971-0'); }); /**************************************************\n*\tCOMMENT SKIN FILE\n*\n*\tAUTHOR\t: SOHO (for ndsoft)\n*\tFILE\t: /fine_home/comment/skin/skin01/_style.css\n*\tINCLUDE : /fine_home/comment/skin/skin01/_comment.html\n*\tNOTE\t:\n*\n**************************************************/\n/* layout */\n#comment {display:block;margin:2.5rem auto}\n[data-whatintent=\"touch\"] #comment button, [data-whatintent=\"touch\"] #comment button:focus {outline:0} /* titles */\n.cmt-header::after {content:'';display:table;clear:both}\n.cmt-header .titles {float:left;font-size:1.25rem;font-weight:normal;line-height:35px;color:#000}\n.cmt-header .comment-count {font-weight:bold}\n.cmt-header .my-cmt {float:right;font-size:.875rem;line-height:35px;color:rgba(0,0,0,.95)}\n.cmt-header .my-cmt > i[class^=\"icon-\"] {display:inline-block;overflow:hidden;width:15px;height:15px;font-size:.5rem;line-height:13px;color:#000;border:1px solid rgba(0,0,0,.5);border-radius:50%;text-align:center;vertical-align:middle} /* write */\n.comment-write {display:block;overflow:hidden;margin-bottom:2.1875rem;background-color:#fff;border:1px solid rgba(0,0,0,.25);border-radius:.3125rem}\n.comment-write .wrt-header {display:block;padding:1.25rem}\n.comment-writ