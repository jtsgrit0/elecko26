에 조상호 최종 확정 더불어민주당이 6.3 지방선거 세종특별자치시장 후보로 조상호 전 세종시 경제부시장을 최종 확정했습니다.\n민주당 소병훈 중앙당 선거관리위원장은 오늘(16일) 민주당 당사에서 이 같은 세종시장 결선 개표 결과를 발표했습니다.\n이로써 세종시장 선거는 민주당 조 후보와 현직 세종시장인 국민의힘 최민호 후보, 조국혁신당 황운하 후보의 3파전으로 치러질 전망입니다.\n#더불어민주당 #지방선거\n연합뉴스TV 기사문의 및 제보 : 카톡/라인 jebo23\n홍서현(hsseo@yna.co.kr) 제보는 카카오톡 okjebo <저작권자(c) 연합뉴스,\n무단 전재-재배포, AI 학습 및 활용 금지> 2026/04/16 21:23 송고\n2026년04월16일 21시23분 송고 #더불어민주당 #지방선거 댓글 좋아요 슬퍼요 화나요 후속요청 <button type=\"button\" class=\"btn-type300 style20 arr01\" data-pop-open=\"pop-comment\" data-stat-code=\"article_comment01\"> {{#if IS_COUNT}} <span class=\"bold color21\">{{COUNT_TEXT}}</span> <span class=\"txt01\">개 댓글 전체보기</span> {{else}} <span class=\"txt01\">댓글 작성하기</span> {{/if}} </button> 국내 최대 원스톱 콘텐츠 제공 플랫폼 함께 보면 좋은 콘텐츠 by\n데이블 window['dablewidget_OoRAgyMX'] = function(){ (function(d,a,b,l,e,r) { if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l); e.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js'; r=a.getElementsByTagName(l)[0];r.parentNode.insertBefore(e,r); })(window,document,'dable','script'); dable('setService', 'yna.co.kr'); dable('sendLogOnce'); dable('renderWidget', 'dablewidget_OoRAgyMX');\n} 광고 window['div-gpt-ad-1587522573500-0'] = function(){ googletag.cmd.push(function() { googletag.defineSlot('/21961356670/korean_pc_web_article_body_bottom1_btf_300x250_200417', [300, 250], 'div-gpt-ad-1587522573500-0').addService(googletag.pubads()); googletag.display(\"div-gpt-ad-1587522573500-0\"); }); } window['div-gpt-ad-1589789760428-0'] = function(){ googletag.cmd.push(function() { googletag.defineSlot('/21961356670/korean_pc_web_article_body_bottom2_btf_300x250_200518', [300, 250], 'div-gpt-ad-1589789760428-0').addService(googletag.pubads()); googletag.display('div-gpt-ad-1589789760428-0'); }); } 함께 읽기 좋은 콘텐츠 Taboola 후원링크 window['taboola-below-article-widget_08162024-pc'] = function(){ window._taboola = window._taboola || []; _taboola.push({ mode: 'thumbs-feed-2x4', contain