여하며 실제 권한이 작동되는 모델을 구축하고 있다\"고 했다.그러면서 \"세종시당은 경선 이후 승자가 먼저 손을 내밀고 패자가 수용하는 승복 문화를 제도화할 것이다. 통합으로 이어지는 공천을 만들 것\"이라며 \"중앙당 기조에 세종시당이 부흥해 경쟁력 있는 후보를 통해 지방선거 압승으로 보답할 것\"이라고 부연했다. 김동민 기자kdm9622@naver.com 좋아요 좋아요 0 슬퍼요 슬퍼요 0 화나요 화나요 0 후속기사 원해요 후속기사 원해요 0 ⓒ 아시아투데이, 무단전재 및 재배포 금지 기사제보 후원하기 window.livereOptions = { refer: 'www.asiatoday.co.kr/kn/view/20260327010008392', site: 'https://www.asiatoday.co.kr/kn/view.php?key=20260327010008392' }; (function(d, s) { var j, e = d.getElementsByTagName(s)[0]; if (typeof LivereTower === 'function') return; j = d.createElement(s); j.src = 'https://cdn-city.livere.com/js/embed.dist.js'; j.async = true; e.parentNode.insertBefore(j, e); })(document, 'script'); 라이브리 댓글 작성을 위해 JavaScript를 활성화해주세요 (function(d,a,b,l,e,r){if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l);e.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js';r=a.getElementsByTagName(l)[0];r.parentNode.insertBefore(e,r)})(window,document,'dable','script');dable('setService','asiatoday.co.kr');dable('sendLogOnce');dable('renderWidget','dablewidget_xXAg1pB7'); #jcg_wrap iframe:nth-child(1){margin-right:30px} #jcg_wrap iframe:nth-child(2){margin-left:30px} 많이 본 뉴스 1 K-수학, 베트남으로 간다 2 NH투자증권, 단독대표서 각자대표로…지배구조 전환 3 “핵심 빠졌다” 비판 쇄도…안성재 모수 서울 사과문에 여론 악화 4 李대통령 “오래 투자했다고 양도세 깎아주는 건 ‘주택투기권장정책’” 5 美 세 번째 항공모함, 이란 해역 도착…트럼프 협상 압박 강화 6 기아 타이거즈 5연패 속 박재현 국민의례 태도 논란 확산 7 위성락 “쿠팡 문제, 한미 안보협의에 영향 주는 것 사실…美와 논의중” (function(d,a,b,l,e,_){if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l);e.async=1;e.charset=\"utf-8\";e.src=\"//static.dable.io/dist/plugin.min.js\";_=a.getElementsByTagName(l)[0];_.parentNode.insertBefore(e,_);})(window,document,\"dable\",\"script\");dable(\"setService\", \"asiatoday.co.kr\");dable(\"sendLogOnce\");dable(\"renderWidget\", \"dablewidget_y74j8YXV\"); 지금 뜨는 뉴스 1 “잠 못자 판단력 저하” 철도 관제사 호소…3조 2교대 잔혹사 2 “나는 얼마나 받을까” 고유가 피해지원금 27일부터 접수 3 아파트 복도에 ‘개인 헬스장’ 차려…위급시 대피 어