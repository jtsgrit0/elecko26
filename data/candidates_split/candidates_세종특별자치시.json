on(data) { alert(data[1]); }, error: function(error, request) { alert('error!!!'); console.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error); } }); } });\n}); 최민호 17.6%·조상호 16.4%·김수현·이춘희 15.3%\n민주 경선 '3강 구도'…교육감 선거도 3파전 대전일보DB 6·3 지방선거를 앞둔 세종시장 선거가 안갯속 국면이다. 현직인 국민의힘 최민호 세종시장과 더불어민주당 후보 등 상위 4명이 오차범위 내 치열한 접전을 펼치는 것으로 조사됐다. 대전일보가 여론조사 업체 한길리서치에 의뢰해 지난 8-9일 이틀간 세종시에 거주하는 만 18세 이상 남녀 809명을 대상으로 세종시장 여야 후보 적합도를 조사한 결과 최민호 세종시장이 17.6%의 지지를 얻었다. 이어 조상호 전 더불어민주당 당대표 정무조정실장 16.4%, 김수현 더불어민주당 당대표 특보 15.3%, 이춘희 전 세종시장 15.3% 순으로 나타났다. 또 황운하 조국혁신당 국회의원 8.1%, 고준일 전 세종시의회 의장 4.4%, 홍순식 충남대 겸임부교수 3.0%로 집계됐다. '적합 후보 없음'은 6.5%, '잘 모르겠다'는 응답은 11.3%였다. #AD167945983919.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD167945983919.ad-template .col { float:left; text-align:center; width:50%; }\n#AD167945983919.ad-template .col .ad-view { position:relative; } googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591652277-0'); }); googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591665792-0'); }); 민주당 내부 경쟁은 치열한 '3파전' 양상이다. 민주당 후보 중 세종시장 후보 적합도를 묻는 질문에서는 조상호 전 더불어민주당 당대표 정무조정실장이 21.2%, 이춘희 전 세종시장이 20.6%, 김수현 더불어민주당 당대표 특보가 18.0%로 선두권을 형성했다. 이어 고준일 전 세종시의회 의장 9.1%, 홍순식 현 충남대 겸임부교수 3.0% 순이었다. 상위 3명이 오차범위 내 박빙 승부를 보이며 경선이 '3강 구도'로 전개될 가능성이 커졌다. 향후 민주당과 조국혁신당의 선거 연대 여부가 변수로 작용할지도 주목된다. 세종시교육감 선거도 '1강 없는 혼전' 구도다. 교육감 후보 적합도 조사에서는 임전수 세종교육연구원장이 12.9%, 유우석 전 해밀초 교장 12.6%, 강미애 세종미래교육연구소장 12.4% 순으로 조사됐다. 이어 원성수 전 국립공주대 총장 9.4%, 안광식 세종교육희망연구소 대표 6.7%, 김인엽 국립공주대 교수 5.3% 가 뒤를 이었다. 상위 3명이 오차범위 내 접전을 벌이는 모습으로, 후보 단일화 여부가 판세를 좌우할 핵심 변수로 꼽힌다. 정당 지지도 조사에서는 더불어민주당이 52.5%로 과반 지지를 기록했고 국민의힘 18.5%, 조국혁신당 3.6%, 개혁신당 2.5%, 진보당 2.3% 순으로 나타났다. 이재명 대통령 국정수행 평가에서는 '잘하고 있다'는 응답이 68.7%, '잘못하고 있다'는 응답이 26.9%로 긍정 평가가 부정 평가를 두 배 이상 웃돌았다. 행정수도 완성을 위한 최우선 과제로는 '국회의사당 및 대통령 집무실 세종 완전 이전'이 55.2%로 가장 높았다. 이어 '행정수도 명문화 개헌' 11.5%, '교통망 확충' 10.7%, '중앙행정기관 추가 이전' 8.1%, '정주여건 강화' 5.7% 순이었다. 이번 조사는 ARS 조사(무선 전화 가상번호 100%) 방식으로 실시됐다. 2026년 1월 말 행정안전부 주민등록 인구 기준 성·연령·지역별 가중값을 부여했으며 표본오차는 95% 신뢰수준에서 ±3.4%p다. 자세한 내용은 중앙선거여론조사심의위원회 홈페이지를 참조하면 된다. 이번 여론조사는 세종시에 거주하는 만 18세 이상 남녀 809명을 대상으로 구조화된 설문지를 통한 자동응답(ARS) 방식을 통해 진행됐다. 표본구성은 무선 전화 가상번호 100%이며, 표본추출방법은 성별·연령대별·지역별 할당 무작위 추출이다. 응답률은 6.5%이며, 표본오차는 95% 신뢰수준에서 ±3.4%포인트다. 자세한 내용은 중앙선거여론조사심의위원회 누리집에서 확인하면 된다. <조사개요> △조사의뢰: 대전일보 △조사일시: 2026년 3월 8-9일(2일간) △조사기관: ㈜한길리서치 △조사지역 및 대상: 세종특별자치시에 거주하는 만 18세 이상 남·녀 △조사내용: 세종시장 여야 적합도, 시교육감 적합도, 행정수도 과제 등 △조사방법: 가상번호 활용 무선 100% ARS △표본오차: 95% 신뢰수준에서 ±3.4%포인트 △응답률: 6.5% △피조사자 선정방법: 성/연령/지역별 할당 무작위 추출 △가중치 산출 및 적용 방법: 2026년 1월 말 행정안전부 주민등록 인구 기준 성/연령/지역별 가중값 부여(림가중) * 세종시장 선거 여론조사 결과는 세종시 거주 만 18세 이상 남·여 대상에서 2026년 1월 말 행정안전부 주민등록인구 기준으로 성/연령/지역별 가중치를 부여(림가중)한 결과이며, 그 밖의 사항은 중앙선거여론조사심의위원회 홈페이지(www.nesdc.go.kr) 참조 곽우석 기자 wooskw@daejonilbo.com 다른 기사 보기 + 구독 관련기사 세종시민 정당 지지도, 민주 52.5% vs 국힘 18.5% [대전일보 여론조사]\n세종시민 “행정수도 완성 1순위는 국회·대통령실 이전” [대전일보 여론조사]\n세종시장 민주당 경선 혼전…'3강 압축' 속 접전 [대전일보 여론조사]\n세종교육감 임전수·유우석·강미애 초접전…'단일화' 최대 변수 [대전일보 여론조사]\n이재명 대통령 국정수행 평가 ‘잘함’ 68.7% vs ‘잘못함’ 26.9% [대전일보 여론조사]\n'안갯속' 세종시장 선거… 최민호 17.6%, 조상호 16.4%, 김수현·이춘희 15.3% [대전일보 여론조사] 저작권자 © 대전일보 무단전재 및 재배포 금지 #AD168075932066.ad-template { margin:auto; position:relative; display:block; clear:both; z-index:1; }\n#AD168075932066.ad-template .col { text-align:center; }\n#AD168075932066.ad-template .col .ad-view { position:relative; } googletag.cmd.push(function() { googletag.display('div-gpt-ad-1680591683971-0'); }); /**************************************************\n*\tCOMMENT SKIN FILE\n*\n*\tAUTHOR\t: SOHO (for ndsoft)\n*\tFILE\t: /fine_home/comment/skin/skin01/_style.css\n*\tINCLUDE : /fine_home/comment/skin/skin01/_comment.html\n*\tNOTE\t:\n*\n**************************************************/\n/* layout */\n#comment {display:block;margin:2.5rem auto}\n[data-whatintent=\"touch\"] #comment button, [data-whatintent=\"touch\"] #comment button:focus {outline:0} /* titles */\n.cmt-header::after {content:'';display:table;clear:both