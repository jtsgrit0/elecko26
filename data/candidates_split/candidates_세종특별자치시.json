t300, 300);line-height:1.625;color:#000;border:none}\n.comment-write .recaptcha-container {display:block;font-size:0;text-align:center}\n.comment-write .recaptcha-container .recaptcha-view {display:inline-block;margin:0 auto 1rem}\n.comment-write .wrt-footer {display:block;padding:.375rem 1.25rem;border-top:1px solid rgba(0,0,0,.08)}\n.comment-write .wrt-footer::after {content:'';display:table;clear:both}\n.comment-write .wrt-footer .cur--length {float:left;font-size:.75rem;font-weight:300;font-weight:var(--wgt300, 300);line-height:32px;color:#989898}\n.comment-write .wrt-footer .comment-text-cur {color:#000}\n.comment-write .wrt-footer .btn-comment-save {float:right;height:32px;padding:0 1.125rem;font-size:.8125rem;line-height:1;color:#fff;border-radius:.25rem;background-color:#68A4DF;cursor:pointer}\n@media screen and (max-width: 39.9375em) { .row .comment-write .user-name, .row #comment-guest {float:none;width:auto} .row .comment-write .user-name {display:block;margin-bottom:.375rem} .row .comment-write .btn-comment-login {text-decoration:underline} .row .comment-write .btn-comment-login::before {content:\"\\e9f5\";display:inline-block;margin-right:.375rem;font:14px/1 fontello;font-size:inherit;text-rendering:auto;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale} .row #comment-guest input[type=\"text\"], .row #comment-guest input[type=\"password\"] {width:calc(50% - .125rem)} .row .comment-write .comment-content {min-height:80px;font-size:.875rem} .row .comment-write .recaptcha-container {overflow:hidden;max-width:100%}\n} /* list */\n#comment-list {display:block}\n#comment-list .list-sort {margin-bottom:1.5rem;border-bot"},{"title":"안광식, '세종국제영어마을' 조성…\"공교육 중심 영어교육 혁신\"","link":"https://www.msn.com/ko-kr/news/other/%EC%95%88%EA%B4%91%EC%8B%9D-%EC%84%B8%EC%A2%85%EA%B5%AD%EC%A0%9C%EC%98%81%EC%96%B4%EB%A7%88%EC%9D%84-%EC%A1%B0%EC%84%B1-%EA%B3%B5%EA%B5%90%EC%9C%A1-%EC%A4%91%EC%8B%AC-%EC%98%81%EC%96%B4%EA%B5%90%EC%9C%A1-%ED%98%81%EC%8B%A0/ar-AA21ydVF?ocid=BingNewsVerp","source":"Bing"},{"title":"안광식 세종교육감 후보 ‘세종국제영어마을 조성’ 약속","link":"https://www.msn.com/ko-kr/news/other/%EC%95%88%EA%B4%91%EC%8B%9D-%EC%84%B8%EC%A2%85%EA%B5%90%EC%9C%A1%EA%B0%90-%ED%9B%84%EB%B3%B4-%EC%84%B8%EC%A2%85%EA%B5%AD%EC%A0%9C%EC%98%81%EC%96%B4%EB%A7%88%EC%9D%84-%EC%A1%B0%EC%84%B1-%EC%95%BD%EC%86%8D/ar-AA21xoJv?ocid=BingNewsVerp","source":"Bing"},{"title":"[인터뷰] 안광식 세종시교육감 예비후보","link":"http://www.ygnews.net/news/articleView.html?idxno=58756","source":"Bing","content":"▲안광식 세종시교육감 예비후보가 2일 대평동 선거사무소에서 세종매일과 인터뷰를 하고 있다. 안광식 세종시교육감 예비후보와의 인터뷰를 위해 지난 2일 대평동 선거사무소를 방문한 첫 인상은 ‘단출하다’는 것이었다. 북적되진 않지만 단단한 소수정예. 그리고 신속하나 그리 가볍지 않은 느낌이었다. 어찌보면 당연하겠지만 안광식 후보와 대화에서도 그 색깔이 묻어나 교육에 대한 강한 신념과 철학 그리고 유연성이 돋보였다. 이를 반영하듯 안 후보는 교육감 당선시 추진할 최우선 정책으로 학생교육수당을 제시했다. 이 부분은 다소 의외였는데 그만큼 정책 중요성과 확신을 가진 듯 했다. 안 후보는 “학생교육수당을 최우선적으로 선정한 이유는 세종교육의 문제점인 학력문제 그 다음에 정서적인 문제 그리고 학생 진로 문제를 한꺼번에 해결할 수 있는 유일한 정책이기 때문”이라고 강조했다. 이 사업의 매력적인 부분으로 학생과 학부모들의 교육 참여 확대를 언급했다.\n안 후보는 “학부모들이 학생과 함께 진로 체험과 학습을 할 수 있는 그런 예산”이라며 “어떻게 보면 교육청 사업을 줄이고 학부모들에게 이 사업에 직접 참여할 수 있는 기회를 드리는 것”이라고 설명했다. 예산 관련해 전체적으로 교육청 예산이 부족하지만 예산이 여유가 있을 때는 방만하게 집행되는 부분도 있다고 지적했다. 안 후보는 “유보금을 1년에 천억 원 이상 이월해서 넘길 때도 있다”며 “그런 예산들을 많이 쓰다보니 사업 규모가 커졌고 업무 꼭지 수가 많아졌다”고 말했다. 그러면서 “그런 것들이 실제 학생 성장에 도움을 주는지는 잘 모르겠다. 효과 검증이 부족했다”며 효율적인 사업 수립 및 예산 집행을 강조했다. 그는 특히 교육청 인사에 대해 강한 톤으로 비판하며 인사 공정성을 거듭 강조했다. 안 후보는 “특정 대학 라인이 세종교육 인사를 좌지우지하면서 교사들, 전문직들이나 교장들의 사기를 많이 떨어뜨렸다. 그런 부분은 분명히 짚고 넘어가야 된다”고 경고했다. 그러면서 “최교진 장관 인사청문회에서도 나왔지만 ‘취중 인사’라고 할 정도로 인사 부분은 그 특정 대학의 라인에서 인사 문제를 꽉 잡고 있다”며 “형평성이나 공정성은 많이 결여됐다고 본다”고 주장했다. 한 전직 교장이 그 라인을 없애달라고 호소한 사실을 소개하며 “내가 당선되면 그 라인은 분명히 잡고 간다”고 단언했다. 안 후보는 끝으로 “약속을 실천으로, 현장의 변화를 끝까지 책임지는 사람, 그리고 우리 아이들의 오늘과 내일을 함께 고민하는 교육감을 향한 여정에 우리 시민들과 함께 하겠다”고 말했다. 다음은 안광식 세종시교육감 예비후보와의 일문일답이다. ▲안광식 후보가 대화를 나누며 잠시 웃음을 짓고 있다. ■교육감 선거가 60여 일 남았다. 발로 뛰며 느낀 선거 분위기는. 그 어느 때보다도 교육에 대한 관심과 기대가 높아졌다는 점이 가장 크게 와닿는다. 단순한 이념이나 구호보다는, 우리 아이들의 미래를 위해 어떤 교육을 실현할 수 있는지에 대한 구체적인 비전과 실행력이 중요한 판단 기준이 되고 있다. “실제로 바뀌는 교육”, “아이들이 체감할 수 있는 변화”를 강하게 원한다. 아울러 후보들과 관련해 진보와 보수 진영 문제, 예비후보 전과기록에서 드러난 공동폭행 등 교사로서 준법성 결여 문제, 장학사 선발 비리관련 문제, 초·중등교육에 대한 전문성 부족 등이 관심사인 것 같다. ■시민들은 어떤 교육감을 원하나. ‘말만 하는 교육감’이 아니라 ‘실제로 변화를 만들어내는 교육감’이라고 생각한다. 특히 세종시는 학령인구 증가와 학교 신설 등 교육 여건 변화가 빠른 도시로, 행정 경험과 추진력을 갖춘 ‘강한 교육감’이 요구된다. 또 현장의 어려움을 제대로 이해하고, 교사·학생·학부모와 꾸준히 소통하면서 문제를 해결해 나갈 수 있는 리더십도 필요하다. 이를 기반으로 성적 중심 교육을 넘어선 기초학력 보장, 정서 지원, 그리고 미래 역량까지 균형 있게 키워주는 교육이 가능하다. 아울러 특정 진영이나 이념 대립보다는 아이들의 성장과 배움을 최우선에 두고 합리적으로 판단하는 ‘균형 잡힌 교육감’을 원한다. 결국 시민들께서 바라는 교육감, 세종교육은 분명하다.\n저 안광식이 시민들과 함께 우리 모두가 원하는 ‘세종교육’ 실현을 위해 함께 하겠다. ▲안광식 후보가 인터뷰를 하며 세종교육 발전을 위한 주요 공약에 대해 말하고 있다. ■세종교육의 문제점은 무엇이라 생각하나. 세종교육의 가장 큰 문제는 학력 향상에 대한 체감도 저하와 진학 경쟁력에 대한 불안이다. 이는 크게 세 가지로 정리할 수 있는데 우선, 데이터와 지표가 부족한 ‘불투명한 교육’이다. 학생의 학업 수준과 부족한 부분을 객관적으로 확인할 수 있는 진단과 피드백 체계가 미흡해, 학생과 학부모는 자신의 위치를 정확히 알지 못한 채 불안 속에서 학습 방향을 결정하고 있다. 둘째, 공교육이 입시와 진학을 충분히 뒷받침하지 못하고 있다. 이는 사교육 의존도를 높여, 학부모의 경제력 차이가 곧 학생의 교육격차라는 의미로 심각한 사회 문제다. 마지막으로 추상적인 교육 철학은 실질적인 성과를 낳기 힘들다.\n현장에서는 이해하기 어려운 담론보다 성적 향상과 진로에 직접 도움이 되는 구체적인 지원이 필요하다. 결국 이런 문제들로 학력 향상이라는 교육의 기본 기능이 약화돼 세종교육에 대한 신뢰 역시 흔들리고 있다. ■앞서 언급한 것처럼 사교육은 공교육에 대한 불신이 반영됐다. 세종교육의 학력 개선 및 증진 방안은. 우리 세종의 아이들이 세계 무대에서 당당히 경쟁할 수 있도록 실용적 학력 향상을 위한 두 가지 핵심 엔진을 가동하겠다. 먼저 글로벌 대입 경쟁력을 확보하기 위해 ‘IB교육(International Baccalaureate)과정’을 도입하고자 한다. 단순 암기 위주 교육이 아닌 질문하고 토론하며 스스로 해답을 찾는 IB 교육과정을 세종교육 현실에 맞게 도입해, 비판적 사고력과 문제 해결 능력을 국제 수준으로 끌어올릴 것이다. 이는 학생부 종합전형 등 수시 모집에서 세종 학생들만의 압도적인 진학 경쟁력을 만드는 강력한 무기가 될 것으로 확신한다. 둘째, 개인별 맞춤형 성장을 지원하는 ‘AI 활용 교육 시스템’을 전면 구축하겠다.\n모든 학생에게 똑같은 수준의 문제를 풀게 하는 과거의 방식에서 벗어나야 한다. 인공지능(AI) 기반의 진단 도구를 통해 학생 개개인의 취약점을 정밀하게 분석하고, 그에 맞는 맞춤형 학습 콘텐츠를 즉각 제공하겠다. 이를 통해 학습 결손은 빈틈없이 메우고, 우수한 학생에게는 심화 학습의 기회를 열어 줄 것이다. 마지막으로 이런 혁신을 뒷받침할 실질적 동력이 될 학생교육수당을 지급하겠다. IB 교육과 심화된 AI 교육을 받기 위해 필요한 고품질의 교육 자원, 교재, 온·오프라인 학습 콘텐츠를 학생들이 스스로 선택하고 활용할 수 있도록 학생교육수당을 통해 직접 지원하겠다. 이는 부모의 경제력 차이가 학력의 차이로 이어지지 않게 하는 든든한 버팀목이 될 것이다. 결론적으로, IB 교육을 통한 사고력의 질적 도약과 AI 기술을 활용한 개별 맞춤형 학력 증진, 그리고 이를 현실화할 학생교육수당의 결합으로 세종을 ‘대한민국 학력의 새로운 기준’이 되는 도시로 만들겠다. ▲안광식 후보. ■교육감으로 당선되면 최우선적으로 시행할 정책은. 단계적인 ‘학생교육수당’ 도입과 임기내 정착이다. 이 정책은 교육격차와 진로 기회 불균형, 그리고 학생들의 정서적 문제를 동시에 완화할 수 있는 가장 기본적이고 효과적인 교육 기반 정책이다. 아동수당을 받지 않는 초등학교 3학년부터 고등학교 3학년까지 모든 학생에게 교육수당을 지급해, 진로 체험과 다양한 학습 활동에 스스로 활용할 수 있도록 할 것이다. 단순한 지원을 넘어 학생의 학습 선택권 확대, 자기주도 학습 강화로 궁극적으로 학력 향상에도 기여하는 ‘학습 복지정책’이다. ■학생교육수당의 긍정적 효과에도 교육재정에 부담은 없는지. 학생교육수당은 일정 수준의 재정이 수반되는 정책인 것은 사실이다. 다만 단순한 비용이 아니라, 교육격차 해소와 학력 향상을 위한 ‘투자’의 관점에서 접근해야 한다고 본다. 먼저 재원은 새로운 재정을 무리하게 확대하기보다, 기존 예산의 구조를 재편하는 방식으로 마련하겠다. 현재 교육청 예산 내에서 진로체험, 방과후, 일부 복지성 사업 등 개별적으로 분산된 사업들을 통합하고 우선순위를 조정하면 상당한 재원을 확보할 수 있다. ‘사업 중심’ 예산에서 ‘학생 중심’ 예산으로 전환하는 과정이라고 본다. 또한 재정 부담을 최소화하기 위해 단계적으로 추진할 것이다. 학년별·학교급별로 순차적으로 확대해 연차별 재정 부담을 분산하고, 정책 효과도 검증하며 문제점을 개선해 나가겠다. 아울러 지방자치단체 및 지역사회와의 협력, 국비 사업과의 연계도 병행해 재원 기반을 다각화하고자 한다. 재정의 지속 가능성을 확보하면서도, 학생 한 명 한 명에게 직접 투자하는 방향으로 예산을 혁신하겠다. ■학교폭력 대응 및 교권 확립에 대한 방안은. 학교 교육 기능의 정상화를 위한 핵심 과제는 학교폭력 대응과 교권 확립이다. 예방-개입-회복이 선순환하는 체계 구축이 시급하다. 학교폭력 관련 사후 처벌 중심에서 예방과 조기 개입 중심으로 정책을 전환하겠다. 학생 정서·사회성 교육을 강화하고, 위기 징후를 조기에 포착할 수 있는 상담·지원 시스템을 고도화할 것이다. 갈등 조정 및 관계 회복 프로그램을 체계화해 단순한 처벌이 아닌 교육적 해결이 이뤄지도록 노력하겠다. 교권 확립은 교사의 정당한 교육활동이 보호받는 제도적 기반 강화가 중요하다. 교권 침해 발생 시 신속 대응이 가능한 지원 체계를 구축하고, 법률·행정적 지원을 통해 교사 부담을 최소화할 것이다. 아울러 과도한 행정업무를 경감해 교사가 수업과 생활지도에 집중할 수 있는 환경을 조성하겠다. 궁극적으로는 학생의 학습권과 교사의 교육권이 균형 있게 보장되는 학교, 그리고 신뢰와 책임이 작동하는 교육 생태계를 구축하는 데 정책의 초점을 두겠다. ■AI 시대 안광식표 AI 교육은 무엇인가. 안광식표 AI 교육의 가장 큰 특징은 ‘기술 중심’이 아닌 ‘학습 경험 중심’에 있다는 점이다. AI 교육을 하나의 별도 과목이 아니라, 모든 교과에서 활용되는 ‘학습 도구’로 설계하겠다. 예를 들어 학생이 AI를 활용해 사회 문제를 분석하거나, 과학 데이터를 해석하고, 스스로 해결 방안을 설계"},{"title":"안광식 세종시교육감예비후보 \"공교육 국제영어마을 추진\"","link":"https://www.msn.com/ko-kr/money/topstories/%EC%95%88%EA%B4%91%EC%8B%9D-%EC%84%B8%EC%A2%85%EC%8B%9C%EA%B5%90%EC%9C%A1%EA%B0%90%EC%98%88%EB%B9%84%ED%9B%84%EB%B3%B4-%EA%B3%B5%EA%B5%90%EC%9C%A1-%EA%B5%AD%EC%A0%9C%EC%98%81%EC%96%B4%EB%A7%88%EC%9D%84-%EC%B6%94%EC%A7%84/ar-AA21xaT5?ocid=BingNewsVerp","source":"Bing"},{"title":"안광식 세종교육감 출마 \"말이 아닌 결과로 평가받는 교육행정 실천할 것\"","link":"https://www.asiae.co.kr/article/2026012021263572286","source":"Bing"}]},{"id":"member_강미애","name":"강미애","party":"무소속","district":"세종특별자치시","imageUrl":"https://cpmadang.org/sites/default/files/thumbnail.100153756.JPG","bio":"고려대학교 행정전문대학원 박사과정 수료(정책학과) (전) 세종특별자치시교원단체총연합회 회장\n(전) 세종도원초등학교 교장","electionDate":"2026-06-03T00:00:00.000","term":1,"achievementsList":["고려대학교 행정전문대학원 박사과정 수료(정책학과) (전) 세종특별자치시교원단체총연합회 회장\n(전) 세종도원초등학교 교장"],"actions":[],"policies":[],"pressReports":[{"title":"[뉴스] 무소속 강미애 후보, 주요 공약 발표","url":"https://example.com/news/강미애_article","source":"모의 뉴스","publishedAt":"2026-04-20T04:10:29.140Z"}],"sourceUrl":"https://cpmadang.org/taxonomy/term/83820","crawledDate":"2026-04-19T22:32:33.680Z","confidence":0.9,"rawText":"2026년 9대 전국지방동시선거\n  세종\n\n    \n    \n        \n        \n\n\n      \n        무소속\n        \n                                        \n                \n                \n          강미애(姜美愛)\n          \n             ","analysis":"강미애 “보수 후보 아냐…정책으로만 승부 볼 것”\n\n강미애 소장, \"책임 있게, 제대로, 공정하게 세종교육 다시 시작\"...세종교육감 출마 공식화\n\n세종시교육감 선거 현수막 경쟁…강미애·안광식 이어 원성수까지\n\n강미애 세종시교육감 후보, 6.1 지방선거 후보자 등록 완료\n\n강미애, 학생 안전 · 교권 보호 통합 안전망 제안…“감지-대응-회복-예방 전주기 관리체계 구축”\n\n강미애 세종미래교육연구소 소장, 세종교육감 선거 출마 선언\n\n강미애 세종미래교육연구소 소장, 세종시교육감 출마 선언\n\n강미애 \"세종 학생들의 AI교육·학력향상 책임지겠다\"\n\n강미애, ‘입시에 강한 세종교육’ 2탄 발표…고교 체제 개편·AI 특성화고 추진\n\n강미애, AI 디지털융합교육센터 신설 공약...AI 기반 세종 공교육 혁신 선언\n\n강미애 세종교육감 후보 “학력강화, 1순위 공약”\n\n[대전일보 여론조사] 세종교육감 임전수·유우석·강미애 초접전…'단일화' 최대 변수","positiveActivities":[{"keyword":"후원","source":"https://www.yna.co.kr/view/AKR20260420135000063","snippet":"...-ad-1589789760428-0'); }); } 함께 읽기 좋은 콘텐츠 Taboola 후원링크 window['taboola-below-article-widget_08162024..."}],"news":[{"title":"세종시의원 비례대표 2→3명?…세종시특별법 개정안 '신속' 발의","link":"https://www.yna.co.kr/view/AKR20260420135000063","source":"Bing","content":"6·3 지방선거를 앞두고 광역의원 비례대표 비율을 확대하는 공직선거법 개정안이 국회를 통과하면서 세종시 정치권 발등에 불이 떨어졌다.\n국회가 지난 18일 광역의원 비례대표 정수를 광역의원 정수의 10%에서 14%로 상향하는 공직선거법 개정안을 의결한 데 따른 후속 조치다.\n세종시의회 선거 사무는 공직선거법이 아닌 '세종특별자치시 설치 등에 관한 특별법'을 적용받고 있어 이번에 통과된 비례대표 상향 비율을 반영하려면 특별법을 바꿔야 한다. 인공지능이 자동으로 줄인 '세 줄 요약' 기술을 사용합니다.전체 내용을 이해하기 위해서는 기사 본문과 함께 읽어야 합니다. 양영석기자 구독\n구독중 이전\n다음 '광역비례 확대' 공직선거법 적용 안돼 특별법에 반영…23일 본회의서 처리 전망 이미지 확대 세종시 도심 전경\n[양영석 기자] (세종=연합뉴스) 양영석 기자 = 6·3 지방선거를 앞두고 광역의원 비례대표 비율을 확대하는 공직선거법 개정안이 국회를 통과하면서 세종시 정치권 발등에 불이 떨어졌다. 세종시를 지역구로 둔 더불어민주당 강준현 의원과 무소속 김종민 의원 등은 20일 세종특별자치시 설치 등에 관한 특별법 일부 개정 법률안을 발의했다. 국회가 지난 18일 광역의원 비례대표 정수를 광역의원 정수의 10%에서 14%로 상향하는 공직선거법 개정안을 의결한 데 따른 후속 조치다. 세종시의회 선거 사무는 공직선거법이 아닌 '세종특별자치시 설치 등에 관한 특별법'을 적용받고 있어 이번에 통과된 비례대표 상향 비율을 반영하려면 특별법을 바꿔야 한다. 세종시 특별법이 개정되지 않으면 자칫 잘못하다가 올해 지방선거 시의원 비례대표 인원 산정 과정에서 불이익을 받을 수 있다는 지적이 나온다. 이 때문에 개정안을 대표 발의한 국회의원들도 \"6·3 지방선거를 원활히 진행하기 위해 입법 미비 사항을 신속히 개선해야 한다\"고 입법 취지를 설명했다. 지역 정치권에서는 특별법 개정안이 통과되면 현재 2명인 시의원 비례대표는 3명으로 늘어날 것으로 보고 있다. 김종민 의원은 \"비례대표 정수 비율을 늘리는 내용이 국회 의결 30분 전에 급하게 합의되면서 관련 후속 법안을 미리 준비할 수 있는 상황이 안됐다\"며 \"일단 오늘 급하게 양당 원내대표와 정개특위원장에게 연락해 동의는 받았다. 23일 마지막 본회의 때 처리해야 한다\"고 말했다. youngs@yna.co.kr 제보는 카카오톡 okjebo <저작권자(c) 연합뉴스,\n무단 전재-재배포, AI 학습 및 활용 금지> 2026/04/20 16:58 송고\n2026년04월20일 16시58분 송고 #비례대표 #특별법 #세종시 댓글 좋아요 슬퍼요 화나요 후속요청 <button type=\"button\" class=\"btn-type300 style20 arr01\" data-pop-open=\"pop-comment\" data-stat-code=\"article_comment01\"> {{#if IS_COUNT}} <span class=\"bold color21\">{{COUNT_TEXT}}</span> <span class=\"txt01\">개 댓글 전체보기</span> {{else}} <span class=\"txt01\">댓글 작성하기</span> {{/if}} </button> 국내 최대 원스톱 콘텐츠 제공 플랫폼 함께 보면 좋은 콘텐츠 by\n데이블 window['dablewidget_OoRAgyMX'] = function(){ (function(d,a,b,l,e,r) { if(d[b]&&d[b].q)return;d[b]=function(){(d[b].q=d[b].q||[]).push(arguments)};e=a.createElement(l); e.async=1;e.charset='utf-8';e.src='//static.dable.io/dist/plugin.min.js'; r=a.getElementsByTagName(l)[0];r.parentNode.insertBefore(e,r); })(window,document,'dable','script'); dable('setService', 'yna.co.kr'); dable('sendLogOnce'); dable('renderWidget', 'dablewidget_OoRAgyMX');\n} 광고 window['div-gpt-ad-1587522573500-0'] = function(){ googletag.cmd.push(function() { googletag.defineSlot('/21961356670/korean_pc_web_article_b