서, 당내 긴장감이 극도로 높아진 상태다. 대평·금남·부강면 지역구에선 채평석·최병조·황관영 예비후보가 치열한 각축전을 벌이고 있어 최종 낙점자에 관심이 쏠린다. 공천 확정이 늦어지는 배경엔 후보자들의 도덕성 논란도 한몫하고 있다. 어진·나성동 지역구의 경우, 한 예비후보가 선거구민에게 선물을 제공한 의혹으로 검찰에 고발당하며 공천심사가 멈춰 섰다. 해당 후보 측은 \"식사 대가 등에 대해 충분히 소명했다\"는 입장이지만, 당 공천심사위원회가 ‘청렴성’을 강조하며 엄격한 기준을 적용할 경우 공천 탈락이라는 강수를 둘 가능성도 배제할 수 없다. 이 결과에 따라 김효숙 부의장의 생존 여부 등 도미노식 파급 효과가 예상된다. 집현동과 합강동 등 신규 조성 지역은 선관위의 선거구 획정 작업이 늦어지면서 공고 자체가 지연되는 등 물리적 한계에 부딪힌 상황이다. 지역 정치권 한 관계자는 “당의 지침과 지역 여론 사이에서 시당의 고민이 깊은 것으로 안다. 이번 공천 결과가 향후 세종시의회 주도권 향방을 결정짓는 분수령이 될 것”이라고 말했다. 민주당 세종시당은 이르면 내주 중 나머지 지역구에 대한 경선결과를 발표하고 본격적인 선거 체제로 전환할 것으로 관측된다. 이승동 기자 dong79@cctoday.co.kr // Mobile\n$(document).ready(function() { articleStrongEffect.eventStart(0);\n}); 이승동 기자 dong79@cctoday.co.kr 기자 프로필 보기 var ___BANNER = \"ban_1770190216600\"; 키워드 #컷오프\n#지방선거\n#세종시의원\n#더불어민주당\n#선거구 획정\n#공천 작업\n#민주당\n#6·3지방선거 저작권자 © 충청투데이 무단전재 및 재배포 금지 관련기사 전현직 맞붙는다…허태정 vs 이장우 ‘격전 예고’ [6·3 지방선거 경선]\n與 충청권 광역단체장 경선 열기 후끈 [6·3 지방선거 경선]\n張 \"청년·AI에게 힘을\" 許 \"민생 안정이 먼저\" [6·3 지방선거 경선]\n충남교육감 다자구도 \"공약 실천 검증 필요\" [6·3 지방선거 경선]\n민주 충남지사 경선 ‘나소열 표심 잡기’ 올인 [6·3 지방선거 경선]\n국힘 지지율 추락에 ‘실적’ 앞세운 원팀 전략 부상 [6·3 지방선거 경선] jQuery( document ).ready(function() { vote.voteCheck( jQuery('#reply-write-btn, .reply-container'), // 폐쇄시 제거할 영역 'S', // 실명제 구분값 '/news/articleView.html' // 리턴URL ); }); 댓글삭제 삭제한 댓글은 다시 복구할 수 없습니다. 그래도 삭제하시겠습니까? 비밀번호 삭제 닫기 기사 댓글 0 댓글 접기 로그인 후 이용 가능합니다. 댓글 내용입력 0 / 400 비회원 로그인 이름 비밀번호 댓글 내용입력 0 / 400 등록 댓글쓰기 계정을 선택하시면 로그인·계정인증을 통해 댓글을 남기실 수 있습니다. 회원 로그인 이름 비밀번호 자동등록방지 var captchaContainer = null; var reCapVal; var loadCaptcha = function() { grecaptcha.render('captcha_container', { 'sitekey' : '6LeAvysaAAAAAFVSJC-yM3lkqFr83hikw6jJdUMa', 'callback' : function(response) { reCapVal = response; $(\"#nomember-captcha\").val( reCapVal ); }, 'expired-callback': fnGcCallback }); }; var fnGcCallback = function() { grecaptcha.reset(); $('#btn-nomember-write').removeClass('on').trigger('click'); $(\"#reply-modal\").foundation('open'); }; 확인 취소 로그인 옵션 창닫기 reply.paren